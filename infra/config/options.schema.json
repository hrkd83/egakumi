{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Workforce 標準設定・任意オプション",
  "description": "企業固有情報を含まない標準動作設定です。infra/configのtest.jsonまたはproduction.jsonを正本として使い、コピーは不要です。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "default": "./options.schema.json",
      "description": "エディター参照のみ。実行時に外部取得せずAzureへの入力から除外します。"
    },
    "$comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "パラメーターファイルを直接読む人向けの入力候補・説明です。Azureへは渡しません。"
    },
    "auditEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "常時稼働する本文監査の保存方式と保持期間を指定します。",
      "properties": {
        "eventHubsSku": { "enum": ["Standard", "Premium"], "default": "Standard" },
        "payloadImmutabilityMode": { "enum": ["Disabled", "Locked"], "default": "Disabled" },
        "payloadRetentionDays": { "type": "integer", "minimum": 1, "maximum": 146000 }
      },
      "if": {
        "required": ["payloadImmutabilityMode"],
        "properties": { "payloadImmutabilityMode": { "const": "Locked" } }
      },
      "then": { "properties": { "payloadRetentionDays": { "default": 2557 } } },
      "else": { "properties": { "payloadRetentionDays": { "maximum": 365, "default": 30 } } }
    },
    "network": {
      "type": "object",
      "properties": {
        "bgpRoutePropagation": {
          "type": "object",
          "additionalProperties": false,
          "description": "各ルートテーブルへGateway由来経路を伝搬するか。true=伝搬する、false=伝搬しない。各キーの既定はtrue。デフォルトルートの次ホップやVNetピアリングを設定する値ではありません。Azure ARMのdisableBgpRoutePropagation属性へはBicep内部で反転して渡します。",
          "properties": {
            "agw": {
              "type": "boolean",
              "default": true
            },
            "apim": {
              "type": "boolean",
              "default": true
            },
            "management": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "appGatewayZones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "1",
            "2",
            "3"
          ],
          "examples": [
            [
              "1",
              "2",
              "3"
            ]
          ],
          "description": "AppGW用公開IPの可用性ゾーン番号。gateway.zonesと同じ値にします。空配列は番号を明示しない意味で、ゾーン冗長性を無効にする指定ではありません。"
        },
        "firewall": {
          "type": "object",
          "properties": {
            "sku": {
              "const": "Premium",
              "description": "TLS検査とIDPSのため全環境でPremiumです。"
            },
            "threatIntelMode": {
              "type": "string",
              "enum": [
                "Alert",
                "Deny",
                "Off"
              ],
              "default": "Alert"
            },
            "idpsMode": {
              "enum": [
                "Alert",
                "Deny"
              ],
              "default": "Deny",
              "description": "IDPSは遮断付きのDenyで開始します。Alertは監視のみです。"
            },
            "zones": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "default": [],
              "description": "Firewallの可用性ゾーン番号。空配列は番号を明示しません。"
            },
            "signatureOverrides": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "default": [],
              "description": "Premium IDPSの署名ごとの動作変更。追加しない場合は空配列。"
            }
          },
          "additionalProperties": false
        },
        "dnsTtl": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 300
        }
      },
      "additionalProperties": false,
      "description": "ネットワークの標準動作です。IP計画、時刻同期先、追加許可先など企業固有値はparams.networkへ記載します。"
    },
    "services": {
      "type": "object",
      "properties": {
        "apimSkuName": {
          "type": "string",
          "enum": [
            "Developer",
            "Premium"
          ],
          "description": "Developerは検証用の1ユニット構成です。"
        },
        "vaultSkuName": {
          "type": "string",
          "enum": [
            "standard",
            "premium"
          ],
          "default": "standard"
        },
        "apiCenterSkuName": {
          "type": "string",
          "enum": [
            "Free",
            "Standard"
          ],
          "default": "Free",
          "description": "API Centerの料金プラン。基本PortalはFreeでも利用可能。Standardの料金・APIM連携特典は事前確認します。"
        },
        "catalogEnvironmentKind": {
          "type": "string",
          "enum": [
            "development",
            "production",
            "staging",
            "testing"
          ]
        },
        "catalogLifecycleStage": {
          "type": "string",
          "enum": [
            "deprecated",
            "design",
            "development",
            "preview",
            "production",
            "retired",
            "testing"
          ]
        },
        "modelDeployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelDeployment"
          },
          "description": "単一Foundryへ作るモデル配備の一覧。上限32件。モデル名・版・SKU・利用枠を配備前に確認します。",
          "maxItems": 32
        },
        "apimCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 1
        },
        "vaultRetentionDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 90,
          "default": 90
        },
        "vaultPurgeProtection": {
          "type": "boolean",
          "default": true
        },
        "projectDisplayName": {
          "type": "string",
          "minLength": 1,
          "default": "core-platform",
          "description": "Foundryプロジェクトの表示名。リソース識別名は基盤命名規則から別に作成します。"
        },
        "projectDescription": {
          "type": "string",
          "minLength": 1,
          "default": "Core platform project for shared model, agent, and tool capabilities."
        },
        "enableApiCenterIntegration": {
          "type": "boolean",
          "default": true
        },
        "grantApimSecretAccess": {
          "type": "boolean",
          "default": false
        },
        "speechEnabled": {
          "type": "boolean",
          "default": false
        },
        "grantApimFoundryModelsAccess": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "skuName": {
          "type": "string",
          "enum": [
            "WAF_v2",
            "Standard_v2"
          ],
          "default": "WAF_v2"
        },
        "wafMode": {
          "type": "string",
          "enum": [
            "Prevention",
            "Detection"
          ],
          "default": "Prevention"
        },
        "autoscaleMinCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 2
        },
        "autoscaleMaxCapacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 125,
          "default": 5
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "wafCustomRules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "wafExclusions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "backendRequestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 600
        },
        "wafMaxRequestBodySizeInKb": {
          "type": "integer",
          "minimum": 8,
          "maximum": 2000,
          "default": 128
        },
        "wafRequestBodyInspectLimitInKb": {
          "type": "integer",
          "minimum": 8,
          "maximum": 2000,
          "default": 128
        },
        "wafFileUploadLimitInMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000,
          "default": 100
        },
        "realtimeControlEnabled": {
          "type": "boolean",
          "default": false
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "description": "Entra利用制限と本人OAuth接続セッションの共通設定です。環境別アプリ登録はparamsに置きます。",
          "properties": {
            "entra": {
              "type": "object",
              "additionalProperties": false,
              "description": "社員のEntra委任認証に適用する共通利用制限です。",
              "required": [
                "userLimits"
              ],
              "properties": {
                "userLimits": {
                  "$ref": "#/$defs/entraUserLimits"
                }
              }
            },
            "credentialLogin": {
              "type": "object",
              "additionalProperties": false,
              "description": "本人のOAuth接続を作成し、認証完了後に接続セッションを発行する共通窓口です。",
              "required": [
                "providerNames"
              ],
              "properties": {
                "providerNames": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                  },
                  "description": "本人接続の作成と認証案内に利用するEntraプロバイダー名です。"
                },
                "idleTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 300,
                  "maximum": 31536000,
                  "default": 604800,
                  "description": "最終の対象業務API利用からの無操作期限。期限切れのセッションは延長しません。"
                },
                "absoluteLifetimeSeconds": {
                  "type": "integer",
                  "minimum": 300,
                  "maximum": 31536000,
                  "default": 2592000,
                  "description": "本人確認完了からの最長期限。利用や値の更新でも延長しません。"
                },
                "rotationIntervalSeconds": {
                  "type": "integer",
                  "minimum": 300,
                  "maximum": 2592000,
                  "default": 86400,
                  "description": "対象業務APIの利用時にセッション値の更新を開始する間隔。"
                },
                "rotationGraceSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600,
                  "default": 300,
                  "description": "更新確定後に旧値を受け付ける固定の移行猶予。旧値の利用で延長しません。"
                },
                "rotationHandoffSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 3600,
                  "default": 600,
                  "description": "更新開始後、保存・確定を待って業務APIを継続できる期間。"
                },
                "rotationCandidateTtlSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 3600,
                  "default": 600,
                  "description": "更新候補の有効期間。更新確定だけでは利用期限を延長しません。"
                },
                "transactionLifetimeSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 600,
                  "default": 300,
                  "description": "ログイン開始から認証結果を受け取るまでの有効期間です。"
                },
                "loginCallsPerMinute": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 10,
                  "description": "購読IDごとのログイン開始回数を1分単位で制限します。"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "management": {
      "type": "object",
      "properties": {
        "diskControllerType": {
          "type": "string",
          "enum": [
            "SCSI",
            "NVMe"
          ],
          "description": "選択VMサイズ・イメージの両方が対応する値にします。"
        },
        "osDiskSku": {
          "type": "string",
          "enum": [
            "Standard_LRS",
            "StandardSSD_LRS",
            "Premium_LRS"
          ],
          "default": "StandardSSD_LRS"
        },
        "patchAssessmentMode": {
          "type": "string",
          "enum": [
            "ImageDefault",
            "AutomaticByPlatform"
          ],
          "default": "ImageDefault"
        },
        "patchMode": {
          "type": "string",
          "enum": [
            "ImageDefault",
            "AutomaticByPlatform"
          ],
          "default": "ImageDefault",
          "description": "Linuxの更新方式。ImageDefaultはイメージ既定、AutomaticByPlatformはAzure管理の自動更新。"
        },
        "imageReference": {
          "type": "object",
          "description": "現時点の自動構築はCanonical/ubuntu-24_04-lts/server（Ubuntu 24.04 LTS amd64、固定version）に対応。別ディストリビューションは非対応。idで承認済みcustom imageを記入する形式もありますが、現在は互換性を自動確認できず配備前に停止します。"
        },
        "vmSize": {
          "type": "string",
          "minLength": 1
        },
        "osDiskSizeGB": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4095,
          "default": 128
        },
        "enableAcceleratedNetworking": {
          "type": "boolean",
          "default": true
        },
        "encryptionAtHost": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "auditStorageSku": {
          "type": "string",
          "enum": [
            "Standard_LRS",
            "Standard_GRS",
            "Standard_RAGRS",
            "Standard_ZRS",
            "Standard_GZRS",
            "Standard_RAGZRS"
          ]
        },
        "auditImmutabilityMode": {
          "type": "string",
          "enum": [
            "Disabled",
            "Unlocked",
            "Locked"
          ],
          "description": "Lockedへの変更後、Azureでは保持ポリシーを元に戻せません。"
        },
        "retentionInDays": {
          "type": "integer",
          "minimum": 90,
          "maximum": 730,
          "default": 90
        },
        "workspaceDailyQuotaGb": {
          "type": "integer",
          "minimum": -1,
          "maximum": 100000,
          "default": -1
        },
        "auditRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 146000,
          "default": 2557
        },
        "appInsightsIngestionWarningGb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 80
        },
        "enableLogAlerts": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "dnsPlugin",
          "description": "Azure Public DNSを使って証明書を自動発行・更新します。"
        },
        "directory": {
          "type": "string",
          "enum": [
            "production",
            "staging"
          ],
          "default": "production",
          "description": "Let's Encryptの発行先です。stagingの証明書は公開利用できません。"
        },
        "moduleVersion": {
          "const": "4.34.0",
          "default": "4.34.0"
        },
        "certificateName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,80}$",
          "default": "tls-public"
        },
        "renewBeforeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 30
        },
        "checkEveryHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "default": 12
        },
        "dnsSleepSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600,
          "default": 60
        },
        "validationTimeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800,
          "default": 120
        },
        "minimumValidDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 7
        }
      },
      "additionalProperties": false,
      "description": "公開証明書はAzure Public DNSの権威ゾーンと専用マネージドIDを使い、DNS-01で発行・更新します。"
    },
    "credentialBroker": {
      "type": "object",
      "additionalProperties": false,
      "description": "本人接続台帳用Azure SQLと認証窓口の実行設定。",
      "properties": {
        "sqlSkuName": {
          "type": "string",
          "default": "GP_Gen5_2"
        },
        "sqlTier": {
          "enum": [
            "GeneralPurpose",
            "BusinessCritical"
          ],
          "default": "GeneralPurpose"
        },
        "sqlCapacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128,
          "default": 2
        },
        "sqlMaxSizeGB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 32
        },
        "backupRetentionDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 35,
          "default": 14
        },
        "zoneRedundant": {
          "type": "boolean",
          "default": false
        },
        "backupRedundancy": {
          "enum": [
            "Local",
            "Zone",
            "Geo",
            "GeoZone"
          ],
          "default": "Geo"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 2
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 4
        }
      }
    },
    "portalAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "description": "ポータル認証専用DBの性能・バックアップ設定。EntraのID・秘密は既存の論理資格情報プロバイダーから参照します。",
      "properties": {
        "sqlSkuName": {
          "type": "string",
          "minLength": 1,
          "default": "Basic"
        },
        "sqlTier": {
          "enum": [
            "Basic",
            "GeneralPurpose",
            "BusinessCritical"
          ],
          "default": "Basic"
        },
        "sqlCapacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128,
          "default": 5
        },
        "sqlMaxSizeGB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 2
        },
        "backupRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35,
          "default": 7
        },
        "zoneRedundant": {
          "type": "boolean",
          "default": false
        },
        "backupRedundancy": {
          "enum": [
            "Local",
            "Zone",
            "Geo",
            "GeoZone"
          ],
          "default": "Local"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sqlTier": {
                "const": "Basic"
              }
            },
            "required": [
              "sqlTier"
            ]
          },
          "then": {
            "properties": {
              "sqlSkuName": {
                "const": "Basic"
              },
              "sqlCapacity": {
                "const": 5
              },
              "sqlMaxSizeGB": {
                "maximum": 2
              },
              "backupRetentionDays": {
                "maximum": 7
              },
              "zoneRedundant": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "backupRetentionDays": {
                "minimum": 7
              }
            }
          }
        }
      ]
    },
    "credentialProviders": {
      "type": "object",
      "additionalProperties": false,
      "description": "OAuth接続の共通定義です。環境別Client IDと秘密ファイル参照はparamsに置きます。",
      "properties": {
        "graphDelegated": {
          "type": "object",
          "additionalProperties": false,
          "description": "標準Graph委任接続の共通表示名、委任scope、CM poolです。名前・プロトコル・Graph URL・本人IDプロパティは資材で固定します。",
          "required": [
            "displayName",
            "scopes",
            "pool"
          ],
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "scopes": {
              "type": "string",
              "minLength": 1
            },
            "pool": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count",
                "capacity"
              ],
              "description": "論理プロファイルを-aからの物理CMプロバイダーへ展開する。",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 26
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8000
                }
              }
            }
          }
        },
        "additional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credentialProvider"
          }
        }
      },
      "required": [
        "graphDelegated"
      ]
    }
  },
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "modelDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "modelName",
        "modelVersion",
        "modelFormat",
        "skuName",
        "capacity",
        "versionUpgradeOption"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "正式モデル名と一致する配備名です。",
          "not": {
            "pattern": "^[cC][lL][aA][uU][dD][eE]-"
          }
        },
        "modelName": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^[cC][lL][aA][uU][dD][eE]-"
          }
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "description": "カタログで確認した版を固定します。"
        },
        "modelFormat": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "OpenAI",
            "Cohere",
            "Black Forest Labs",
            "Microsoft"
          ],
          "description": "azdで配備するモデルの正式なprovider表記です。Claudeは構築後にGUIで追加します。",
          "not": {
            "pattern": "^[aA][nN][tT][hH][rR][oO][pP][iI][cC]$"
          }
        },
        "skuName": {
          "type": "string",
          "minLength": 1,
          "description": "選択モデル・リージョンで提供される正式SKUを指定します。候補はモデルごとに異なります。"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "versionUpgradeOption": {
          "const": "NoAutoUpgrade",
          "description": "評価済みモデルを固定し、版の更新は明示的に行います。"
        },
        "quotaUsageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalId",
        "principalType"
      ],
      "properties": {
        "principalId": {
          "$ref": "#/$defs/guid"
        },
        "principalType": {
          "enum": [
            "User",
            "Group",
            "ServicePrincipal"
          ]
        }
      }
    },
    "credentialProvider": {
      "type": "object",
      "additionalProperties": false,
      "description": "追加OAuthプロバイダーの共通定義です。nameでparams側の追加アプリ登録と対応付けます。",
      "required": [
        "name",
        "displayName",
        "identityProvider",
        "scopes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "identityProvider": {
          "enum": [
            "aad",
            "oauth2"
          ]
        },
        "scopes": {
          "type": "string",
          "minLength": 1
        },
        "resourceUri": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "authorizationUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "tokenUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "refreshUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "connectionNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "description": "事前作成する固定接続名です。共通ログイン窓口から本人接続を作るプロバイダーは空配列を指定できます。"
        },
        "identityEndpoint": {
          "type": "string",
          "pattern": "^https://[^\\s?#]+$",
          "description": "resourceUriと同じホストにある固定の本人情報取得URLです。本人接続用Entraプロバイダーに指定します。"
        },
        "identityIdProperty": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "default": "id",
          "description": "本人情報の応答から取得する不変IDのプロパティ名です。"
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "capacity"
          ],
          "description": "論理プロファイルを-aからの物理CMプロバイダーへ展開する。",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 26
            },
            "capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identityProvider": {
                "const": "aad"
              }
            },
            "required": [
              "identityProvider"
            ]
          },
          "then": {
            "required": [
              "resourceUri"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "identityProvider": {
                "const": "oauth2"
              }
            },
            "required": [
              "identityProvider"
            ]
          },
          "then": {
            "required": [
              "authorizationUrl",
              "tokenUrl",
              "refreshUrl"
            ]
          }
        }
      ]
    },
    "entraUserLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestRate",
        "tokensPerMinute",
        "tokenQuota"
      ],
      "description": "全社員共通の利用制限を3項目すべて明示します。各nullはその制限の無効化で、非nullには有限の値が必要です。有効なcounterは検証済みtid/oidごとに分け、既存キーの購読counterは維持します。",
      "properties": {
        "requestRate": {
          "type": [
            "object",
            "null"
          ],
          "description": "本人別HTTP要求回数の制限です。nullで無効化します。人の入力回数とは異なり、ツール継続・retry・並列要求も計数します。",
          "additionalProperties": false,
          "required": [
            "calls",
            "renewalPeriodSeconds"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "renewalPeriodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        },
        "tokensPerMinute": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647,
          "description": "本人別の毎分トークン上限です。nullで無効化します。"
        },
        "tokenQuota": {
          "type": [
            "object",
            "null"
          ],
          "description": "本人別の期間トークン枠です。nullで無効化します。",
          "additionalProperties": false,
          "required": [
            "tokens",
            "period"
          ],
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "period": {
              "type": "string",
              "enum": [
                "Hourly",
                "Daily",
                "Weekly",
                "Monthly",
                "Yearly"
              ]
            }
          }
        }
      }
    }
  }
}
