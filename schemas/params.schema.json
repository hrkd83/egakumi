      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Operation単位の固定接続先。未指定値はAPI既定から継承。秘密交換はAPI単位。",
      "properties": {
        "backendService": {
          "enum": [
            "foundryOpenAi",
            "foundryCognitive",
            "foundryServices",
            "external"
          ]
        },
        "backendUrl": {
          "type": "string"
        },
        "backendAudience": {
          "type": "string"
        },
        "backendAuthentication": {
          "$ref": "#/$defs/backendAuthentication"
        },
        "backendHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "credentialConnection": {
      "type": "object",
      "additionalProperties": false,
      "description": "APIから利用するCredential Manager接続です。personalは認証済み接続セッション、serviceは固定のサービス接続を使います。",
      "required": [
        "mode",
        "providerName",
        "enabled"
      ],
      "properties": {
        "mode": {
          "enum": [
            "personal",
            "service"
          ]
        },
        "providerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "connectionName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "description": "serviceモードで利用する固定接続名です。"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "service"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "connectionName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "personal"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "connectionName"
              ]
            }
          }
        }
      ]
    },
    "credentialProvider": {
      "type": "object",
      "additionalProperties": false,
      "description": "OAuth接続先の固定設定です。本人接続用のEntraプロバイダーはidentityEndpointで認証した本人を確認します。",
      "required": [
        "name",
        "displayName",
        "identityProvider",
        "clientId",
        "clientSecretFile",
        "scopes",
        "connectionNames"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "identityProvider": {
          "enum": [
            "aad",
            "oauth2"
          ]
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientSecretFile": {
          "type": "string",
          "minLength": 1
        },
        "oauthTenantId": {
          "$ref": "#/$defs/guid"
        },
        "scopes": {
          "type": "string",
          "minLength": 1
        },
        "resourceUri": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "authorizationUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "tokenUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "refreshUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "connectionNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "description": "事前作成する固定接続名です。共通ログイン窓口から本人接続を作るプロバイダーは空配列を指定できます。"
        },
        "identityEndpoint": {
          "type": "string",
          "pattern": "^https://[^\\s?#]+$",
          "description": "resourceUriと同じホストにある固定の本人情報取得URLです。本人接続用Entraプロバイダーに指定します。"
        },
        "identityIdProperty": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "default": "id",
          "description": "本人情報の応答から取得する不変IDのプロパティ名です。"
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "capacity"
          ],
          "description": "論理プロファイルを-aからの物理CMプロバイダーへ展開する。",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 26
            },
            "capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identityProvider": {
                "const": "aad"
              }
            },
            "required": [
              "identityProvider"
            ]
          },
          "then": {
            "required": [
              "resourceUri"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "identityProvider": {
                "const": "oauth2"
              }
            },
            "required": [
              "identityProvider"
            ]
          },
          "then": {
            "required": [
              "authorizationUrl",
              "tokenUrl",
              "refreshUrl"
            ]
          }
        }
      ]
    },
    "portalApiKeys": {
      "type": "object",
      "additionalProperties": false,
      "description": "検証用購読の所有グループ・基盤管理グループと承認製品。初期のazd upは基盤・Gatewayの後、Portal工程で未設定項目を対話入力し、同じparamsへ保存します。非対話ではgroups・platformGroupId・groupNamePatternの事前設定が必要です。通常の所有候補は環境別の正規表現に一致するセキュリティグループをGraphから取得し、キー値は含めません。",
      "properties": {
        "platformGroupId": {
          "$ref": "#/$defs/guid",
          "description": "検証用購読の所有グループのうち、管理ダッシュボードへのアクセスを許可するグループのObject ID。groups内のIDを明示します。"
        },
        "groupNamePattern": {
          "type": "string",
          "maxLength": 512,
          "default": "",
          "examples": [
            "^ORG_",
            "^(ORG_|DEPT_)",
            "^組織_.+$"
          ],
          "description": "対象セキュリティグループの表示名を選ぶRE2互換の正規表現。通常は大文字小文字を区別します。空欄は初回未設定で、azd up後段または個別のPortal配備で対話入力します。非対話では事前設定が必要です。空欄を全許可にはしません。"
        },
        "verificationSubscriptions": {
          "type": "array",
          "maxItems": 100,
          "default": [],
          "description": "Portal配備で基盤管理グループへ登録する検証用購読。未設定の初回は承認製品ごとにplatform-<製品ID>で作成します。既存の購読は実IDを明示して引き継ぎます。キー値は含めません。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subscriptionId",
              "productId",
              "displayName"
            ],
            "properties": {
              "subscriptionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$",
                "not": {
                  "pattern": "^[Mm][Aa][Ss][Tt][Ee][Rr]$"
                }
              },
              "productId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 1000,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "products"
            ],
            "properties": {
              "groupId": {
                "$ref": "#/$defs/guid"
              },
              "products": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "productId"
                  ],
                  "properties": {
                    "productId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "maxSubscriptions": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000,
                      "default": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
