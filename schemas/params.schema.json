{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Workforce 企業・環境ごとの入力",
  "description": "企業・環境ごとに確認して指定する入力です。configFileから本番またはテストの標準動作設定を読みます。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configFile",
    "productName",
    "environmentName",
    "subscriptionId",
    "azureTenantId",
    "network",
    "services",
    "gateway",
    "management",
    "monitoring",
    "certificate",
    "location",
    "foundryLocation",
    "apiCenterLocation",
    "tags",
    "portal"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "default": "../schemas/params.schema.json"
    },
    "$comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "パラメーターファイルを直接読む人向けの入力候補・説明です。Azureへは渡しません。"
    },
    "configFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\.[jJ][sS][oO][nN]$",
      "description": "標準動作設定の正本を選びます。テストは../config/test.json、本番は../config/production.json。企業固有値はこのparamsへ設定し、configはコピーしません。"
    },
    "azureTenantId": {
      "$ref": "#/$defs/guid",
      "description": "Azureリソースが属するテナントID。構築、Key Vault、Azure RBAC、管理APIの認証に使用します。"
    },
    "entraTenantId": {
      "$ref": "#/$defs/guid",
      "description": "OAuth接続で利用する既定のEntra認証テナントID。省略時はazureTenantIdと同じです。"
    },
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "リソース名とタグに使う任意の環境識別子です。例test/dev/prod。値によるSKU・保持期間などの切替はありません。Azure共通命名のため先頭英小文字、以降は英小文字・数字・内部ハイフン、最大12字。 命名順は種類-環境名-製品名。environmentName-productNameは合計17文字以内にしてください。ca-<stem>-credentialsのContainer App上限32文字に合わせます。超過時は構築前にエラーになります。"
    },
    "schemaVersion": {
      "const": 1
    },
    "subscriptionId": {
      "$ref": "#/$defs/guid"
    },
    "credentialProviders": {
      "type": "object",
      "additionalProperties": false,
      "description": "標準Graph接続と追加OAuth接続の環境別アプリ登録・秘密ファイル参照です。共通表示名・scope・pool・プロトコル定義はconfigに置きます。",
      "properties": {
        "graphDelegated": {
          "type": "object",
          "additionalProperties": false,
          "description": "標準Graph委任接続用Entraアプリの登録情報です。テナントはentraTenantIdから決まります。",
          "required": [
            "clientId",
            "clientSecretFile"
          ],
          "properties": {
            "clientId": {
              "$ref": "#/$defs/guid"
            },
            "clientSecretFile": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credentialProvider"
          },
          "description": "config.credentialProviders.additionalに対応する追加アプリ登録です。"
        }
      },
      "required": [
        "graphDelegated"
      ]
    },
    "productName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "各リソース名に使う製品名です。 命名順は種類-環境名-製品名。environmentName-productNameは合計17文字以内にしてください。ca-<stem>-credentialsのContainer App上限32文字に合わせます。超過時は構築前にエラーになります。",
      "examples": [
        "egakumi"
      ]
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisherName": {
          "type": "string",
          "minLength": 1
        },
        "publisherEmail": {
          "type": "string",
          "format": "email",
          "minLength": 1
        },
        "apimInstanceId": {
          "type": "string",
          "pattern": "^[a-z0-9]{6}$",
          "minLength": 6,
          "maxLength": 6,
          "description": "初回prepare_local_environment.pyで生成・保存する6文字の構築識別子です。通常の更新では保存済み値を保持します。公開テンプレートの未解決マーカーは実入力として受け付けません。"
        }
      },
      "required": [
        "publisherName",
        "publisherEmail",
        "apimInstanceId"
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "description": "Entra API audienceと任意の接続窓口アプリ登録です。購読キーヘッダーはapi-keyで固定します。",
          "properties": {
            "entra": {
              "$ref": "#/$defs/entraAuthentication"
            },
            "credentialLogin": {
              "type": "object",
              "additionalProperties": false,
              "description": "独立した接続窓口アプリを使う場合の環境別登録情報です。identityは任意です。",
              "properties": {
                "identity": {
                  "$ref": "#/$defs/credentialLoginIdentity"
                }
              }
            }
          }
        },
        "publicHostName": {
          "type": "string",
          "minLength": 1,
          "description": "公開DNSで管理するAPI入口のFQDN。スキーム・パス・ポートは付けません。"
        }
      },
      "required": [
        "publicHostName",
        "authentication"
      ]
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adminUsername": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 32,
          "description": "Linux管理VMのローカル管理者名。root/admin等の予約名は不可。"
        },
        "loginAssignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loginPrincipal"
          },
          "default": []
        },
        "sshPublicKeyFile": {
          "type": "string",
          "minLength": 1,
          "description": "SSH公開鍵の必須入力兼生成先。相対参照はparamsファイル基準です。明示された保護入力にある有効なOpenSSH RSA 2048bit以上またはEd25519公開鍵1件は、対応秘密鍵なしでも再利用できます。鍵対がともに存在しない場合の生成先はチェックアウト直下.local/<environment>/secrets/配下に限定し、リンクと所有者専用権限を確認します。秘密鍵だけが既存、公開鍵が無効、外部参照の生成先が未作成の場合は上書きせず停止します。生成した鍵対は失敗/down後も保持します。",
          "examples": [
            "./secrets/management-ssh.pub"
          ]
        }
      },
      "required": [
        "adminUsername",
        "sshPublicKeyFile"
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operatorEmailAddresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        }
      },
      "required": [
        "operatorEmailAddresses"
      ]
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contactEmail": {
          "type": "string",
          "format": "email",
          "minLength": 1
        },
        "azureDnsSubscriptionId": {
          "type": "string",
          "format": "uuid",
          "description": "事前準備したAzure Public DNS権威ゾーンがあるSubscription ID。構築前にparamsへ記入します。"
        },
        "azureDnsManagedIdentityResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[^/]+/resource[Gg]roups/[^/]+/providers/Microsoft\\.ManagedIdentity/userAssignedIdentities/[^/]+$",
          "description": "事前作成しDNS操作権限を付与したユーザー割り当てMIの完全なリソースID。構築前にparamsへ記入し、管理VMへ紐づけます。Client IDやObject IDではありません。"
        }
      },
      "description": "公開証明書はAzure Public DNSの権威ゾーンと専用マネージドIDを使い、DNS-01で発行・更新します。",
      "required": [
        "contactEmail",
        "azureDnsSubscriptionId",
        "azureDnsManagedIdentityResourceId"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "description": "企業・環境ごとのIP計画、DNS、時刻同期、追加通信先と規則です。addressSpacesとsubnetPrefixesは必須です。",
      "required": [
        "addressSpaces",
        "subnetPrefixes"
      ],
      "properties": {
        "addressSpaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "10.40.0.0/24",
              "10.40.1.0/24",
              "10.40.2.0/24",
              "10.40.3.0/24"
            ]
          ],
          "description": "VNet全体に登録する重複しないIPv4 CIDRです。今回の例は/24を4つとし、10.40.3.0/24はサブネット未作成の予備です。サブネットの割当はsubnetPrefixesで別に指定します。"
        },
        "subnetPrefixes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agw",
            "pep",
            "firewall",
            "apim",
            "management",
            "aca"
          ],
          "description": "ACAを含む6サブネットのCIDRです。VNetのaddressSpaces内へ重複なく割り当てます。予備/24のサブネットは作りません。",
          "properties": {
            "agw": {
              "type": "string",
              "description": "Application Gateway専用。基本/24。",
              "examples": [
                "10.40.0.0/24"
              ]
            },
            "pep": {
              "type": "string",
              "description": "Private Endpoint用。基本/24。",
              "examples": [
                "10.40.1.0/24"
              ]
            },
            "firewall": {
              "type": "string",
              "description": "AzureFirewallSubnet用。基本/26。",
              "examples": [
                "10.40.2.0/26"
              ]
            },
            "apim": {
              "type": "string",
              "description": "Internal APIM専用。基本/26。",
              "examples": [
                "10.40.2.64/26"
              ]
            },
            "management": {
              "type": "string",
              "description": "管理VM用。基本/26。",
              "examples": [
                "10.40.2.128/26"
              ]
            },
            "aca": {
              "type": "string",
              "description": "Core管理ポータルのACA専用サブネット。基本/26、最小/27。Microsoft.App/environmentsへ委任します。",
              "examples": [
                "10.40.2.192/26"
              ]
            }
          }
        }
      }
    },
    "location": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]+$",
      "description": "主要ネットワーク・APIM等を配置するAzureリージョン。"
    },
    "foundryLocation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]+$",
      "description": "Foundryとモデルを配置するAzureリージョン。利用枠・モデル提供地域を確認します。"
    },
    "apiCenterLocation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]+$",
      "description": "API Centerを配置するAzureリージョン。対応地域を確認します。"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicHostName": {
          "type": "string",
          "pattern": "^portal\\."
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "description": "初期構築後に手動登録する専用Portalアプリ。通常はtenantId/clientIdだけを入力し、鍵とthumbprintは保護stateから読みます。初期構築では省略できます。",
          "required": [
            "tenantId",
            "clientId"
          ],
          "properties": {
            "tenantId": {
              "type": "string",
              "format": "uuid"
            },
            "clientId": {
              "type": "string",
              "format": "uuid"
            },
            "keyId": {
              "type": "string",
              "pattern": "^https:\\/\\/[a-zA-Z0-9-]+\\.vault\\.azure\\.net/keys/[a-zA-Z0-9-]+/[a-fA-F0-9]{32}$"
            },
            "certificateThumbprint": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          },
          "dependentRequired": {
            "keyId": [
              "certificateThumbprint"
            ],
            "certificateThumbprint": [
              "keyId"
            ]
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "description": "KV自己署名・非exportable RSA認証証明書。12か月/60日前は運用既定値です。",
          "properties": {
            "certificateName": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,127}$",
              "default": "portal-auth"
            },
            "validityMonths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            },
            "renewBeforeDays": {
              "type": "integer",
              "minimum": 7,
              "maximum": 90,
              "default": 60
            }
          }
        }
      },
      "description": "Core管理ポータルの必須公開ホスト。専用サブネットはnetwork.subnetPrefixes.acaへ指定します。",
      "required": [
        "publicHostName"
      ]
    },
    "portalApiKeys": {
      "$ref": "#/$defs/portalApiKeys"
    }
  },
  "$defs": {
    "entraAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "description": "業務APIのEntra認証先アプリです。テナントはentraTenantId、委任scopeはGateway.Invokeで固定し、社員共通の利用制限はconfigに置きます。",
      "required": [
        "audience"
      ],
      "properties": {
        "audience": {
          "$ref": "#/$defs/guid",
          "description": "v2アクセストークンの宛先となるAPI用アプリのApplication client IDです。api://のscope URIは指定しません。"
        }
      }
    },
    "credentialLoginIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "clientSecretFile"
      ],
      "description": "CMの外部API用clientから独立した接続窓口のOIDC本人確認用アプリです。テナントはentraTenantIdから決まります。省略時は選択CM provider由来の現行設定を維持します。",
      "properties": {
        "clientId": {
          "$ref": "#/$defs/guid"
        },
        "clientSecretFile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalId",
        "principalType"
      ],
      "properties": {
        "principalId": {
          "$ref": "#/$defs/guid"
        },
        "principalType": {
          "enum": [
            "User",
            "Group",
            "ServicePrincipal"
          ]
        }
      }
    },
    "loginPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalId",
        "principalType",
        "role"
      ],
      "properties": {
        "principalId": {
          "$ref": "#/$defs/guid"
        },
        "principalType": {
          "enum": [
            "User",
            "Group",
            "ServicePrincipal"
          ]
        },
        "role": {
          "enum": [
            "User",
            "Administrator"
          ]
        }
      }
    },
    "backendAuthentication": {
      "type": "object",
      "description": "APIMから下流サービスへ接続するときの認証方式です。CMを使うAPIはcredentialConnectionで接続を指定します。",
      "properties": {
        "mode": {
          "enum": [
            "managedIdentity",
            "none",
            "keyVaultHeader",
            "speechEntra"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "operationModelSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "registeredOperation",
            "pathModel",
            "bodyModel",
            "statelessResponses",
            "hostedAgentPost",
            "a2aJsonRpc",
            "realtimeCreate",
            "realtimeHangup",
            "pii",
            "liveCreate"
          ]
        },
        "parameter": {
          "type": "string"
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288000,
          "description": "要求全体の受付上限。標準AI APIはClassic APIMの本文バッファー技術上限500 MiB。モデルのファイル単位・token上限は提供元が検査します。"
        },
        "maxOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "このモデルに使う出力上限。未指定なら操作の基本設定を使います。モデル能力表がある場合は、そのモデルの公開上限との整合を検査します。"
        },
        "outputTokenParameter": {
          "enum": [
            "max_output_tokens",
            "max_completion_tokens",
            "max_tokens"
          ]
        },
        "modelVersion": {
          "type": "string"
        },
        "allowedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "明示的な利用言語の許可リスト。空配列では提供元が対応言語を検査します。"
        },
        "allowedWarningCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bodyFormat": {
          "enum": [
            "json",
            "binary",
            "multipart",
            "text",
            "none"
          ]
        },
        "contentTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedMethods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "integerLimits": {
          "type": "object"
        },
        "arrayLimits": {
          "type": "object"
        },
        "stringChoices": {
          "type": "object"
        },
        "model": {
          "type": "string"
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "publicCallPath": {
          "type": "string"
        },
        "backendUrlTemplate": {
          "type": "string",
          "minLength": 1,
          "description": "本文のモデル名で選ぶ、登録時に検査した固定の上流相対URI。"
        },
        "initialOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Realtime接続作成時の初期値。モデルの最大値とは別に扱う。"
        },
        "settingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "監査で使う内部の設定識別名。クライアントが選ぶ値ではありません。"
        }
      },
      "description": "本文のモデル名をキーにした設定差分。未指定項目は操作の基本設定を使い、指定した項目は項目単位で置換します。"
    },
    "operationConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "registeredOperation",
            "pathModel",
            "bodyModel",
            "textEmbeddings",
            "rerank",
            "statelessResponses",
            "hostedAgentPost",
            "a2aJsonRpc",
            "realtimeCreate",
            "realtimeHangup",
            "pii",
            "documentAnalysis",
            "documentAnalysisStatus"
          ]
        },
        "parameter": {
          "type": "string"
        },
        "allowedModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requestBodySizeCheck": {
          "type": "string",
          "enum": [
            "actual",
            "declared"
          ],
          "description": "共通の本文制限処理で使う、非JSON本文（binary／multipart／text）のサイズ確認方式。未指定またはactualは受信本文の実サイズを確認します。declaredはContent-Lengthがあれば申告値を確認し、サイズ確認のための本文読取りを省きます。declaredを使えるのはこの3形式の操作だけです。設定は操作直下へ置き、モデル別差分には指定しません。"
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288000,
          "description": "本文全体の上限バイト数。非JSON本文では、requestBodySizeCheckがdeclaredの場合はContent-Lengthがあるときに申告値と比較し、actualまたは未指定の場合は受信した実サイズも比較します。標準AI APIの500 MiBはClassic APIMの本文バッファー技術上限で、モデルのファイル単位・トークン上限は提供元が検査します。"
        },
        "maxOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "モデル別上限の外側の最大値。不定・非対応のみならnull。"
        },
        "outputTokenParameter": {
          "enum": [
            "max_output_tokens",
            "max_completion_tokens",
            "max_tokens"
          ]
        },
        "modelVersion": {
          "type": "string"
        },
        "allowedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "明示的な利用言語の許可リスト。空配列では提供元が対応言語を検査します。"
        },
        "allowedWarningCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bodyFormat": {
          "enum": [
            "json",
            "binary",
            "multipart",
            "text",
            "none"
          ]
        },
        "contentTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedMethods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "integerLimits": {
          "type": "object"
        },
        "arrayLimits": {
          "type": "object"
        },
        "stringChoices": {
          "type": "object"
        },
        "model": {
          "type": "string"
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "publicCallPath": {
          "type": "string"
        },
        "maxOutputTokensByModel": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "description": "API・操作で許可したモデルごとの公開上限。nullは不定または非対応。"
        },
        "outputTokenLimitKinds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "documented",
              "dynamic",
              "unsupported",
              "unverified"
            ]
          }
        },
        "initialOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Realtime接続作成時の初期値。モデルの最大値とは別に扱う。"
        },
        "apiVersion": {
          "type": "string",
          "enum": [
            "2024-11-30"
          ],
          "description": "Document Intelligenceの検証済みAPI版。"
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288000,
          "description": "Document結果を解析するAPIM Classicのバッファリング技術上限。"
        },
        "embeddingDimensionsByModel": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default",
              "maximum"
            ],
            "properties": {
              "default": {
                "type": "integer",
                "minimum": 1
              },
              "maximum": {
                "type": "integer",
                "minimum": 1
              },
              "allowed": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "description": "モデル別の既定埋め込み次元と上限。allowedを省略した場合は1からmaximumまでの整数。"
        },
        "embeddingInputField": {
          "enum": [
            "input",
            "texts"
          ],
          "description": "登録した埋め込み提供元の入力フィールド。件数制限とは別に扱います。"
        },
        "modelAliases": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "description": "この操作が許可した配備モデルへ直接対応する別名。許可モデルや配備先を追加しません。",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "modelSettings": {
          "type": "object",
          "description": "操作の基本設定に重ねるモデル別の差分。許可モデルの一覧はallowedModelsが管理します。",
          "additionalProperties": {
            "$ref": "#/$defs/operationModelSettings"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requestBodySizeCheck": {
                "const": "declared"
              }
            },
            "required": [
              "requestBodySizeCheck"
            ]
          },
          "then": {
            "properties": {
              "bodyFormat": {
                "enum": [
                  "binary",
                  "multipart",
                  "text"
                ]
              }
            },
            "required": [
              "bodyFormat"
            ]
          }
        }
      ]
    },
    "operationBackendOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Operation単位の固定接続先。未指定値はAPI既定から継承。秘密交換はAPI単位。",
      "properties": {
        "backendService": {
          "enum": [
            "foundryOpenAi",
            "foundryCognitive",
            "foundryServices",
            "external"
          ]
        },
        "backendUrl": {
          "type": "string"
        },
        "backendAudience": {
          "type": "string"
        },
        "backendAuthentication": {
          "$ref": "#/$defs/backendAuthentication"
        },
        "backendHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "credentialConnection": {
      "type": "object",
      "additionalProperties": false,
      "description": "APIから利用するCredential Manager接続です。personalは認証済み接続セッション、serviceは固定のサービス接続を使います。",
      "required": [
        "mode",
        "providerName",
        "enabled"
      ],
      "properties": {
        "mode": {
          "enum": [
            "personal",
            "service"
          ]
        },
        "providerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "connectionName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "description": "serviceモードで利用する固定接続名です。"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "service"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "connectionName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "personal"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "connectionName"
              ]
            }
          }
        }
      ]
    },
    "credentialProvider": {
      "type": "object",
      "additionalProperties": false,
      "description": "追加OAuthプロバイダーの環境別登録情報です。nameでconfig側の追加定義と対応付けます。",
      "required": [
        "name",
        "clientId",
        "clientSecretFile"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientSecretFile": {
          "type": "string",
          "minLength": 1
        },
        "oauthTenantId": {
          "$ref": "#/$defs/guid"
        }
      }
    },
    "portalApiKeys": {
      "type": "object",
      "additionalProperties": false,
      "description": "初回Portal配備で明示する管理グループObject IDと、対象セキュリティグループ表示名の正規表現です。未設定項目は対話入力して同じparamsへ保存します。承認製品は標準API正本、購読数上限はconfigから決まります。",
      "properties": {
        "platformGroupId": {
          "$ref": "#/$defs/guid",
          "description": "管理ダッシュボードと検証用購読を所有する管理グループのObject IDです。初回対話入力のため省略できます。"
        },
        "groupNamePattern": {
          "type": "string",
          "maxLength": 512,
          "default": "",
          "examples": [
            "^ORG_",
            "^(ORG_|DEPT_)",
            "^組織_.+$"
          ],
          "description": "対象セキュリティグループの表示名を選ぶRE2互換の正規表現。通常は大文字小文字を区別します。空欄は初回未設定で、azd up後段または個別のPortal配備で対話入力します。非対話では事前設定が必要です。空欄を全許可にはしません。"
        }
      }
    },
    "queryObservationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])",
      "not": {
        "enum": [
          "none",
          "unknown"
        ]
      },
      "description": "クエリの観測対象を識別するラベルです。拒否条件やモデル機能の制限には使いません。"
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "description": "空のオブジェクトを明示したHTTP操作を、本文読取り前のContent-Type宣言の確認対象にします。欠落・複数値・空欄を拒否し、MIMEの許可一覧は使いません。メソッドとURLはAPIMの操作登録が照合します。省略した操作へ検査を自動追加しません。"
    }
  }
