# Disabled example: copy to .github/workflows only after configuring your own runner, environment and OIDC trust.
name: Portal image and deployment
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - apps/portal/**
      - scripts/deploy_portal.py
      - scripts/deployment/helpers/portal_image.py
      - scripts/deployment/helpers/portal_authentication.py
      - scripts/deployment/helpers/portal_gateway.py
      - .github/workflows/portal.yml
permissions:
  contents: read
  id-token: write
concurrency:
  group: portal-deploy
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: [self-hosted, linux, x64, example-vnet]
    environment: portal
    env:
      CORE_PARAMS_PATH: ${{ vars.CORE_PARAMS_PATH }}
      CORE_DEPLOYMENT_NAME: ${{ vars.CORE_DEPLOYMENT_NAME }}
    steps:
      - uses: actions/checkout@v4
      - name: Check deployment inputs
        shell: bash
        run: |
          set -euo pipefail
          test -n "$CORE_PARAMS_PATH"
          test -f "$CORE_PARAMS_PATH"
          test -n "$CORE_DEPLOYMENT_NAME"
      - uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      - name: Review Portal deployment plan
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/deploy_portal.py --config "$CORE_PARAMS_PATH" \
            --deployment-name "$CORE_DEPLOYMENT_NAME"
      - name: Build image, initialize SQL, then deploy Portal
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/deploy_portal.py --config "$CORE_PARAMS_PATH" \
            --deployment-name "$CORE_DEPLOYMENT_NAME" --execute
