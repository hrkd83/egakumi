{
  "schemas": {
    "PiiRedactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "Single nonblank text, at most 5,120 Unicode 8.0 text elements, validated by Language. The constructed native Language request must fit the provider limit of 1,000,000 UTF-8 bytes including its server-owned envelope. The received JSON is capped at six times this budget before parsing so JSON escaping does not impose a smaller logical limit. The text value is not Unicode-normalized, trimmed or truncated. No partial result is returned." },
        "language": { "type": "string", "minLength": 1 }
      }
    },
    "PiiRedactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redactedText", "language", "detectedCount", "modelVersion", "warningCodes", "requestId"],
      "properties": {
        "redactedText": { "type": "string" },
        "language": { "type": "string", "minLength": 1 },
        "detectedCount": { "type": "integer", "minimum": 0 },
        "modelVersion": { "type": "string" },
        "warningCodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requestId": { "type": "string", "format": "uuid" }
      }
    },
    "PiiRedactError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "requestId"],
      "properties": {
        "error": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string" } } },
        "requestId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
