{
  "released": true,
  "name": "cohere-inference-v1",
  "displayName": "Cohere Inference V1",
  "path": "models/cohere/v1",
  "backendService": "foundryServices",
  "backendAudience": "https://ai.azure.com",
  "productId": "model-users",
  "subscriptionKeyHeader": "api-key",
  "operations": [
    {
      "name": "cohere-embeddings",
      "displayName": "Cohere Text Embeddings",
      "method": "POST",
      "urlTemplate": "/embed",
      "templateParameters": [],
      "backendUrlTemplate": "/providers/cohere/v2/embed"
    },
    {
      "name": "rerank",
      "displayName": "Rerank",
      "method": "POST",
      "urlTemplate": "/rerank",
      "templateParameters": [],
      "backendUrlTemplate": "/providers/cohere/v2/rerank"
    }
  ],
  "keySubscriptions": [],
  "authorization": {
    "mode": "subscriptionKey",
    "operationConstraints": {
      "cohere-embeddings": {
        "kind": "textEmbeddings",
        "bodyFormat": "json",
        "maxRequestBytes": 524288000,
        "allowedModels": [
          "embed-v-4-0"
        ],
        "stringChoices": {
          "input_type": [
            "search_document",
            "search_query",
            "classification",
            "clustering"
          ]
        },
        "embeddingDimensionsByModel": {
          "embed-v-4-0": {
            "default": 1536,
            "maximum": 1536,
            "allowed": [
              256,
              512,
              1024,
              1536
            ]
          }
        },
        "embeddingInputField": "texts"
      },
      "rerank": {
        "kind": "rerank",
        "maxRequestBytes": 524288000,
        "bodyFormat": "json",
        "allowedModels": [
          "Cohere-rerank-v4.0-fast",
          "Cohere-rerank-v4.0-pro"
        ]
      }
    }
  },
  "backendAuthentication": {
    "mode": "managedIdentity"
  },
  "serviceClass": "platform"
}
