<fragment>
  <choose><when condition="@((int)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;status&quot;] == 409 &amp;&amp; (string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;mode&quot;] == &quot;personal&quot;)">
  <!-- 本人認証が必要になった業務APIから、認証窓口へ開始を依頼します。
       検証済みの購読とAPI設定の接続先を渡し、利用者に開いてもらうURLを返します。 -->
  <send-request mode="new" response-variable-name="gatewayConnectionChallengeResponse" timeout="20" ignore-error="true">
    <set-url>{{core-credential-broker-url}}/v1/challenge</set-url>
    <set-method>POST</set-method>
    <set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header>
    <set-header name="X-Core-Subscription-Id" exists-action="override"><value>@(context.Subscription.Id)</value></set-header>
    <set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-body>@{
      var selection = JObject.Parse((string)context.Variables["gatewayConnectionSelection"]);
      return new JObject(new JProperty("providerName", selection["profileName"]),
        new JProperty("connectionSession", (string)context.Variables["gatewayConnectionRequestSession"]),
        new JProperty("reason", (string)context.Variables["gatewayConnectionChallengeReason"])).ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
  </send-request>
  <!-- 認証窓口の応答を検査し、このGatewayの一時URLだけを呼出元へ案内します。 -->
  <set-variable name="gatewayConnectionChallengeResult" value="@{
    var denied = new JObject(new JProperty(&quot;status&quot;, 503));
    try {
      var response = context.Variables.ContainsKey(&quot;gatewayConnectionChallengeResponse&quot;) ? context.Variables[&quot;gatewayConnectionChallengeResponse&quot;] as IResponse : null;
      if (response == null || response.Body == null) { return denied.ToString(); }
      if (response.StatusCode != 200) {
        denied[&quot;status&quot;] = response.StatusCode == 403 ? 403 : response.StatusCode == 429 ? 429 : 503;
        return denied.ToString();
      }
      var bytes = response.Body.As&lt;byte[]&gt;(preserveContent: true);
      if (bytes.Length &gt; 16384) { return denied.ToString(); }
      var value = JObject.Parse(System.Text.Encoding.UTF8.GetString(bytes));
      var origin = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(&quot;__CREDENTIAL_LOGIN_ORIGIN_BASE64__&quot;));
      var tx = (string)value[&quot;transactionId&quot;]; var poll = (string)value[&quot;pollSecret&quot;];
      var provisional = (string)value[&quot;provisionalConnectionSession&quot;];
      var login = (string)value[&quot;loginUrl&quot;]; var statusUrl = (string)value[&quot;statusUrl&quot;];
      if ((string)value[&quot;status&quot;] != &quot;need_login&quot; || !System.Text.RegularExpressions.Regex.IsMatch(tx ?? &quot;&quot;, &quot;^[a-f0-9]{64}$&quot;)
          || !System.Text.RegularExpressions.Regex.IsMatch(poll ?? &quot;&quot;, &quot;^[a-f0-9]{64}$&quot;)
          || value[&quot;protocolVersion&quot;]?.Type != JTokenType.Integer || (int)value[&quot;protocolVersion&quot;] != 2
          || !System.Text.RegularExpressions.Regex.IsMatch(provisional ?? &quot;&quot;, &quot;^cs2[.][a-f0-9]{64}[.][a-f0-9]{64}$&quot;)
          || value[&quot;expiresIn&quot;]?.Type != JTokenType.Integer || (int)value[&quot;expiresIn&quot;] &lt; 60 || (int)value[&quot;expiresIn&quot;] &gt; 600) { return denied.ToString(); }
      var prefix = origin + &quot;/auth/connections/browser/launch#transactionId=&quot; + tx + &quot;&amp;launch=&quot;;
      if (login == null || !login.StartsWith(prefix, StringComparison.Ordinal)
          || !System.Text.RegularExpressions.Regex.IsMatch(login.Substring(prefix.Length), &quot;^[a-f0-9]{64}$&quot;)
          || statusUrl != origin + &quot;/auth/connections/status?transactionId=&quot; + tx) { return denied.ToString(); }
      var auth = new JObject(new JProperty(&quot;protocolVersion&quot;, 2), new JProperty(&quot;provisionalConnectionSession&quot;, provisional), new JProperty(&quot;status&quot;, &quot;need_login&quot;), new JProperty(&quot;loginUrl&quot;, login),
        new JProperty(&quot;transactionId&quot;, tx), new JProperty(&quot;pollSecret&quot;, poll),
        new JProperty(&quot;statusUrl&quot;, statusUrl), new JProperty(&quot;expiresIn&quot;, (int)value[&quot;expiresIn&quot;]));
      return new JObject(new JProperty(&quot;status&quot;, 409), new JProperty(&quot;authentication&quot;, auth)).ToString(Newtonsoft.Json.Formatting.None);
    } catch { return denied.ToString(Newtonsoft.Json.Formatting.None); }
  }" />
  </when><otherwise>
    <set-variable name="gatewayConnectionChallengeResult" value="@{ var selection=JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;]); return new JObject(new JProperty(&quot;status&quot;,(int)selection[&quot;status&quot;])).ToString(Newtonsoft.Json.Formatting.None); }" />
  </otherwise></choose>
  <set-variable name="gatewayAuditPhase" value="rejected" />
  <set-variable name="gatewayAuditStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayConnectionChallengeResult&quot;])[&quot;status&quot;])" />
  <set-variable name="gatewayAuditCode" value="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 409 ? &quot;CONNECTION_REAUTHORIZATION_REQUIRED&quot; : &quot;CREDENTIAL_CONNECTION_DENIED&quot;)" />
  __GATEWAY_TELEMETRY_XML__
  <!-- 呼出アプリはloginUrlを利用者へ表示し、残りの秘密情報をサーバーで保持して完了を確認します。 -->
  <return-response>
    <set-status code="@((int)context.Variables[&quot;gatewayAuditStatus&quot;])" reason="Personal connection authentication" />
    <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <set-header name="Referrer-Policy" exists-action="override"><value>no-referrer</value></set-header>
    <set-header name="WWW-Authenticate" exists-action="delete" />
    <set-header name="Location" exists-action="delete" />
    <set-header name="Set-Cookie" exists-action="delete" />
    <set-header name="Authentication-Info" exists-action="delete" />
    <set-body>@{
      var result = JObject.Parse((string)context.Variables["gatewayConnectionChallengeResult"]);
      var status = (int)result["status"];
      var body = new JObject(new JProperty("error", new JObject(new JProperty("code", status == 409 ? "ConnectionRequired" : status == 403 ? "ConnectionNotAuthorized" : status == 429 ? "ConnectionRateLimited" : "ConnectionUnavailable"))));
      if (status == 409 &amp;&amp; result["authentication"] != null) { body["authentication"] = result["authentication"]; }
      return body.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
  </return-response>
</fragment>
