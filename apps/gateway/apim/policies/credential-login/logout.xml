<policies>
<!-- logout: brokerがSQLの取引・セッションを照合します。購読IDは要求ヘッダーを上書きして渡します。 -->
<inbound><base/><!-- APIMで検証済みの購読だけをbrokerへ渡します。 -->
 <choose><when condition="@(context.Subscription == null || !context.Variables.ContainsKey(&quot;gatewayCommonAuthenticationValidated&quot;) || !(bool)context.Variables[&quot;gatewayCommonAuthenticationValidated&quot;])"><return-response><set-status code="401" reason="Connection unavailable"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>{"error":{"code":"AuthenticationRequired"}}</set-body></return-response></when></choose>

<set-variable name="credentialSessionRequest" value="@{
  try {
    if(!context.Request.Headers.ContainsKey(&quot;X-Core-Connection-Session&quot;) || context.Request.Headers[&quot;X-Core-Connection-Session&quot;].Length!=1) { return &quot;&quot;; }
    var token=context.Request.Headers.GetValueOrDefault(&quot;X-Core-Connection-Session&quot;,&quot;&quot;);
    if(!System.Text.RegularExpressions.Regex.IsMatch(token,&quot;^cs2[.][a-f0-9]{64}[.][a-f0-9]{64}$&quot;)) { return &quot;&quot;; }
    var result=new JObject(new JProperty(&quot;connectionSession&quot;,token),new JProperty(&quot;subscriptionId&quot;,context.Subscription.Id));

    return result.ToString(Newtonsoft.Json.Formatting.None);
  } catch { return &quot;&quot;; }
}" />
<choose><when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;credentialSessionRequest&quot;]))">
  <return-response><set-status code="400" reason="Invalid session request" />
    <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <set-body>{"error":{"code":"InvalidRequest"}}</set-body>
  </return-response>
</when></choose>
<set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
<set-body>@((string)context.Variables["credentialSessionRequest"])</set-body>
<set-header name="X-Core-Connection-Session" exists-action="delete" />
<set-backend-service backend-id="credential-broker"/>
<rewrite-uri template="/v1/logout" copy-unmatched-params="false"/>
<set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header><set-header name="X-Core-Subscription-Id" exists-action="override"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cookie" exists-action="delete"/>
<set-header name="Authorization" exists-action="delete"/><set-header name="__CREDENTIAL_KEY_HEADER__" exists-action="delete"/>
</inbound><backend><forward-request timeout="30"/></backend>
<outbound><base/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="Referrer-Policy" exists-action="override"><value>no-referrer</value></set-header></outbound>
<on-error>
<!-- APIM自身の購読認可・流量制限は、brokerの一時障害と区別して呼出元へ返します。 -->
<set-variable name="credentialProxyErrorStatus" value="@(context.LastError.Source == &quot;authorization&quot; &amp;&amp; (context.LastError.Reason == &quot;SubscriptionKeyNotFound&quot; || context.LastError.Reason == &quot;SubscriptionKeyInvalid&quot;) ? 401 : context.LastError.Source == &quot;rate-limit-by-key&quot; &amp;&amp; context.LastError.Reason == &quot;RateLimitExceeded&quot; ? 429 : 503)" />
<return-response><set-status code="@((int)context.Variables[&quot;credentialProxyErrorStatus&quot;])" reason="Connection operation failed"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>@((int)context.Variables["credentialProxyErrorStatus"] == 401 ? "{\"error\":{\"code\":\"AuthenticationRequired\"}}" : (int)context.Variables["credentialProxyErrorStatus"] == 429 ? "{\"error\":{\"code\":\"RateLimitExceeded\"}}" : "{\"error\":{\"code\":\"ConnectionUnavailable\"}}")</set-body></return-response></on-error></policies>
