<policies>
<!-- launch-post: brokerがSQLの取引・セッションを照合します。購読IDは要求ヘッダーを上書きして渡します。 -->
<inbound><base/><set-variable name="credentialLoginSettings" value="@(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(&quot;__CREDENTIAL_LOGIN_SETTINGS__&quot;)))" /><set-variable name="credentialOriginValid" value="@{ var expected=(string)JObject.Parse((string)context.Variables[&quot;credentialLoginSettings&quot;])[&quot;publicOrigin&quot;]; return context.Request.Headers.ContainsKey(&quot;Origin&quot;) &amp;&amp; context.Request.Headers[&quot;Origin&quot;].Length == 1 &amp;&amp; context.Request.Headers.GetValueOrDefault(&quot;Origin&quot;, &quot;&quot;) == expected; }" /><choose><when condition="@(!(bool)context.Variables[&quot;credentialOriginValid&quot;])"><return-response><set-status code="403" reason="Connection unavailable"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>{"error":{"code":"ConnectionNotAuthorized"}}</set-body></return-response></when></choose>
<set-backend-service backend-id="credential-broker"/>
<rewrite-uri template="/v1/launch" copy-unmatched-params="false"/>
<set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header><set-header name="X-Core-Subscription-Id" exists-action="override"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
<set-header name="Authorization" exists-action="delete"/><set-header name="__CREDENTIAL_KEY_HEADER__" exists-action="delete"/>
</inbound><backend><forward-request timeout="30"/></backend>
<outbound><base/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="Referrer-Policy" exists-action="override"><value>no-referrer</value></set-header></outbound>
<on-error><return-response><set-status code="409" reason="Connection sign in was not completed" /><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>text/html; charset=utf-8</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="Referrer-Policy" exists-action="override"><value>no-referrer</value></set-header><set-header name="Content-Security-Policy" exists-action="override"><value>default-src 'none'; style-src 'sha256-sW+Jn+uvubXbyJYiYspKM3vOMHTDi4pkHTN0TjRi4EU='; base-uri 'none'; frame-ancestors 'none'; form-action 'none'</value></set-header><set-body>&lt;!doctype html&gt;&lt;html lang="ja"&gt;&lt;head&gt;&lt;meta charset="utf-8"&gt;&lt;meta name="viewport" content="width=device-width,initial-scale=1"&gt;&lt;title&gt;接続処理を完了できませんでした&lt;/title&gt;&lt;style&gt;body{margin:0;background:#f5f7fa;color:#17212f;font:16px/1.7 system-ui,'Segoe UI',Meiryo,sans-serif}main{width:calc(100% - 96px);max-width:560px;margin:12vh auto;padding:32px;background:#fff;border:1px solid #dce2ea;border-radius:12px}h1{font-size:24px;margin:0 0 16px}p{margin:12px 0}.note{color:#536273}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;main&gt;&lt;h1&gt;接続処理を完了できませんでした&lt;/h1&gt;&lt;p&gt;元のアプリで接続を開始し直してください。再び失敗する場合は、管理者へお問い合わせください。&lt;/p&gt;&lt;p class="note"&gt;この画面は閉じてかまいません。&lt;/p&gt;&lt;/main&gt;&lt;/body&gt;&lt;/html&gt;</set-body></return-response></on-error></policies>