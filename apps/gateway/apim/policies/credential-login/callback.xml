  return new JObject(new JProperty(&quot;transactionId&quot;,tx),new JProperty(&quot;state&quot;,state),new JProperty(&quot;cookie&quot;,cookie)).ToString(Newtonsoft.Json.Formatting.None);
 } catch { return &quot;&quot;; }
