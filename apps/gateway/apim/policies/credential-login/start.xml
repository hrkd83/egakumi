<policies>
<!-- start: brokerがSQLの取引・セッションを照合します。購読IDは要求ヘッダーを上書きして渡します。 -->
<inbound><base/><!-- APIMで検証済みの購読だけをbrokerへ渡します。 -->
 <choose><when condition="@(context.Subscription == null || !context.Variables.ContainsKey(&quot;gatewayCommonAuthenticationValidated&quot;) || !(bool)context.Variables[&quot;gatewayCommonAuthenticationValidated&quot;])"><return-response><set-status code="401" reason="Connection unavailable"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>{"error":{"code":"AuthenticationRequired"}}</set-body></return-response></when></choose><rate-limit-by-key calls="__CREDENTIAL_LOGIN_CALLS__" renewal-period="60" counter-key="@(&quot;credential-login-start:&quot; + context.Subscription.Id)" retry-after-variable-name="credentialLoginStartRetryAfter"/>
<set-backend-service backend-id="credential-broker"/>
<rewrite-uri template="/v1/start" copy-unmatched-params="false"/>
<set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header><set-header name="X-Core-Subscription-Id" exists-action="override"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cookie" exists-action="delete"/>
<set-header name="Authorization" exists-action="delete"/><set-header name="__CREDENTIAL_KEY_HEADER__" exists-action="delete"/>
</inbound><backend><forward-request timeout="30"/></backend>
<outbound><base/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="Referrer-Policy" exists-action="override"><value>no-referrer</value></set-header></outbound>
<on-error>
<!-- APIM自身の購読認可・流量制限は、brokerの一時障害と区別して呼出元へ返します。 -->
<set-variable name="credentialProxyErrorStatus" value="@(context.LastError.Source == &quot;authorization&quot; &amp;&amp; (context.LastError.Reason == &quot;SubscriptionKeyNotFound&quot; || context.LastError.Reason == &quot;SubscriptionKeyInvalid&quot;) ? 401 : context.LastError.Source == &quot;rate-limit-by-key&quot; &amp;&amp; context.LastError.Reason == &quot;RateLimitExceeded&quot; ? 429 : 503)" />
<!-- rate-limit-by-keyの推奨秒を安全な整数に限定し、欠落時も固定窓内の待機を案内します。 -->
<set-variable name="credentialProxyRetryAfter" value="@{
 var retry = context.Variables.ContainsKey(&quot;credentialLoginStartRetryAfter&quot;) ? Convert.ToString(context.Variables[&quot;credentialLoginStartRetryAfter&quot;]) : &quot;&quot;; var seconds = 0;
 return System.Text.RegularExpressions.Regex.IsMatch(retry, &quot;^[0-9]{1,3}\\z&quot;) &amp;&amp; Int32.TryParse(retry, out seconds) &amp;&amp; seconds &gt;= 1 &amp;&amp; seconds &lt;= 300 ? seconds.ToString() : &quot;60&quot;;
}" />
<return-response><set-status code="@((int)context.Variables[&quot;credentialProxyErrorStatus&quot;])" reason="Connection operation failed"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="Retry-After" exists-action="@((int)context.Variables[&quot;credentialProxyErrorStatus&quot;] == 429 ? &quot;override&quot; : &quot;delete&quot;)"><value>@((string)context.Variables["credentialProxyRetryAfter"])</value></set-header><set-body>@((int)context.Variables["credentialProxyErrorStatus"] == 401 ? "{\"error\":{\"code\":\"AuthenticationRequired\"}}" : (int)context.Variables["credentialProxyErrorStatus"] == 429 ? "{\"error\":{\"code\":\"RateLimitExceeded\"}}" : "{\"error\":{\"code\":\"ConnectionUnavailable\"}}")</set-body></return-response></on-error></policies>