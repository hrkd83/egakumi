<policies>
<!-- status: brokerがSQLの取引・セッションを照合します。検証済みの購読またはユーザー主体を上書きして渡します。 -->
<inbound><base/>
<set-variable name="credentialCallerId" value="@{
 try {
  if(!context.Variables.ContainsKey(&quot;gatewayCommonAuthenticationValidated&quot;) || !(bool)context.Variables[&quot;gatewayCommonAuthenticationValidated&quot;]) { return &quot;&quot;; }
  var user=context.Variables.ContainsKey(&quot;gatewayEntraAuthenticationValidated&quot;) &amp;&amp; (bool)context.Variables[&quot;gatewayEntraAuthenticationValidated&quot;];
  if(!user) { return context.Subscription==null ? &quot;&quot; : &quot;subscription:&quot;+context.Subscription.Id; }
  if(context.Subscription!=null || !context.Variables.ContainsKey(&quot;gatewayUserAuthentication&quot;)) { return &quot;&quot;; }
  var auth=JObject.Parse((string)context.Variables[&quot;gatewayUserAuthentication&quot;]);
  Guid tenant,owner;
  if(auth[&quot;schemaVersion&quot;]?.Type!=JTokenType.Integer || (int)auth[&quot;schemaVersion&quot;]!=1 || !Guid.TryParse((string)auth[&quot;tenantId&quot;],out tenant) || tenant==Guid.Empty || !Guid.TryParse((string)auth[&quot;principalId&quot;],out owner) || owner==Guid.Empty) { return &quot;&quot;; }
  var id=&quot;user:&quot;+tenant.ToString(&quot;D&quot;)+&quot;:&quot;+owner.ToString(&quot;D&quot;);
  return (string)auth[&quot;callerId&quot;]==id &amp;&amp; (string)auth[&quot;allocationId&quot;]==id ? id : &quot;&quot;;
 } catch { return &quot;&quot;; }
}" />
<!-- APIMで検証済みの主体だけをbrokerへ渡します。 -->
 <choose><when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;credentialCallerId&quot;]))"><return-response><set-status code="401" reason="Connection unavailable"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>{"error":{"code":"AuthenticationRequired"}}</set-body></return-response></when></choose>
<set-backend-service backend-id="credential-broker"/>
<rewrite-uri template="/v1/status" copy-unmatched-params="true"/>
<set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header><set-header name="X-Core-Subscription-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;delete&quot; : &quot;override&quot;)"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Caller-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;override&quot; : &quot;delete&quot;)"><value>@((string)context.Variables["credentialCallerId"])</value></set-header><set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cookie" exists-action="delete"/>
<set-header name="Authorization" exists-action="delete"/><set-header name="__CREDENTIAL_KEY_HEADER__" exists-action="delete"/>
</inbound><backend><forward-request timeout="30"/></backend>
<outbound><base/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="Referrer-Policy" exists-action="override"><value>no-referrer</value></set-header></outbound>
<on-error>
<!-- APIM自身の購読認可・流量制限は、brokerの一時障害と区別して呼出元へ返します。 -->
<set-variable name="credentialProxyErrorStatus" value="@(context.LastError.Source == &quot;authorization&quot; &amp;&amp; (context.LastError.Reason == &quot;SubscriptionKeyNotFound&quot; || context.LastError.Reason == &quot;SubscriptionKeyInvalid&quot;) ? 401 : context.LastError.Source == &quot;rate-limit-by-key&quot; &amp;&amp; context.LastError.Reason == &quot;RateLimitExceeded&quot; ? 429 : 503)" />
<return-response><set-status code="@((int)context.Variables[&quot;credentialProxyErrorStatus&quot;])" reason="Connection operation failed"/><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>@((int)context.Variables["credentialProxyErrorStatus"] == 401 ? "{\"error\":{\"code\":\"AuthenticationRequired\"}}" : (int)context.Variables["credentialProxyErrorStatus"] == 429 ? "{\"error\":{\"code\":\"RateLimitExceeded\"}}" : "{\"error\":{\"code\":\"ConnectionUnavailable\"}}")</set-body></return-response></on-error></policies>