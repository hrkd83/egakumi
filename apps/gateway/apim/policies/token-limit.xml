<fragment>
  <!-- トークン制限はOpenAI形式Chat/Responsesの対応操作だけに適用します。 -->
  <set-variable name="gatewayLlmTokenLimitEnabled" value="@{
    var settings = JObject.Parse((string)context.Variables[&quot;gatewayAuditSettings&quot;]);
    var operations = settings[&quot;tokenLimitOperationIds&quot;] as JArray;
    return !(bool)context.Variables[&quot;gatewayRateLimitExempt&quot;] &amp;&amp; operations != null &amp;&amp; operations.Any(value =&gt; (string)value == context.Operation.Id);
  }" />
  <choose><when condition="@((bool)context.Variables[&quot;gatewayLlmTokenLimitEnabled&quot;])">
    <set-variable name="gatewayTokensPerMinute" value="@((int?)JObject.Parse((string)context.Variables[&quot;gatewaySubscriptionProfile&quot;])[&quot;tokensPerMinute&quot;] ?? 0)" />
    <set-variable name="gatewayTokenQuota" value="@{
      var quota = JObject.Parse((string)context.Variables[&quot;gatewaySubscriptionProfile&quot;])[&quot;tokenQuota&quot;] as JObject;
      return quota == null ? 0 : (int)quota[&quot;tokens&quot;];
    }" />
    <set-variable name="gatewayTokenQuotaPeriod" value="@{
      var quota = JObject.Parse((string)context.Variables[&quot;gatewaySubscriptionProfile&quot;])[&quot;tokenQuota&quot;] as JObject;
      return quota == null ? &quot;Monthly&quot; : (string)quota[&quot;period&quot;];
    }" />
    <!-- SQLの上限値はInt32で保持します。APIMへはTPMをInt32、累積token-quotaをInt64で渡します。 -->
    <choose>
      <when condition="@((int)context.Variables[&quot;gatewayTokensPerMinute&quot;] &gt; 0 &amp;&amp; (int)context.Variables[&quot;gatewayTokenQuota&quot;] &gt; 0)">
        <llm-token-limit id="core-tokens-combined" counter-key="@(&quot;core-tokens-v1:&quot; + context.Subscription.Id)" tokens-per-minute="@((int)context.Variables[&quot;gatewayTokensPerMinute&quot;])" token-quota="@(Convert.ToInt64(context.Variables[&quot;gatewayTokenQuota&quot;]))" token-quota-period="@((string)context.Variables[&quot;gatewayTokenQuotaPeriod&quot;])" estimate-prompt-tokens="true" />
      </when>
      <when condition="@((int)context.Variables[&quot;gatewayTokensPerMinute&quot;] &gt; 0)">
        <llm-token-limit id="core-tokens-rate" counter-key="@(&quot;core-tokens-v1:&quot; + context.Subscription.Id)" tokens-per-minute="@((int)context.Variables[&quot;gatewayTokensPerMinute&quot;])" estimate-prompt-tokens="true" />
      </when>
      <when condition="@((int)context.Variables[&quot;gatewayTokenQuota&quot;] &gt; 0)">
        <llm-token-limit id="core-tokens-quota" counter-key="@(&quot;core-tokens-v1:&quot; + context.Subscription.Id)" token-quota="@(Convert.ToInt64(context.Variables[&quot;gatewayTokenQuota&quot;]))" token-quota-period="@((string)context.Variables[&quot;gatewayTokenQuotaPeriod&quot;])" estimate-prompt-tokens="true" />
      </when>
    </choose>
  </when></choose>
</fragment>
