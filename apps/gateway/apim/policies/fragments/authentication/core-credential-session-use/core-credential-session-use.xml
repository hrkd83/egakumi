<fragment>
<!-- 解決と本人照合に続く別の共通部品。fragmentの入れ子とサイズ超過を避けます。 -->
<choose><when condition="@((bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;allowed&quot;] &amp;&amp; (string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;mode&quot;] == &quot;personal&quot;)">
    <!-- 接続・Graph本人照合を通過した個人接続だけ、SQLで使用直前の期限・失効を確認します。 -->
      <send-request mode="new" response-variable-name="gatewayConnectionUseResponse" timeout="20" ignore-error="true">
        <set-url>{{core-credential-broker-url}}/v2/session/use</set-url><set-method>POST</set-method>
        <set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header>
        <set-header name="X-Core-Subscription-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;delete&quot; : &quot;override&quot;)"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Caller-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;override&quot; : &quot;delete&quot;)"><value>@((string)context.Variables["credentialCallerId"])</value></set-header>
        <set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>@{
          var selection=JObject.Parse((string)context.Variables["gatewayConnectionSelection"]);
          return new JObject(new JProperty("connectionSession",(string)context.Variables["gatewayConnectionRequestSession"]),
            new JProperty(context.Subscription==null ? "callerId" : "subscriptionId",context.Subscription==null ? (string)context.Variables["credentialCallerId"] : context.Subscription.Id),new JProperty("profileName",selection["profileName"]),
            new JProperty("verifiedOwnerId",selection["ownerId"]),new JProperty("apiId",context.Api.Id),new JProperty("operationId",context.Operation.Id)).ToString(Newtonsoft.Json.Formatting.None);
        }</set-body>
      </send-request>
      <set-variable name="gatewayConnectionUseResult" value="@{
      __CORE_CREDENTIAL_USE_RESULT_CSHARP__
    }" />
      <!-- 値の保存・確定が遅れた場合は業務を実行せず、Microsoft再認証と区別して更新候補だけ返します。 -->
      <choose><when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionUseResult&quot;])[&quot;errorCode&quot;] == &quot;SessionUpdateRequired&quot;)">
        <set-variable name="gatewayAuditPhase" value="rejected" />
        <set-variable name="gatewayAuditCode" value="SESSION_UPDATE_REQUIRED" />
        <set-variable name="gatewayAuditStatus" value="@(409)" />
  <!-- 短い拒否監査には秘密・生のchallenge・本文を含めません。 -->
  __GATEWAY_TELEMETRY_XML__

        <return-response><set-status code="409" reason="Session update required" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          <set-body>@{ return new JObject(new JProperty("error",new JObject(new JProperty("code","SessionUpdateRequired"))),new JProperty("rotation",JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["rotation"])).ToString(Newtonsoft.Json.Formatting.None); }</set-body>
        </return-response>
      </when></choose>
      <choose><when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionUseResult&quot;])[&quot;allowed&quot;])">
        <set-variable name="gatewayConnectionSelection" value="@{ var selection=JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;]); selection[&quot;allowed&quot;]=false; selection[&quot;status&quot;]=JObject.Parse((string)context.Variables[&quot;gatewayConnectionUseResult&quot;])[&quot;status&quot;]; return selection.ToString(Newtonsoft.Json.Formatting.None); }" />
      </when></choose>
</when></choose>
  <!-- 再認証が必要な本人接続を、同じ認証案内へまとめます。 -->
  <choose><when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;allowed&quot;])">
    __CREDENTIAL_CHALLENGE_XML__
  </when></choose>
  <!-- expires_on は CM の公開メタデータです。token の中身を解析せず、監査用の絶対期限だけを取り出します。 -->
  <set-variable name="gatewayConnectionExpiresOn" value="@{
      __CORE_CREDENTIAL_USE_EXPIRES_ON_CSHARP__
    }" />
  <set-header name="X-Core-Connection-Session" exists-action="delete" /><set-header name="X-Core-Connection-Poll" exists-action="delete" /><set-header name="X-Core-Connection-Transaction" exists-action="delete" /><set-header name="X-Connection-Id" exists-action="delete" /><set-header name="X-Provider-Id" exists-action="delete" />
  <set-header name="X-Core-Broker-Key" exists-action="delete"/><set-header name="X-Core-Subscription-Id" exists-action="delete"/><set-header name="X-Core-Caller-Id" exists-action="delete"/><set-header name="Authorization" exists-action="override"><value>@("Bearer " + ((Authorization)context.Variables["gatewayConnectionContext"]).AccessToken)</value></set-header>
<set-header name="X-Core-Connection-Generation" exists-action="delete" />
<set-header name="X-Core-Connection-Idle-Expires-At" exists-action="delete" />
<set-header name="X-Core-Connection-Absolute-Expires-At" exists-action="delete" />
<set-header name="X-Core-Connection-Rotate-After" exists-action="delete" />
<set-header name="X-Core-Connection-Update" exists-action="delete" />
<set-header name="X-Core-Connection-Update-Id" exists-action="delete" />
<set-header name="X-Core-Connection-Update-From-Generation" exists-action="delete" />
<set-header name="X-Core-Connection-Update-Generation" exists-action="delete" />
<set-header name="X-Core-Connection-Update-Expires-At" exists-action="delete" />
</fragment>
