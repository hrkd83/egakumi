<fragment>
  <!-- この固定policy IDの上限超過だけを扱います。下流の429や認証エラーを同じ原因にしません。
       PIIのoperationにも埋め込み、親の上限超過がPII用502へ変わることを防ぎます。 -->
  <choose>
    <when condition="@(context.LastError.PolicyId == &quot;core-rate-limit&quot; &amp;&amp; context.LastError.Reason == &quot;RateLimitExceeded&quot;)">
      <set-variable name="gatewayRateSafeRetryAfter" value="@{
        var fallback = context.Variables.ContainsKey(&quot;gatewayRateDecision&quot;) ? (int)JObject.Parse((string)context.Variables[&quot;gatewayRateDecision&quot;])[&quot;renewalPeriodSeconds&quot;] : 60;
        var seconds = 0;
        if (context.Variables.ContainsKey(&quot;gatewayRateRetryAfter&quot;) &amp;&amp; Int32.TryParse(Convert.ToString(context.Variables[&quot;gatewayRateRetryAfter&quot;]), out seconds) &amp;&amp; seconds &gt;= 1 &amp;&amp; seconds &lt;= 300) { return seconds.ToString(); }
        return fallback.ToString();
      }" />
      <set-variable name="gatewayAuditPhase" value="rejected" />
      <set-variable name="gatewayAuditCode" value="RATE_LIMIT_EXCEEDED" />
      <set-variable name="gatewayAuditStatus" value="@(429)" />
      __GATEWAY_TELEMETRY_XML__
      <!-- 本文なしの固定応答はWebSocketのonHandshakeにも適用できます。生のエラーは返しません。 -->
      <return-response>
        <set-status code="429" reason="Caller request rate exceeded" />
        <set-header name="Retry-After" exists-action="override"><value>@((string)context.Variables[&quot;gatewayRateSafeRetryAfter&quot;])</value></set-header>
        <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="X-Core-Error-Code" exists-action="override"><value>RATE_LIMIT_EXCEEDED</value></set-header>
        <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
      </return-response>
    </when>
  </choose>
</fragment>
