<fragment>
<!-- 下流が同名ヘッダーを偽装しても、APIMが検証した候補以外は返しません。 -->
<set-header name="X-Core-Connection-Generation" exists-action="delete" />
<set-header name="X-Core-Connection-Idle-Expires-At" exists-action="delete" />
<set-header name="X-Core-Connection-Absolute-Expires-At" exists-action="delete" />
<set-header name="X-Core-Connection-Rotate-After" exists-action="delete" />
<set-header name="X-Core-Connection-Update" exists-action="delete" />
<set-header name="X-Core-Connection-Update-Id" exists-action="delete" />
<set-header name="X-Core-Connection-Update-From-Generation" exists-action="delete" />
<set-header name="X-Core-Connection-Update-Generation" exists-action="delete" />
<set-header name="X-Core-Connection-Update-Expires-At" exists-action="delete" />
<set-variable name="gatewayConnectionClaimsRequired" value="@{
  try {
    var response=context.Response;
    if(response==null || response.StatusCode!=403) { return false; }
    var challenge=response.Headers.GetValueOrDefault(&quot;WWW-Authenticate&quot;,&quot;&quot;);
    if(challenge.Length&lt;=8192 &amp;&amp; challenge.IndexOf(&quot;insufficient_claims&quot;,StringComparison.OrdinalIgnoreCase)&gt;=0) { return true; }
    if(response.Body==null) { return false; }
    var bytes=response.Body.As&lt;byte[]&gt;(preserveContent:true); if(bytes.Length&gt;65536) { return false; }
    var body=JObject.Parse(System.Text.Encoding.UTF8.GetString(bytes));
    return (string)body[&quot;error&quot;]?[&quot;code&quot;]==&quot;insufficient_claims&quot;;
  } catch { return false; }
}" />
<choose><when condition="@((bool)context.Variables[&quot;gatewayConnectionClaimsRequired&quot;])">
  <!-- CMのloginLinkがclaimsを渡せることは未保証です。要求を無視せず、再認証ループも作りません。 -->
  <set-variable name="gatewayAuditPhase" value="backend-response" />
  <set-variable name="gatewayAuditCode" value="CONNECTION_CLAIMS_REQUIRED" />
  <set-variable name="gatewayAuditStatus" value="@(403)" />
  <!-- 短い拒否監査には秘密・生のchallenge・本文を含めません。 -->
  <trace source="core-gateway" severity="information"><message>@{ return new JObject(new JProperty("schemaVersion",1),new JProperty("event","gateway-request"),new JProperty("requestId",context.RequestId.ToString()),new JProperty("apiId",context.Api.Id),new JProperty("operationId",context.Operation.Id),new JProperty("phase",(string)context.Variables["gatewayAuditPhase"]),new JProperty("code",(string)context.Variables["gatewayAuditCode"]),new JProperty("status",(int)context.Variables["gatewayAuditStatus"])).ToString(Newtonsoft.Json.Formatting.None); }</message></trace>

  <return-response><set-status code="403" reason="Additional authentication requirements" />
    <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <set-header name="WWW-Authenticate" exists-action="delete" />
    <set-header name="Location" exists-action="delete" />
    <set-header name="Set-Cookie" exists-action="delete" />
    <set-header name="Authentication-Info" exists-action="delete" />
    <set-body>{"error":{"code":"ConnectionClaimsRequired","message":"The identity provider requires additional authentication. Contact the platform administrator."}}</set-body>
  </return-response>
</when></choose>
  <!--
    外部 API が token を拒否した場合に、利用者へ再接続が必要と伝える共通処理です。
    バックエンドの 401 をそのまま返すと Gateway の入口認証失敗と混同するため、接続の再認証が必要な 409 に変換します。
    下流の権限不足 403 は再接続要求と分け、403 のまま固定の案内へ置き換えます。
    外部サービスの challenge・接続先 URL・本文を流さず、固定の案内と監査コードに置き換えます。
  -->
  <!-- A provider can reject a cached token before its advertised expiry.
       Return a recovery code without forwarding provider error details or URLs.
       A downstream ACL denial (403) remains distinct from authentication failure. -->
  <choose>
    <when condition="@(context.Response.StatusCode == 401)">
      <!-- 本人接続の失効は、元の購読と本人セッションを照合して再認証を開始します。 -->
      <set-variable name="gatewayConnectionChallengeReason" value="token_rejected" />
      <set-variable name="gatewayConnectionSelection" value="@{ var selection=JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;]); selection[&quot;allowed&quot;]=false; selection[&quot;status&quot;]=409; return selection.ToString(Newtonsoft.Json.Formatting.None); }" />
      __CREDENTIAL_CHALLENGE_XML__
    </when>
    <!-- 接続先の innerError や challenge を返さず、下流のACL不足を再同意要求と区別します。 -->
    <when condition="@(context.Response.StatusCode == 403)">
      <set-variable name="gatewayAuditPhase" value="backend-response" />
      <set-variable name="gatewayAuditCode" value="CONNECTION_PERMISSION_DENIED" />
      <set-variable name="gatewayAuditStatus" value="@(403)" />
      __GATEWAY_TELEMETRY_XML__
      <return-response>
        <set-status code="403" reason="Connection permission denied" />
        <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        <set-header name="WWW-Authenticate" exists-action="delete" />
        <set-header name="Location" exists-action="delete" />
        <set-header name="Set-Cookie" exists-action="delete" />
        <set-header name="Authentication-Info" exists-action="delete" />
        <set-body>{"error":{"code":"ConnectionPermissionDenied","message":"The registered account is not permitted to perform this operation."}}</set-body>
      </return-response>
    </when>
  </choose>

  <!-- Graphの本文を変えず、検証済みの期限と値の更新候補だけを応答ヘッダーへ載せます。 -->
  <choose><when condition="@(context.Variables.ContainsKey(&quot;gatewayConnectionUseResult&quot;) &amp;&amp; (bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionUseResult&quot;])[&quot;allowed&quot;])">
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
<set-header name="X-Core-Connection-Generation" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["generation"])</value></set-header>
<set-header name="X-Core-Connection-Idle-Expires-At" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["idleExpiresAt"])</value></set-header>
<set-header name="X-Core-Connection-Absolute-Expires-At" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["absoluteExpiresAt"])</value></set-header>
<set-header name="X-Core-Connection-Rotate-After" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["nextRotationAt"])</value></set-header>
<choose><when condition="@(JObject.Parse((string)context.Variables[&quot;gatewayConnectionUseResult&quot;])[&quot;rotation&quot;] != null)">
<set-header name="X-Core-Connection-Update" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["rotation"]["candidateSession"])</value></set-header>
<set-header name="X-Core-Connection-Update-Id" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["rotation"]["rotationId"])</value></set-header>
<set-header name="X-Core-Connection-Update-From-Generation" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["rotation"]["fromGeneration"])</value></set-header>
<set-header name="X-Core-Connection-Update-Generation" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["rotation"]["generation"])</value></set-header>
<set-header name="X-Core-Connection-Update-Expires-At" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayConnectionUseResult"])["rotation"]["expiresAt"])</value></set-header>
</when></choose>
</when></choose>
</fragment>
