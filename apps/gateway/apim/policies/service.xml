<policies>
  <!-- 全APIに共通する入口の処理です。Azureポータルの All APIs に設定され、
       各APIの inbound にある base の位置で実行されます。
       先に要求の記録情報を準備し、AppGWの入口を確認してから、認証方法を選びます。
       通常のAPIは、キー用ヘッダーがあれば購読キー、なければEntraのBearerトークンを検証します。
       ブラウザーで接続ログインを開始する受付と、ログイン後の戻り先だけは、後述の条件で共通認証を省略します。
       共通処理が終わると各APIの処理へ戻り、そのAPIに必要な利用権限や接続を確認します。
       backend、outbound、on-error は、それぞれ転送・応答・エラーの段階で実行されます。 -->
  <inbound>
    <!-- ========== STEP1 要求情報の準備（core-request-context） ========== -->
    <!-- 目的：いつ、どのAPI・操作に来た要求かを、監査ログで追跡できるようにします。 -->
    <!-- 処理：要求ID・受信時刻・API／操作ID・接続元と相関情報を取得・整形し、gatewayRequestContextへ格納します。本文や資格情報は記録しません。 -->
    <include-fragment id="core-request-context" fragment-id="core-request-context" />
    <!-- === -->
    <!-- ========== STEP2 信頼したHTTP入口の確認（core-trusted-ingress） ========== -->
    <!-- 目的：HTTP要求がWAFのあるAppGW入口を通ったことを確認します。 -->
    <!-- 処理：入口確認が必要なHTTP要求のX-Core-L7-Ingressを検証し、欠落・不一致・重複なら監査を記録して403で終了します。 -->
    <include-fragment id="core-trusted-ingress" fragment-id="core-trusted-ingress" />
    <!-- === -->
    <!-- ========== STEP3 CMのブラウザー用APIの判定（core-credential-browser-exception） ========== -->
    <!-- 目的：CMのログイン開始画面・受付と、認証後の戻り先（callback）用APIへのアクセスを判定し、該当する要求だけSTEP4のキー／Bearer検証を省略できるようにします。 -->
    <!-- 理由：通常の画面遷移・フォーム送信・認証後のリダイレクトでは、API呼び出し用のキー／Bearerヘッダーが送られないためです。 -->
    <!-- 処理：CM設定とAPI ID・操作ID・HTTPメソッド・元のパスを照合し、該当する場合はtrue、それ以外の通常APIはfalseをgatewayCredentialBrowserExceptionへ保存します。 -->
    <!-- 補足：ここでは判定だけを行います。STEP4で省略するのは共通のキー／Bearer検証だけで、ログイン取引や本人の確認は後続の操作・Broker・CMが行います。 -->
    <include-fragment id="core-credential-browser-exception" fragment-id="core-credential-browser-exception" />
    <!-- === -->
    <!-- ========== STEP4 認証方法の選択と検証（core-common-authentication） ========== -->
    <!-- 目的：通常のAPI要求をキーまたはBearerで認証し、接続ログインの受付は各操作が担当する確認へ進めます。 -->
    <!-- 処理：STEP3の受付判定がtrueなら共通認証を省略し、それ以外はキー用ヘッダーの有無で認証方法を選んで検証します。 -->
    <include-fragment id="core-common-authentication" fragment-id="core-common-authentication" />
    <!-- === -->
    <!-- ========== STEP5 認証済み利用者情報の準備（core-audit-authenticated-subject） ========== -->
    <!-- 目的：共通認証で確認できた購読または社員を、各APIの利用許可とは別に監査ログで追跡できるようにします。 -->
    <!-- 処理：認証結果から識別情報をgatewayAuthenticatedSubjectへ格納し、ブラウザー受付の例外は共通認証で本人を未確認として区別します。 -->
    <include-fragment id="core-audit-authenticated-subject" fragment-id="core-audit-authenticated-subject" />
  </inbound>
  <!-- 転送段階の共通の既定処理です。inboundを通過した要求を設定済みのバックエンドへ送ります。
       各APIが継承・上書きするbackendポリシーと、inboundで選んだ接続先の設定が適用されます。 -->
  <backend><forward-request /></backend>
  <outbound>
    <!-- 応答段階では、要求を受けたときのIDをapim-request-idヘッダーに付けて返します。
         利用者からこのIDを聞くことで、監査ログやバックエンドの記録と照合できます。 -->
    <set-header id="core-response-request-id" name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
  </outbound>
  <on-error>
    <!-- ポリシー処理などでエラーになった場合も、照合用のapim-request-idを返します。
         Bearerトークン検証のエラーだった場合は、下の専用処理で拒否を監査へ記録し401を返します。 -->
    <set-header id="core-error-request-id" name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <include-fragment id="core-entra-authentication-error" fragment-id="core-entra-authentication-error" />
  </on-error>
</policies>
