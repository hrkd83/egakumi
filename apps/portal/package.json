{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:catalog": "node --experimental-strip-types scripts/prepare-model-catalog.ts",
    "prepare:realtime": "node --experimental-strip-types scripts/prepare-realtime-worklet.ts",
    "predev": "npm run prepare:catalog && npm run prepare:realtime",
    "dev": "node --use-env-proxy --conditions=react-server --experimental-strip-types scripts/serve-portal.ts --dev",
    "prebuild": "npm run prepare:catalog && npm run prepare:realtime",
    "build": "next build",
    "start": "node --conditions=react-server --experimental-strip-types scripts/serve-portal.ts",
    "lint": "eslint",
    "pretest": "npm run prepare:catalog",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --conditions=react-server --experimental-strip-types scripts/migrate-auth.ts",
    "db:bootstrap-local": "node --conditions=react-server --experimental-strip-types scripts/bootstrap-local-sql.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@formatjs/intl-localematcher": "0.9.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "geist": "1.8.2",
    "jose": "6.2.14",
    "kysely": "0.29.7",
    "lucide-react": "^1.64.0",
    "negotiator": "1.1.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "re2-wasm": "1.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tarn": "3.1.2",
    "tedious": "19.2.1",
    "tw-animate-css": "^1.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/negotiator": "0.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  },
  "license": "Apache-2.0"
}
