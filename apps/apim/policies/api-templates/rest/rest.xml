<policies>
  <!-- HTTP APIの入力検査・下流接続用テンプレート。 -->
  <inbound>
    <!-- ========== API設定の準備（core-api-settings） ========== -->
    <!-- 目的：共通処理へ、このAPIの監査・制御設定を渡します。 -->
    <!-- 処理：API固有データを共通部品で読み、監査・制御の2変数へ格納します。 -->
    <set-variable name="gatewayApiSettingsSource" value="__API_SETTINGS_BASE64__" />
    <include-fragment id="core-api-settings" fragment-id="core-api-settings" />
    <!-- === -->
    <!-- ========== 共通ポリシーの適用 ========== -->
    <!-- 目的：共通の入口確認・認証・監査情報の準備を実行します。 -->
    <!-- 処理：上位のInboundを実行します。拒否されなければ、このAPIの後続処理へ戻ります。 -->
    <base />
    <!-- === -->
    <!-- ========== API要求の準備（core-api-request-preparation） ========== -->
    <!-- 目的：共通Inboundから戻った要求を、このAPIの後続処理へ渡せる状態にします。 -->
    <!-- 処理：内部IDの申告ヘッダーを削除し、要求IDをAPIMの値へ揃え、共通認証の完了を確認します。 -->
    <include-fragment id="core-api-request-preparation" fragment-id="core-api-request-preparation" />
    <!-- === -->
    <!-- ========== クエリ概要の観測と記録 ========== -->
    <!-- 目的：HTTP操作が明示した観測ラベルから、URLクエリの概要を監査へ渡します。 -->
    <!-- 処理：要求準備の後、操作・モデル設定の選択や本文読取りより前に観測部品を呼び、receivedを記録します。有無と複数値を観測するだけで、クエリを理由に要求を拒否しません。 -->
    <include-fragment fragment-id="core-query-observation" />
    <set-variable name="gatewayQueryPhase" value="received" />
    <include-fragment fragment-id="core-query-telemetry" />
    <!-- === -->
    <!-- ========== 操作の入力契約の確認（core-api-input-validation） ========== -->
    <!-- 目的：検査対象の操作で、本文を読む前にContent-Typeの宣言を確認します。 -->
    <!-- 処理：共通部品がContent-Typeの欠落・複数値・空欄を検査し、gatewayApiInputValidationPassedへ結果を格納します。falseなら宣言不備を監査へ記録し、要求ID付きの400を返して後続処理を止めます。 -->
    <!-- 対象外の操作は検査を省略して後続へ進みます。MIMEの許可一覧は使わず、メソッドとURLの照合はAPIMが担当します。 -->
    <include-fragment id="core-api-input-validation" fragment-id="core-api-input-validation" />
    <!-- 部品の設定不備はポリシーエラーへ進み、Content-Type宣言不備の400応答とは区別します。 -->
    <choose>
      <when condition="@(!(bool)context.Variables[&quot;gatewayApiInputValidationPassed&quot;])">
        <!-- 拒否理由と応答コードを監査へ渡します。不正なヘッダーの値や本文は記録しません。 -->
        <set-variable name="gatewayAuditPhase" value="rejected" />
        <set-variable name="gatewayAuditCode" value="INVALID_CONTENT_TYPE_HEADER" />
        <set-variable name="gatewayAuditStatus" value="@(400)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <!-- ログ照合用の要求IDを返し、応答を保存しないようno-storeを指定します。応答本文は作りません。 -->
        <return-response>
          <set-status code="400" reason="Invalid Content-Type header" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- === -->
    <!-- ========== 操作設定とモデル別設定の準備（core-api-operation-settings） ========== -->
    <!-- 目的：この操作と要求したモデルに対応する設定を、後続処理へ渡します。 -->
    <!-- 処理：共通部品が操作の基本設定を読み、モデル別の指定項目を上書きしてgatewayOperationSelectionへ格納します。モデルを読む場合は先に元の本文サイズを確認します。 -->
    <!-- モデル設定を使わない操作は本文を読まずに進みます。失敗理由と応答は直後の処理で監査へ渡します。 -->
    <include-fragment id="core-api-operation-settings" fragment-id="core-api-operation-settings" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;allowed&quot;])">
        <!-- 選択処理が返した原因とHTTPコードを監査へ渡します。本文やmodelの申告値は記録しません。 -->
        <set-variable name="gatewayAuditCode" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;code&quot;] ?? &quot;OPERATION_SETTINGS_INVALID&quot;)" />
        <set-variable name="gatewayAuditStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;status&quot;])" />
        <!-- 内部設定不備500と、入力不備400・本文超過413の要求拒否を監査で区別します。 -->
        <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 500 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <!-- 本文・modelの形式不備400、本文超過413、設定不備500を原因に合う理由で返し、要求IDでログを照合できるようにします。 -->
        <return-response>
          <set-status code="@((int)context.Variables[&quot;gatewayAuditStatus&quot;])" reason="@((string)context.Variables[&quot;gatewayAuditCode&quot;] == &quot;OPERATION_SETTINGS_INVALID&quot; ? &quot;API operation settings are invalid&quot;
            : (string)context.Variables[&quot;gatewayAuditCode&quot;] == &quot;INVALID_REQUEST_BODY&quot; ? &quot;Invalid request body&quot;
            : (string)context.Variables[&quot;gatewayAuditCode&quot;] == &quot;INVALID_REQUEST_MODEL&quot; ? &quot;Invalid request model&quot;
            : (string)context.Variables[&quot;gatewayAuditCode&quot;] == &quot;REQUEST_TOO_LARGE&quot; ? &quot;Request too large&quot; : &quot;API operation settings are invalid&quot;)" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- === -->
    <!-- ========== 認証済み利用者情報の引き渡し（core-api-authentication-result） ========== -->
    <!-- 目的：共通入口で認証した利用者を、このAPIの後続処理と監査へ引き渡します。 -->
    <!-- 処理：APIMの検証済み購読があれば購読情報を、なければ共通認証済みのBearer本人情報を引き継ぎます。内部情報を引き継げない場合は監査を記録し、500で終了します。 -->
    <include-fragment id="core-api-authentication-result" fragment-id="core-api-authentication-result" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;allowed&quot;])">
        <!-- 認証後の内部情報の引き渡し不備を、利用者の権限不足と区別して記録します。 -->
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="AUTHENTICATION_PROCESSING_ERROR" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- === -->
    <!-- ========== 本文サイズの確認（core-model-limits） ========== -->
    <!-- 目的：選択済みの操作設定に従い、受信本文のサイズを確認します。 -->
    <!-- 処理：選択結果から操作設定と後段で使う解決済みモデル名を取り出し、共通部品でサイズを検査します。停止する場合は結果の理由・応答コードを監査へ渡して終了します。 -->
    <set-variable name="gatewayOperationConstraint" value="@{
      return JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;constraint&quot;].ToString(Newtonsoft.Json.Formatting.None);
    }" />
    <set-variable name="gatewayEffectiveModel" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;effectiveModel&quot;] ?? &quot;&quot;)" />
    <!-- 本文の書き換えや下流認証より前に検査し、元の本文を後続へ渡せるよう保持します。 -->
    <include-fragment id="core-model-limits" fragment-id="core-model-limits" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayLimitDecision&quot;])[&quot;allowed&quot;])">
        <set-variable name="gatewayAuditCode" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayLimitDecision&quot;])[&quot;code&quot;])" />
        <set-variable name="gatewayAuditStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayLimitDecision&quot;])[&quot;status&quot;])" />
        <!-- 内部設定不備500と、本文超過413の要求拒否を監査で区別します。 -->
        <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 500 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <!-- PIIの早期拒否も同じ公開エラー契約を返します。認可・上限・監査は維持します。 -->
        <choose id="core-pii-public-limit-error">
          <when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayOperationConstraint&quot;])[&quot;kind&quot;] == &quot;pii&quot; &amp;&amp; (int)context.Variables[&quot;gatewayAuditStatus&quot;] == 413 &amp;&amp; (string)context.Variables[&quot;gatewayAuditCode&quot;] == &quot;REQUEST_TOO_LARGE&quot;)">
            <return-response>
              <set-status code="413" reason="Invalid PII input" />
              <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
              <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
              <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
              <set-body>@{ return new JObject(new JProperty("error", new JObject(new JProperty("code", "PiiInputTooLarge"))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None); }</set-body>
            </return-response>
          </when>
        </choose>
        <!-- 原因に合う理由文を返し、要求ID付きのエラー応答を保存・再利用しないよう指定します。 -->
        <return-response>
          <set-status code="@((int)context.Variables[&quot;gatewayAuditStatus&quot;])" reason="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 500 ? &quot;Gateway processing failed&quot; : &quot;Request too large&quot;)" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          <set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (string)context.Variables["gatewayAuditCode"]))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body>
        </return-response>
      </when>
    </choose>
    <!-- === -->
    <!-- ========== 音声合成の本文検査（core-speech-ssml-guard） ========== -->
    <!-- 目的：音声合成のサイズとSSMLを、利用枠処理・下流認証・正常受付の記録より前に確認します。 -->
    <!-- 処理：配備時に生成した対象操作IDの表を読み、対象だけを専用部品で検査します。本文は一度だけ読み、超過413・宣言等の不備400を監査へ渡して終了します。 -->
    <choose id="core-speech-ssml-guard">
      <when condition="@{
        var controls = JObject.Parse((string)context.Variables[&quot;gatewayControlSettings&quot;]);
        return (controls[&quot;speechSsmlOperationIds&quot;] as JArray)?.Any(id =&gt; (string)id == context.Operation.Id) == true;
      }">
        <include-fragment id="core-speech-ssml-guard" fragment-id="core-speech-ssml-guard" />
        <choose>
          <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewaySpeechSsmlDecision&quot;])[&quot;allowed&quot;])">
            <!-- 本文や宣言の内容は記録せず、検査結果の理由と応答コードだけを監査へ渡します。 -->
            <set-variable name="gatewayAuditPhase" value="rejected" />
            <set-variable name="gatewayAuditCode" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewaySpeechSsmlDecision&quot;])[&quot;code&quot;])" />
            <set-variable name="gatewayAuditStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewaySpeechSsmlDecision&quot;])[&quot;status&quot;])" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <choose>
              <when condition="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 413)">
                <!-- 実サイズ超過は、共有サイズ検査と同じ413・要求ID付きJSONを返します。 -->
                <return-response>
                  <set-status code="413" reason="Request too large" />
                  <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
                  <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
                  <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
                  <set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (string)context.Variables["gatewayAuditCode"]))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body>
                </return-response>
              </when>
            </choose>
            <!-- SSMLの拒否は従来の400と公開エラー本文を維持します。 -->
            <return-response>
              <set-status code="400" reason="Invalid Speech markup" />
              <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
              <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
              <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
              <set-body>{"error":{"code":"InvalidSpeechMarkup","message":"DTD and entity declarations are not allowed in Speech markup."}}</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
    <!-- === -->
    <!-- ========== モデル・機能の確認（core-api-target-validation） ========== -->
    <!-- 目的：準備済みの操作設定に従い、モデルと操作固有の本文機能を確認します。 -->
    <!-- 処理：サイズ確認済みの操作設定から種類を取得します。本文のモデル入力・Embedding・Rerankは提供元で確認します。 -->
    <!-- その他の種類では既存部品を実行し、内部設定500・JSON読取り不備400・条件不適合403を区別します。 -->
    <set-variable name="gatewayOperationKind" value="@{
      var kind = JObject.Parse((string)context.Variables[&quot;gatewayOperationConstraint&quot;])[&quot;kind&quot;];
      return kind?.Type == JTokenType.String ? (string)kind : &quot;&quot;;
    }" />
    <choose id="core-api-target-validation-selection">
      <when condition="@{
        var kind = (string)context.Variables[&quot;gatewayOperationKind&quot;];
        return kind != &quot;bodyModel&quot; &amp;&amp; kind != &quot;textEmbeddings&quot; &amp;&amp; kind != &quot;rerank&quot;;
      }">
        <include-fragment id="core-api-target-validation" fragment-id="core-api-target-validation" />
        <choose>
          <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayTargetDecision&quot;])[&quot;allowed&quot;])">
            <set-variable name="gatewayAuditCode" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayTargetDecision&quot;])[&quot;code&quot;])" />
            <set-variable name="gatewayAuditStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayTargetDecision&quot;])[&quot;status&quot;])" />
            <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 500 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <return-response>
              <set-status code="@((int)context.Variables[&quot;gatewayAuditStatus&quot;])" reason="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 500 ? &quot;Gateway processing failed&quot; : ((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 400 ? &quot;Invalid request body&quot; : &quot;API target is not authorized&quot;))" />
              <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
              <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
    <!-- ========== Document解析の入力設定の確認（core-document-input-validation） ========== -->
    <!-- 目的：解析開始のmodelクエリを、利用回数制限・下流認証・正常受付の記録より前に確認します。 -->
    <!-- 処理：対象操作だけ同名部品を呼び、model入力の不備400と内部変数の引渡し失敗500を監査と応答へ渡します。 -->
    <!-- 原本とNative JSONの本文は読み取り・変換せず、解析可否は提供元へ任せます。 -->
    <choose id="core-document-input-validation">
      <when condition="@((string)context.Variables[&quot;gatewayOperationKind&quot;] == &quot;documentAnalysis&quot;)">
        <include-fragment id="core-document-input-validation" fragment-id="core-document-input-validation" />
        <choose>
          <when condition="@((int)context.Variables[&quot;documentInputStatus&quot;] != 200)">
            <!-- 入力不備と設定不備を区別して記録します。本文・クエリ値・内部設定は監査へ出しません。 -->
            <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;documentInputStatus&quot;] == 500 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
            <set-variable name="gatewayAuditCode" value="@((int)context.Variables[&quot;documentInputStatus&quot;] == 500 ? &quot;OPERATION_SETTINGS_INVALID&quot; : &quot;INVALID_REQUEST&quot;)" />
            <set-variable name="gatewayAuditStatus" value="@((int)context.Variables[&quot;documentInputStatus&quot;])" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <!-- 入力不備は既存のDocumentInvalidInput、設定不備はDocumentAnalysisUnavailableで要求を終了します。 -->
            <return-response>
              <set-status code="@((int)context.Variables[&quot;documentInputStatus&quot;])" reason="@((int)context.Variables[&quot;documentInputStatus&quot;] == 500 ? &quot;Document operation settings are invalid&quot; : &quot;Invalid document input&quot;)" />
              <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
              <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
              <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
              <set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (int)context.Variables["documentInputStatus"] == 500 ? "DocumentAnalysisUnavailable" : "DocumentInvalidInput"))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
    <!-- === -->
    <!-- 選択済みの操作制約は制御用設定へ戻し、監査メタデータへ混ぜません。
         本文からのモデル名取得は通常HTTPに限定します。 -->
    <set-variable name="gatewayControlSettings" value="@{
      var settings = JObject.Parse((string)context.Variables[&quot;gatewayControlSettings&quot;]);
      settings[&quot;operationConstraints&quot;][context.Operation.Id] = JObject.Parse((string)context.Variables[&quot;gatewayOperationConstraint&quot;]);
      return settings.ToString(Newtonsoft.Json.Formatting.None);
    }" />
    <!-- Normalize only after original-byte limits and authorization succeed.
         Existing audit and native token limits then see the actual deployment. -->
    <choose id="core-model-alias">
      <when condition="@(!String.IsNullOrEmpty((string)context.Variables[&quot;gatewayEffectiveModel&quot;]) &amp;&amp; (string)JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;requestedModel&quot;] != (string)context.Variables[&quot;gatewayEffectiveModel&quot;])">
        <set-body>@{
      __GATEWAY_MODEL_ALIAS_BODY_CSHARP__
        }</set-body>
      </when>
    </choose>
    <include-fragment fragment-id="core-audit-body-model" />
    <include-fragment fragment-id="core-audit-context" />
    <!-- 全Agent Responses操作へstore=falseを設定し、指定時だけconversation=null・background=falseへ揃えます。
         保存防止は操作kindで選び、Agent名がない追加操作も対象にします。metadataの対象は従来どおりです。
         対象Agentには既存の親要求IDも同じ本文編集で渡し、本文の追加読取りは増やしません。
         metadataがオブジェクトなら他の値を保持し、そうでなければ作り直して同名の親要求IDを上書きします。 -->
    <choose id="core-hosted-response-metadata"><when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayOperationConstraint&quot;])[&quot;kind&quot;] == &quot;hostedAgentPost&quot; || !String.IsNullOrEmpty((string)JObject.Parse((string)context.Variables[&quot;gatewayAuditSettings&quot;])[&quot;targetAgent&quot;]))">
      <set-body>@{
      __GATEWAY_HOSTED_BODY_CSHARP__
    }</set-body>
    </when></choose>
    <!-- 終了要求を上限で妨げません。認証・操作許可と下流の所有者検査は維持します。 -->
    <set-variable name="gatewayRateLimitExempt" value="@{
      var kind = (string)JObject.Parse((string)context.Variables[&quot;gatewayOperationConstraint&quot;])[&quot;kind&quot;];
      return kind == &quot;realtimeHangup&quot; || (kind == &quot;a2aJsonRpc&quot; &amp;&amp; (string)context.Request.Body.As&lt;JObject&gt;(preserveContent: true)[&quot;method&quot;] == &quot;tasks/cancel&quot;);
    }" />
    __SUBSCRIPTION_PROFILE_XML__
    <include-fragment fragment-id="core-rate-limit" />
    __TOKEN_LIMIT_XML__
    <!-- ========== Chatの保存指定の無効化（core-chat-store-disabled） ========== -->
    <!-- 目的：FoundryのChat操作へstore=falseを必ず設定します。対象は配備時に操作・実効接続先から選び、モデル一覧には依存しません。 -->
    <!-- 処理：alias反映後の本文を一度だけ消費して読み、準備した文字列をそのままset-bodyへ渡します。 -->
    <set-variable name="gatewayChatStoreDisabled" value="@{
      var controls = JObject.Parse((string)context.Variables[&quot;gatewayControlSettings&quot;]);
      return ((JArray)controls[&quot;chatStoreDisabledOperationIds&quot;]).Any(id =&gt; (string)id == context.Operation.Id);
    }" />
    <choose id="core-chat-store-disabled">
      <when condition="@((bool)context.Variables[&quot;gatewayChatStoreDisabled&quot;])">
        <include-fragment id="core-chat-store-disabled" fragment-id="core-chat-store-disabled" />
        <choose>
          <when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;gatewayChatRequestBody&quot;]))">
            <!-- 書換えに必要なJSONを取得できない入力を、要求ID付きの400と監査へ渡します。本文は返しません。 -->
            <set-variable name="gatewayAuditPhase" value="rejected" />
            <set-variable name="gatewayAuditCode" value="INVALID_REQUEST_BODY" />
            <set-variable name="gatewayAuditStatus" value="@(400)" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <return-response>
              <set-status code="400" reason="Invalid request body" />
              <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
              <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
            </return-response>
          </when>
        </choose>
        <set-body>@((string)context.Variables[&quot;gatewayChatRequestBody&quot;])</set-body>
      </when>
    </choose>
    <!-- === -->
    <!-- 共有Model GatewayのResponsesは、今回の応答を保存しないstore=falseへ変換します。 -->
    <!-- backgroundがあればfalseへ上書きし、streamを維持して通常のJSON／SSE処理を続けます。 -->
    <!-- conversationがあればnullへ上書きし、store=falseとは別に会話へ入出力を保存する指定を解除します。 -->
    <!-- 受け付けたprevious_response_id・promptと、inputのID・type・内容・順序は変更せず、参照と入力仕様を提供元へ任せます。 -->
    <!-- SSEと暗号化されたreasoning・functionのItemsを含む応答は、従来どおりそのまま返します。 -->
    <set-variable name="gatewayStatelessResponses" value="@{
      return (string)JObject.Parse((string)context.Variables[&quot;gatewayOperationConstraint&quot;])[&quot;kind&quot;] == &quot;statelessResponses&quot;;
    }" />
    <choose>
      <when condition="@((bool)context.Variables[&quot;gatewayStatelessResponses&quot;])">
        <set-body>@{
      __GATEWAY_RESPONSES_BODY_CSHARP__
    }</set-body>
      </when>
    </choose>
    <!-- 旧クライアントのprofile申告は無視し、下流へも渡さないよう削除します。認証情報ではありません。 -->
    <set-header name="X-Egakumi-Profile" exists-action="delete" />
    __GRAPH_OBO_ASSERTION_XML__
    <!-- 下流へ転送する前に、入口の資格情報をヘッダーから取り除きます。 -->
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="__KEY_HEADER__" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-query-parameter name="api-key" exists-action="delete" />
    <set-header name="X-Core-L7-Ingress" exists-action="delete" />
    __DEFAULT_BACKEND_XML__
    <!-- core-http-credential-inbound-start -->
    <!-- CMの有無は生成時に選択済みです。設定があるAPIは既存の接続・セッション確認を直接呼びます。 -->
    <!-- CM未設定のAPIでは、設定代入を含むこの区画を宣言済みの下流認証へ置き換えます。 -->
    <set-variable name="gatewayCredentialConnection" value="__CREDENTIAL_CONNECTION_BASE64__" />
    <include-fragment fragment-id="core-credential-connection" />
    __CREDENTIAL_CALLER_ERROR_XML__
    <include-fragment fragment-id="core-credential-session-use" />
    <!-- core-http-credential-inbound-end -->
    <!-- CMの本人セッション証明はGateway内で使い、接続先へ渡しません。 -->
    <set-header name="X-Core-Connection-Session" exists-action="delete" />
    <set-header name="X-Core-Connection-Poll" exists-action="delete" />
    <set-header name="X-Core-Connection-Transaction" exists-action="delete" />
    __BACKEND_HEADERS_XML__
    <set-variable name="gatewayAuditPhase" value="accepted" />
    <set-variable name="gatewayAuditCode" value="GATEWAY_ALLOWED" />
    <set-variable name="gatewayAuditStatus" value="@(0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
  </inbound>
  <!-- このAPIの転送処理です。backendにbaseがないため、上位のforward-requestは継承しません。
       inboundで選んだ接続先と下流用認証を使うforward-requestを1つ定義します。
       応答ヘッダー待機は240秒、転送時の応答バッファリングは無効です。HTTP版と要求バッファリングはAPIMの既定値です。 -->
  <backend><forward-request timeout="240" buffer-response="false" /></backend>
  <!-- 正常に裏側応答を受け取った後の処理。必要な変換と安全な監査情報だけを追加します。 -->
  <outbound>
    <include-fragment fragment-id="core-backend-audit" />
    <base />
    <!-- core-http-credential-outbound-start -->
    <!-- CMの有無は生成時に確定済みです。CM APIは下流応答処理を直接呼び、未設定APIはこの区画を生成しません。 -->
    <include-fragment fragment-id="core-credential-connection-outbound" />
    <!-- core-http-credential-outbound-end -->
    <set-variable name="gatewayAuditPhase" value="backend-response" />
    <set-variable name="gatewayAuditCode" value="BACKEND_RESPONSE" />
    <set-variable name="gatewayAuditStatus" value="@(context.Response.StatusCode)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    <set-variable name="gatewayQueryPhase" value="backend-response" />
    <include-fragment fragment-id="core-query-telemetry" />
  </outbound>
  <!-- 認証・接続・ポリシー実行が例外になった経路。秘密を含む下流の生エラーを監査へ流しません。 -->
  <on-error>
    <base />
    __RATE_LIMIT_ERROR_XML__
    __AUDIT_BODY_MODEL_ERROR_XML__
    <set-variable name="gatewayAuditPhase" value="policy-error" />
    <set-variable name="gatewayAuditCode" value="POLICY_ERROR" />
    <!-- 確定した400以上のエラーだけを記録し、通信断や既定値200は0（未確定）とします。 -->
    <set-variable name="gatewayAuditStatus" value="@(context.Response != null &amp;&amp; context.Response.StatusCode &gt;= 400 ? context.Response.StatusCode : 0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    <set-variable name="gatewayQueryPhase" value="policy-error" />
    <include-fragment fragment-id="core-query-telemetry" />
  </on-error>
</policies>
