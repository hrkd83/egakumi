<policies>
  <!--
    Realtime セッションを終了する制御 API です。call ID を知っているだけでは終了できません。
    署名・呼出元・契約・call ID・期限を照合したチケットを要求し、所有者と一致した場合だけ終了先へ送ります。
    チケットをバックエンドへ流さず、Gateway 内の所有者確認だけに使用します。
  -->
  <inbound>
    <base />
    <!-- 通話の作成・終了より前に、確認済みownerと期限設定を一度受け取ります。 -->
    __REALTIME_OWNER_CONTEXT_XML__
    <!-- 受け取ったチケットの署名を照合してから、対象 call ID と現在の検証済み購読・期限を比較します。 -->
    <set-variable id="core-realtime-hangup-owner" name="realtimeCallOwnerValid" value="@{
      __REALTIME_HANGUP_OWNER_CSHARP__
    }" />
    <choose>
      <when condition="@(!(bool)context.Variables[&quot;realtimeCallOwnerValid&quot;])">
        <return-response><set-status code="403" reason="Session control is not permitted" /><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-body>{"error":{"code":"SessionControlDenied"}}</set-body></return-response>
      </when>
    </choose>
    <set-method>POST</set-method>
    <rewrite-uri template="@(&quot;/realtime/calls/&quot; + context.Request.MatchedParameters[&quot;callId&quot;] + &quot;/hangup&quot;)" copy-unmatched-params="false" />
    <set-header name="X-Core-Call-Ticket" exists-action="delete" />
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-body>{}</set-body>
  </inbound>
  <!-- 裏側への転送段階。親の転送方針や HTTP 版を引き継ぎ、上で許可した要求だけを送ります。 -->
  <backend><base /></backend>
  <!-- 正常に裏側応答を受け取った後の処理。必要な変換と安全な監査情報だけを追加します。 -->
  <outbound><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><base /></outbound>
  <!-- 認証・接続・ポリシー実行が例外になった経路。秘密を含む下流の生エラーを監査へ流しません。 -->
  <on-error>
    <!-- この項目の内部owner・期限・チケット処理だけ、安全な500で停止します。 -->
    <!-- 別のPolicyIdは下のbaseへ進み、既存の共通認証・エラー処理を維持します。 -->
    <choose id="core-realtime-owner-error">
      <when condition="@(context.LastError.PolicyId == &quot;core-realtime-owner-context&quot; || context.LastError.PolicyId == &quot;core-realtime-session-settings&quot; || context.LastError.PolicyId == &quot;core-realtime-hangup-owner&quot;)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="@(context.LastError.PolicyId == &quot;core-realtime-session-settings&quot; ? &quot;OPERATION_SETTINGS_INVALID&quot; : &quot;AUTHENTICATION_PROCESSING_ERROR&quot;)" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <base />
  </on-error>
</policies>
