<fragment>
  <!-- core-subscription-profile-v1: 購読設定はSQLから読み、APIポリシーへ展開するsnippetです。 -->
  <!-- cacheはXMLに保持し、取得応答の検査式だけを同名C#から展開します。Azure登録fragmentは追加しません。 -->
  <set-variable name="gatewaySubscriptionProfile" value="{&quot;requestRate&quot;:null,&quot;tokensPerMinute&quot;:null,&quot;tokenQuota&quot;:null}" />
  <choose>
    <when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;method&quot;] == &quot;user&quot;)">
      <!-- 社員枠はserver設定だけから取得。購読profile API・SQL・cacheは使用しません。 -->
      <include-fragment fragment-id="core-entra-user-profile" />
    </when>
    <when condition="@(&quot;{{core-subscription-profile-enabled}}&quot; == &quot;true&quot; &amp;&amp; !(bool)context.Variables[&quot;gatewayRateLimitExempt&quot;])">
      <!-- 主キー・副キーは検証済み購読IDへ集約。設定の版をカウンターキーに含めません。 -->
      <set-variable name="gatewayProfileCacheKey" value="@(&quot;core-profile-v1:&quot; + context.Deployment.ServiceName + &quot;:&quot; + context.Subscription.Id)" />
      <cache-lookup-value key="@((string)context.Variables[&quot;gatewayProfileCacheKey&quot;])" variable-name="gatewayCachedProfile" caching-type="internal" />
      <choose>
        <when condition="@(!context.Variables.ContainsKey(&quot;gatewayCachedProfile&quot;))">
          <send-request mode="new" response-variable-name="gatewayProfileResponse" timeout="5" ignore-error="true">
            <set-url>{{core-subscription-profile-url}}</set-url>
            <set-method>GET</set-method>
            <set-header name="X-Core-Profile-Key" exists-action="override"><value>{{core-subscription-profile-secret}}</value></set-header>
            <set-header name="X-Core-Profile-Subscription" exists-action="override"><value>@(context.Subscription.Id)</value></set-header>
          </send-request>
          <set-variable name="gatewayFetchedProfile" value="@{
            __SUBSCRIPTION_PROFILE_CSHARP__
          }" />
          <choose><when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;gatewayFetchedProfile&quot;]))">
            <!-- 取得障害を無制限と読み替えず、下流を呼ぶ前に停止します。 -->
            <!-- 内部の取得不備を既存監査へ記録します。取得応答や例外詳細は記録しません。 -->
            <set-variable name="gatewayAuditPhase" value="policy-error" />
            <set-variable name="gatewayAuditCode" value="LIMIT_PROFILE_UNAVAILABLE" />
            <set-variable name="gatewayAuditStatus" value="@(503)" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <return-response><set-status code="503" reason="Service Unavailable" />
              <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
              <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
              <set-header name="Retry-After" exists-action="override"><value>5</value></set-header>
              <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
              <set-header name="X-Core-Error" exists-action="override"><value>LimitProfileUnavailable</value></set-header>
            </return-response>
          </when></choose>
          <set-variable name="gatewayCachedProfile" value="@((string)context.Variables[&quot;gatewayFetchedProfile&quot;])" />
          <cache-store-value key="@((string)context.Variables[&quot;gatewayProfileCacheKey&quot;])" value="@((string)context.Variables[&quot;gatewayFetchedProfile&quot;])" duration="30" caching-type="internal" />
        </when>
      </choose>
      <set-variable name="gatewaySubscriptionProfile" value="@((string)context.Variables[&quot;gatewayCachedProfile&quot;])" />
    </when>
  </choose>
</fragment>
