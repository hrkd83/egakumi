<fragment>
  <!-- ========== 利用回数枠の準備と計数（core-rate-limit） ========== -->
  <!-- 目的：認証済みEntraユーザーの利用回数枠を選び、入口で要求を数えます。 -->
  <!-- 処理：同名C#でgatewayRateDecisionを準備し、有効な枠だけrate-limit-by-keyを適用します。 -->
  <!-- 社員IDは確認済みのgatewayDecisionから引き継ぎ、既存の計数キーを維持します。 -->

  <set-variable name="gatewayRateDecision" value="@{
      __CORE_RATE_LIMIT_CSHARP__
    }" />
  <choose>
    <when condition="@((bool)JObject.Parse((string)context.Variables[&quot;gatewayRateDecision&quot;])[&quot;enabled&quot;])">

      <!-- 入口で即時に1要求を数えます。長いSSEや音声接続の終了まで加算を待ちません。 -->
      <rate-limit-by-key id="core-rate-limit"
        calls="@((int)JObject.Parse((string)context.Variables[&quot;gatewayRateDecision&quot;])[&quot;calls&quot;])"
        renewal-period="@((int)JObject.Parse((string)context.Variables[&quot;gatewayRateDecision&quot;])[&quot;renewalPeriodSeconds&quot;])"
        counter-key="@((string)JObject.Parse((string)context.Variables[&quot;gatewayRateDecision&quot;])[&quot;counterKey&quot;])"
        retry-after-variable-name="gatewayRateRetryAfter" />
    </when>
  </choose>
</fragment>
