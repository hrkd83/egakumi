<fragment>
  <choose>
    <when condition="@((string)context.Variables[&quot;gatewayEvidenceDirection&quot;] == &quot;snapshot&quot;)">
      <!-- APIの本文変換より前の値を保持し、送信は認可と利用枠の確認後に行います。 -->
      <set-variable name="gatewayEvidenceRequestType" value="@(context.Request.Headers.GetValueOrDefault(&quot;Content-Type&quot;, &quot;application/octet-stream&quot;))" />
      <set-variable name="gatewayEvidenceRequestEncoding" value="@(context.Request.Headers.GetValueOrDefault(&quot;Content-Encoding&quot;, &quot;identity&quot;))" />
      <set-variable name="gatewayEvidenceRequestBody" value="@{
        __EVIDENCE_REQUEST_BODY__
      }" />
    </when>
    <otherwise>
      <set-variable name="gatewayEvidenceResponse" value="@((string)context.Variables[&quot;gatewayEvidenceDirection&quot;] == &quot;response&quot;)" />
      <set-variable name="gatewayEvidencePayload" value="@{
        __EVIDENCE_PAYLOAD__
      }" />
      <set-variable name="gatewayEvidenceOmitted" value="@(((string)context.Variables[&quot;gatewayEvidencePayload&quot;]).StartsWith(&quot;!&quot;, StringComparison.Ordinal))" />
      <send-request mode="new" response-variable-name="gatewayEvidenceRelayResult" timeout="10" ignore-error="true">
        <set-url>{{core-audit-relay-url}}/v1/evidence</set-url>
        <set-method>POST</set-method>
        <set-header name="X-Ms-Client-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="X-Core-Audit-Api" exists-action="override"><value>@(context.Api.Id)</value></set-header>
        <set-header name="X-Core-Audit-Operation" exists-action="override"><value>@(context.Operation.Id)</value></set-header>
        <set-header name="X-Core-Audit-Direction" exists-action="override"><value>@((string)context.Variables["gatewayEvidenceDirection"])</value></set-header>
        <set-header name="Content-Type" exists-action="@(String.IsNullOrEmpty((string)context.Variables[&quot;gatewayEvidencePayload&quot;]) ? &quot;delete&quot; : &quot;override&quot;)">
          <value>@{
            var contentType = (bool)context.Variables["gatewayEvidenceResponse"]
              ? context.Response.Headers.GetValueOrDefault("Content-Type", "application/octet-stream") : (string)context.Variables["gatewayEvidenceRequestType"];
            return context.Variables.ContainsKey("gatewayEvidencePreparedStatus") ? "application/json"
              : String.IsNullOrWhiteSpace(contentType) ? "application/octet-stream" : contentType;
          }</value>
        </set-header>
        <set-header name="X-Core-Audit-Content-Encoding" exists-action="override">
          <value>@{
            var encoding = (bool)context.Variables["gatewayEvidenceResponse"]
              ? context.Response.Headers.GetValueOrDefault("Content-Encoding", "identity") : (string)context.Variables["gatewayEvidenceRequestEncoding"];
            return context.Variables.ContainsKey("gatewayEvidencePreparedStatus") || String.IsNullOrWhiteSpace(encoding) ? "identity" : encoding;
          }</value>
        </set-header>
        <set-header name="X-Core-Audit-Body-Omission" exists-action="@((bool)context.Variables[&quot;gatewayEvidenceOmitted&quot;] ? &quot;override&quot; : &quot;delete&quot;)">
          <value>@((bool)context.Variables["gatewayEvidenceOmitted"] ? ((string)context.Variables["gatewayEvidencePayload"]).Substring(1) : "")</value>
        </set-header>
        <set-header name="X-Core-Audit-Body-Transfer-Encoding" exists-action="override"><value>base64</value></set-header>
        <set-header name="X-Core-Audit-Status" exists-action="@((bool)context.Variables[&quot;gatewayEvidenceResponse&quot;] ? &quot;override&quot; : &quot;delete&quot;)">
          <value>@((bool)context.Variables["gatewayEvidenceResponse"] ? context.Variables.GetValueOrDefault&lt;int&gt;("gatewayEvidencePreparedStatus", context.Response.StatusCode).ToString() : "")</value>
        </set-header>
        <set-header name="X-Core-Audit-Capture-Id" exists-action="@((bool)context.Variables[&quot;gatewayEvidenceResponse&quot;] ? &quot;override&quot; : &quot;delete&quot;)">
          <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("gatewayEvidenceCaptureId", ""))</value>
        </set-header>
        <set-header name="X-Core-Audit-Next-Sequence" exists-action="@((bool)context.Variables[&quot;gatewayEvidenceResponse&quot;] ? &quot;override&quot; : &quot;delete&quot;)">
          <value>@(context.Variables.GetValueOrDefault&lt;int&gt;("gatewayEvidenceNextSequence", 0).ToString())</value>
        </set-header>
        <set-body>@((bool)context.Variables["gatewayEvidenceOmitted"] ? "" : (string)context.Variables["gatewayEvidencePayload"])</set-body>
        <authentication-managed-identity resource="{{core-audit-relay-audience}}" ignore-error="true" />
      </send-request>
      <set-variable name="gatewayEvidenceAck" value="@{
        __EVIDENCE_ACK__
      }" />
      <choose>
        <when condition="@((string)context.Variables[&quot;gatewayEvidenceAck&quot;] == &quot;unavailable&quot;)">
          <return-response>
            <set-status code="503" reason="Audit evidence unavailable" />
            <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
            <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          </return-response>
        </when>
        <when condition="@(!(bool)context.Variables[&quot;gatewayEvidenceResponse&quot;])">
          <set-variable name="gatewayEvidenceCaptureId" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayEvidenceAck&quot;])[&quot;captureId&quot;])" />
          <set-variable name="gatewayEvidenceNextSequence" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayEvidenceAck&quot;])[&quot;nextSequence&quot;])" />
        </when>
      </choose>
    </otherwise>
  </choose>
</fragment>
