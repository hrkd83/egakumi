<fragment>
  <!--
    Realtime の補助 WebSocket に入る前に、セッション所有者の署名チケットを照合します。
    開始操作で発行した call ID・呼出元・契約・期限との一致が必要です。チケットを他の利用者や別セッションへ流用させません。
    受信専用は Management Console の BFF 中継で実現します。直接このAPIへ接続した所有者のsideband制御は双方向です。
    APIM の onHandshake は確立後のフレームを検査しないため、この認証だけで送信を禁止したとは扱いません。
    https://learn.microsoft.com/azure/api-management/websocket-api
  -->
  <!-- 補助接続にも所有者照合を要求します。query は call_id １件に限定し、他の接続先指定を許可しません。 -->
  <!-- 親のonHandshakeは先行認証を完了済みです。補助接続を開く前にownerを受け取ります。 -->
  __REALTIME_OWNER_CONTEXT_XML__
  <set-variable id="core-realtime-observer-owner" name="realtimeObserverOwnerValid" value="@{
      __REALTIME_OBSERVER_OWNER_CSHARP__
    }" />
  <choose>
    <when condition="@(!(bool)context.Variables[&quot;realtimeObserverOwnerValid&quot;])">
      <return-response>
        <set-status code="403" reason="Session control is not permitted" />
        <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <!-- onHandshake は set-body 未対応。所有者不一致は本文なしの403で拒否します。 -->
      </return-response>
    </when>
  </choose>
  <set-header name="X-Core-Call-Ticket" exists-action="delete" />
</fragment>
