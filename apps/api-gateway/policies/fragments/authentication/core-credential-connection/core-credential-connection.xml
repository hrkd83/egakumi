<fragment>
  <!-- ========== CMの本人接続（core-credential-connection） ========== -->
  <!-- 先行認証が確認し、APIへ引き渡した呼出者IDを同名C#で取得します。 -->
  <!-- 社員JSON・GUID整形・認証成功印の再確認は行わず、IDの表記を維持します。 -->
  <!-- 内部読取り失敗は空IDとして接続選択で500を返し、呼出し元APIが監査・応答で停止します。 -->
  <set-variable name="credentialCallerId" value="@{
      __CORE_CREDENTIAL_CALLER_CSHARP__
    }" />

  <!-- 確認済み主体を使い、個人接続の場合はSQL台帳を持つbrokerへ本人セッションを照会します。
       CMの物理providerはbrokerの割当結果と構築時の設定を照合して決めます。 -->
<set-variable name="gatewayConnectionSelection" value="@{
      __CORE_CREDENTIAL_CONNECTION_SELECTION_CSHARP__
    }"/>
  <!-- 再認証時の照合に使う本人セッションを、この要求の中で保持します。 -->
  <set-variable name="gatewayConnectionRequestSession" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Core-Connection-Session&quot;,&quot;&quot;))" />
  <set-variable name="gatewayConnectionChallengeReason" value="session_required" />
  <choose><when condition="@((bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;allowed&quot;] &amp;&amp; (string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;mode&quot;] == &quot;personal&quot;)">
    <!-- provider数で増える定数をC#式の解析対象から分離します。照合する設定自体は変更しません。 -->
    <set-variable name="gatewayConnectionProviderSettings" value="__CREDENTIAL_LOGIN_SETTINGS__" />
    <!-- brokerの鍵と検証済み主体はAPIMが上書きします。要求の同名ヘッダーから本人や契約を決めません。 -->
    <send-request mode="new" response-variable-name="gatewayConnectionSessionResponse" timeout="20" ignore-error="true">
      <set-url>{{core-credential-broker-url}}/v2/session/authorize</set-url><set-method>POST</set-method>
      <set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header>
      <set-header name="X-Core-Subscription-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;delete&quot; : &quot;override&quot;)"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Caller-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;override&quot; : &quot;delete&quot;)"><value>@((string)context.Variables["credentialCallerId"])</value></set-header>
      <set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-body>@{ return new JObject(new JProperty("connectionSession",(string)context.Variables["gatewayConnectionRequestSession"]),new JProperty(context.Subscription==null ? "callerId" : "subscriptionId",context.Subscription==null ? (string)context.Variables["credentialCallerId"] : context.Subscription.Id),new JProperty("profileName",JObject.Parse((string)context.Variables["gatewayConnectionSelection"])["profileName"])).ToString(Newtonsoft.Json.Formatting.None); }</set-body>
    </send-request>
<set-variable name="gatewayConnectionSelection" value="@{
      __CORE_CREDENTIAL_CONNECTION_AUTHORIZE_RESULT_CSHARP__
    }"/>
  </when></choose>
  <choose><when condition="@((bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;allowed&quot;])">
  <!-- CM provider と接続は、検証した設定・セッションからだけ取得します。呼出元の接続名指定は使いません。 -->
  <get-authorization-context provider-id="@((string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;providerName&quot;])" authorization-id="@((string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;connectionId&quot;])" context-variable-name="gatewayConnectionContext" identity-type="managed" ignore-error="true" />
  <choose><when condition="@(!context.Variables.ContainsKey(&quot;gatewayConnectionContext&quot;) || context.Variables[&quot;gatewayConnectionContext&quot;] == null || String.IsNullOrEmpty(((Authorization)context.Variables[&quot;gatewayConnectionContext&quot;]).AccessToken))">
    <!-- token取得失敗だけで接続を作り直しません。CMが確定した接続失効だけを再認証へ分類します。 -->
    <choose><when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;mode&quot;] == &quot;personal&quot;)">
      <send-request mode="new" response-variable-name="gatewayConnectionStateResponse" timeout="20" ignore-error="true">
        <set-url>{{core-credential-broker-url}}/v2/connection/status</set-url><set-method>POST</set-method>
        <set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header>
        <set-header name="X-Core-Subscription-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;delete&quot; : &quot;override&quot;)"><value>@(context.Subscription == null ? "" : context.Subscription.Id)</value></set-header><set-header name="X-Core-Caller-Id" exists-action="@(((string)context.Variables[&quot;credentialCallerId&quot;]).StartsWith(&quot;user:&quot;) ? &quot;override&quot; : &quot;delete&quot;)"><value>@((string)context.Variables["credentialCallerId"])</value></set-header>
        <set-header name="X-Core-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>@{ return new JObject(new JProperty("connectionSession",(string)context.Variables["gatewayConnectionRequestSession"]),new JProperty(context.Subscription==null ? "callerId" : "subscriptionId",context.Subscription==null ? (string)context.Variables["credentialCallerId"] : context.Subscription.Id),new JProperty("profileName",JObject.Parse((string)context.Variables["gatewayConnectionSelection"])["profileName"])).ToString(Newtonsoft.Json.Formatting.None); }</set-body>
      </send-request>
    </when></choose>
    <set-variable name="gatewayConnectionChallengeReason" value="token_rejected" />
    <set-variable name="gatewayConnectionSelection" value="@{
      __CORE_CREDENTIAL_CONNECTION_REFRESH_UNAVAILABLE_CSHARP__
    }" />
  </when></choose>
  <choose><when condition="@((bool)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;allowed&quot;] &amp;&amp; (string)JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;])[&quot;mode&quot;] == &quot;personal&quot;)">
    <!-- 更新された CM token でも、固定した本人確認先で元の本人との一致を確認します。 -->
    <send-request mode="new" response-variable-name="gatewayConnectionIdentityResponse" timeout="20" ignore-error="true"><set-url>@((string)JObject.Parse((string)context.Variables["gatewayConnectionSelection"])["identityEndpoint"])</set-url><set-method>GET</set-method><set-header name="X-Core-Broker-Key" exists-action="delete"/><set-header name="X-Core-Subscription-Id" exists-action="delete"/><set-header name="X-Core-Caller-Id" exists-action="delete"/><set-header name="Authorization" exists-action="override"><value>@("Bearer " + ((Authorization)context.Variables["gatewayConnectionContext"]).AccessToken)</value></set-header></send-request>
<set-variable name="gatewayConnectionClaimsRequired" value="@{
      __CORE_CREDENTIAL_CONNECTION_CLAIMS_REQUIRED_CSHARP__
    }" />
<choose><when condition="@((bool)context.Variables[&quot;gatewayConnectionClaimsRequired&quot;])">
  <!-- CMのloginLinkがclaimsを渡せることは未保証です。要求を無視せず、再認証ループも作りません。 -->
  <set-variable name="gatewayAuditPhase" value="rejected" />
  <set-variable name="gatewayAuditCode" value="CONNECTION_CLAIMS_REQUIRED" />
  <set-variable name="gatewayAuditStatus" value="@(403)" />
  <!-- 短い拒否監査には秘密・生のchallenge・本文を含めません。 -->
  __GATEWAY_TELEMETRY_XML__

  <return-response><set-status code="403" reason="Additional authentication requirements" />
    <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <set-header name="WWW-Authenticate" exists-action="delete" />
    <set-header name="Location" exists-action="delete" />
    <set-header name="Set-Cookie" exists-action="delete" />
    <set-header name="Authentication-Info" exists-action="delete" />
    <set-body>{"error":{"code":"ConnectionClaimsRequired","message":"The identity provider requires additional authentication. Contact the platform administrator."}}</set-body>
  </return-response>
</when></choose>
    <set-variable name="gatewayConnectionIdentityStatus" value="@{
      __CORE_CREDENTIAL_CONNECTION_IDENTITY_STATUS_CSHARP__
    }" />
    <!-- Graphが再認証を要求した場合は認証URLを返し、本人不一致と通信障害はそれぞれ拒否・障害として扱います。 -->
    <choose><when condition="@((int)context.Variables[&quot;gatewayConnectionIdentityStatus&quot;] != 200)">
      <set-variable name="gatewayConnectionChallengeReason" value="token_rejected" />
      <set-variable name="gatewayConnectionSelection" value="@{ var selection=JObject.Parse((string)context.Variables[&quot;gatewayConnectionSelection&quot;]); selection[&quot;allowed&quot;]=false; selection[&quot;status&quot;]=(int)context.Variables[&quot;gatewayConnectionIdentityStatus&quot;]; return selection.ToString(Newtonsoft.Json.Formatting.None); }" />
    </when></choose>
  </when></choose>
  </when></choose>
</fragment>
