<fragment>
  <!-- graph-obo-assertion-start -->
  <!-- 共通認証とAPI認可で確定した社員Bearerだけを、入口のAuthorization除去前に退避します。 -->
  <set-variable name="gatewayGraphObo" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;method&quot;] == &quot;user&quot;)" />
  <choose>
    <when condition="@((bool)context.Variables[&quot;gatewayGraphObo&quot;])">
      <set-variable name="gatewayGraphAssertion" value="@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;,&quot;&quot;).Substring(7).Trim())" />
      <set-variable name="gatewayAuditSettings" value="@{
        var settings = JObject.Parse((string)context.Variables[&quot;gatewayAuditSettings&quot;]);
        settings[&quot;backendAuthentication&quot;] = &quot;entraObo&quot;;
        return settings.ToString(Newtonsoft.Json.Formatting.None);
      }" />
    </when>
  </choose>
  <!-- graph-obo-assertion-end -->

  <!-- graph-obo-inbound-start -->
  <!-- 登録済みGET /me以外へ社員Bearerを転送しません。Brokerの送信先・OAuth権限も固定です。 -->
  <set-variable name="gatewayGraphOboStatus" value="@(__GRAPH_OBO_REGISTRATION_VALID__ ? 403 : 503)" />
  <set-variable name="gatewayGraphOboClaims" value="" />
  <choose>
    <when condition="@(__GRAPH_OBO_REGISTRATION_VALID__ &amp;&amp; context.Operation.Id == &quot;graph_profile_self&quot; &amp;&amp; context.Operation.UrlTemplate == &quot;/me&quot; &amp;&amp; context.Request.Method == &quot;GET&quot;)">
      <send-request mode="new" response-variable-name="gatewayGraphOboResponse" timeout="15" ignore-error="true">
        <set-url>{{core-credential-broker-url}}/v1/graph/obo</set-url>
        <set-method>POST</set-method>
        <set-header name="X-Core-Broker-Key" exists-action="override"><value>{{core-credential-broker-secret}}</value></set-header>
        <set-header name="X-Core-Caller-Id" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["gatewayDecision"])["callerId"])</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>@(new JObject(new JProperty("assertion", (string)context.Variables["gatewayGraphAssertion"])).ToString(Newtonsoft.Json.Formatting.None))</set-body>
      </send-request>
      <set-variable name="gatewayGraphAssertion" value="" />
      <set-variable name="gatewayGraphOboResult" value="@{
        __GRAPH_OBO_BROKER_RESULT_CSHARP__
      }" />
      <set-variable name="gatewayGraphOboResponse" value="" />
      <set-variable name="gatewayGraphOboStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayGraphOboResult&quot;])[&quot;status&quot;])" />
      <set-variable name="gatewayGraphOboClaims" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayGraphOboResult&quot;])[&quot;claims&quot;] ?? &quot;&quot;)" />
    </when>
  </choose>
  <choose>
    <when condition="@((int)context.Variables[&quot;gatewayGraphOboStatus&quot;] != 200)">
      __GRAPH_OBO_ERROR_XML__
    </when>
  </choose>
  <set-header name="Authorization" exists-action="override"><value>@("Bearer " + (string)JObject.Parse((string)context.Variables["gatewayGraphOboResult"])["accessToken"])</value></set-header>
  <set-variable name="gatewayGraphOboResult" value="" />
  <!-- graph-obo-inbound-end -->

  <!-- graph-obo-outbound-start -->
  <!-- Graphの応答が同じ本人であることを確認し、認証／権限エラーに元の本文を含めません。 -->
  <set-variable name="gatewayGraphOboResult" value="@{
    __GRAPH_OBO_BACKEND_RESULT_CSHARP__
  }" />
  <set-variable name="gatewayGraphOboStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayGraphOboResult&quot;])[&quot;status&quot;])" />
  <set-variable name="gatewayGraphOboClaims" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayGraphOboResult&quot;])[&quot;claims&quot;] ?? &quot;&quot;)" />
  <set-variable name="gatewayGraphRetryAfter" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayGraphOboResult&quot;])[&quot;retryAfter&quot;] ?? &quot;&quot;)" />
  <choose>
    <when condition="@((int)context.Variables[&quot;gatewayGraphOboStatus&quot;] != 200)">
      __GRAPH_OBO_ERROR_XML__
    </when>
  </choose>
  <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
  <!-- graph-obo-outbound-end -->

  <!-- graph-obo-error-start -->
  <set-variable name="gatewayAuditStatus" value="@((int)context.Variables[&quot;gatewayGraphOboStatus&quot;])" />
  <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 503 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
  <set-variable name="gatewayAuditCode" value="@{
    switch ((int)context.Variables[&quot;gatewayAuditStatus&quot;]) {
      case 401: return &quot;GRAPH_REAUTHENTICATION_REQUIRED&quot;;
      case 403: return &quot;GRAPH_ACCESS_DENIED&quot;;
      case 429: return &quot;GRAPH_RATE_LIMITED&quot;;
      default: return &quot;GRAPH_OBO_UNAVAILABLE&quot;;
    }
  }" />
  <include-fragment fragment-id="core-gateway-telemetry" />
  <choose>
    <when condition="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 401)">
      <return-response>
        <set-status code="401" reason="Graph authentication required" />
        <set-header name="WWW-Authenticate" exists-action="override">
          <value>@{
            var claims = (string)context.Variables["gatewayGraphOboClaims"];
            if (String.IsNullOrEmpty(claims)) { return "Bearer error=\"invalid_token\""; }
            var tenant = (string)JObject.Parse((string)context.Variables["gatewayDecision"])["verifiedTenantId"];
            return "Bearer authorization_uri=\"https://login.microsoftonline.com/" + tenant + "/oauth2/v2.0/authorize\", error=\"insufficient_claims\", claims=\"" + claims + "\"";
          }</value>
        </set-header>
        <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        <set-body>{"error":{"code":"GRAPH_REAUTHENTICATION_REQUIRED"}}</set-body>
      </return-response>
    </when>
    <when condition="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 429 &amp;&amp; context.Variables.ContainsKey(&quot;gatewayGraphRetryAfter&quot;) &amp;&amp; !String.IsNullOrEmpty((string)context.Variables[&quot;gatewayGraphRetryAfter&quot;]))">
      <return-response>
        <set-status code="429" reason="Graph rate limit exceeded" />
        <set-header name="Retry-After" exists-action="override"><value>@((string)context.Variables["gatewayGraphRetryAfter"])</value></set-header>
        <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        <set-body>{"error":{"code":"GRAPH_RATE_LIMITED"}}</set-body>
      </return-response>
    </when>
  </choose>
  <return-response>
    <set-status code="@((int)context.Variables[&quot;gatewayAuditStatus&quot;])" reason="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 403 ? &quot;Graph access denied&quot; : (int)context.Variables[&quot;gatewayAuditStatus&quot;] == 429 ? &quot;Graph rate limit exceeded&quot; : &quot;Graph delegated connection unavailable&quot;)" />
    <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (string)context.Variables["gatewayAuditCode"])))).ToString(Newtonsoft.Json.Formatting.None))</set-body>
  </return-response>
  <!-- graph-obo-error-end -->
</fragment>
