<policies>
  <!-- RESTおよびSSEのAPIスコープ。render_apim_portal_policy.pyで操作・転送設定を展開します。 -->
  <inbound>
    <set-variable name="gatewayApiSettingsSource" value="" />
    <include-fragment id="core-api-settings" fragment-id="core-api-settings" />
    <base />
    <include-fragment fragment-id="core-api-request-preparation" />
    <include-fragment fragment-id="core-api-operation-settings" />
    <include-fragment fragment-id="core-api-authentication-result" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;allowed&quot;])">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="AUTHENTICATION_PROCESSING_ERROR" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- このポリシーの貼り付け先、許可Product、登録した操作を照合します。 -->
    <set-variable name="gatewayManualAuthMethod" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;method&quot;])" />
    <set-variable name="gatewayManualRouteAllowed" value="@(false)" />
    <choose>
      <when condition="@(context.Api.Id == &quot;manual-claude-messages&quot; &amp;&amp; context.Product != null &amp;&amp; (((string)context.Variables[&quot;gatewayManualAuthMethod&quot;] == &quot;subscriptionKey&quot; &amp;&amp; context.Product.Id == &quot;manual-model-users&quot;) || ((string)context.Variables[&quot;gatewayManualAuthMethod&quot;] == &quot;user&quot; &amp;&amp; context.Product.Id == &quot;manual-entra-users&quot;)))">
        <choose>
          <when condition="@(context.Operation.Id == &quot;messages&quot; &amp;&amp; context.Request.Method == &quot;POST&quot;)">
            <rewrite-uri template="/anthropic/v1/messages" copy-unmatched-params="true" />
            <set-variable name="gatewayManualRouteAllowed" value="@(true)" />
          </when>
        </choose>
      </when>
    </choose>
    <choose>
      <when condition="@(!(bool)context.Variables[&quot;gatewayManualRouteAllowed&quot;])">
        <set-variable name="gatewayDecision" value="@{ var decision = JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;]); decision[&quot;allowed&quot;] = false; return decision.ToString(Newtonsoft.Json.Formatting.None); }" />
        <set-variable name="gatewayAuditPhase" value="rejected" />
        <set-variable name="gatewayAuditCode" value="AUTHORIZATION_DENIED" />
        <set-variable name="gatewayAuditStatus" value="@(403)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="403" reason="API target is not authorized" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- 文書化した上限の受信バイト数だけを確認します。提供元のJSON契約は提供元が検証します。 -->
    <set-variable name="gatewayOperationConstraint" value="@(JObject.Parse((string)context.Variables[&quot;gatewayOperationSelection&quot;])[&quot;constraint&quot;].ToString(Newtonsoft.Json.Formatting.None))" />
    <include-fragment fragment-id="core-model-limits" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayLimitDecision&quot;])[&quot;allowed&quot;])">
        <set-variable name="gatewayAuditCode" value="@((string)JObject.Parse((string)context.Variables[&quot;gatewayLimitDecision&quot;])[&quot;code&quot;])" />
        <set-variable name="gatewayAuditStatus" value="@((int)JObject.Parse((string)context.Variables[&quot;gatewayLimitDecision&quot;])[&quot;status&quot;])" />
        <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 500 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="@((int)context.Variables[&quot;gatewayAuditStatus&quot;])" reason="@((int)context.Variables[&quot;gatewayAuditStatus&quot;] == 413 ? &quot;Request too large&quot; : &quot;Gateway processing failed&quot;)" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <set-variable name="gatewayRateLimitExempt" value="@(false)" />
    <choose>
      <when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;method&quot;] == &quot;user&quot;)">
        <include-fragment fragment-id="core-entra-user-profile" />
      </when>
    </choose>
    <include-fragment fragment-id="core-rate-limit" />
    <!-- 入口の資格情報を外してから、固定接続先の認証を付けます。 -->
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="{{core-subscription-key-header}}" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="x-api-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Cookie" exists-action="delete" />
    <set-header name="X-Core-L7-Ingress" exists-action="delete" />
    <set-header name="X-Core-Connection-Session" exists-action="delete" />
    <set-header name="X-Core-Connection-Poll" exists-action="delete" />
    <set-header name="X-Core-Connection-Transaction" exists-action="delete" />
    <set-header name="X-Core-Agent-Parent-Id" exists-action="delete" />
    <set-header name="X-Egakumi-Profile" exists-action="delete" />
    <set-query-parameter name="api-key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-query-parameter name="x-api-key" exists-action="delete" />
    <set-backend-service backend-id="core-audit-relay" />
    <authentication-managed-identity resource="{{core-audit-relay-audience}}" ignore-error="false" />
    <set-variable name="gatewayAuditPhase" value="accepted" />
    <set-variable name="gatewayAuditCode" value="GATEWAY_ALLOWED" />
    <set-variable name="gatewayAuditStatus" value="@(0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
  </inbound>
  <backend>
    <forward-request timeout="240" buffer-response="false" />
  </backend>
  <outbound>
    <include-fragment fragment-id="core-backend-audit" />
    <base />
    <set-variable name="gatewayAuditPhase" value="backend-response" />
    <set-variable name="gatewayAuditCode" value="BACKEND_RESPONSE" />
    <set-variable name="gatewayAuditStatus" value="@(context.Response.StatusCode)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
  </outbound>
  <on-error>
    <base />
      <!-- この固定policy IDの上限超過だけを扱います。下流の429や認証エラーを同じ原因にしません。
           PIIのoperationにも埋め込み、親の上限超過がPII用502へ変わることを防ぎます。 -->
      <choose>
        <when condition="@(context.LastError.PolicyId == &quot;core-rate-limit&quot; &amp;&amp; context.LastError.Reason == &quot;RateLimitExceeded&quot;)">
          <set-variable name="gatewayRateSafeRetryAfter" value="@{
            /* 目的：上限超過応答のRetry-Afterへ、標準ポリシーの値または既存の代替値を渡します。 */
            /* 回数枠を読める場合は既存の期間を使い、変数がない場合だけ60秒にします。 */
            var fallback = context.Variables.ContainsKey(&quot;gatewayRateDecision&quot;) ? (int)JObject.Parse((string)context.Variables[&quot;gatewayRateDecision&quot;])[&quot;renewalPeriodSeconds&quot;] : 60;
            var seconds = 0;
            if (context.Variables.ContainsKey(&quot;gatewayRateRetryAfter&quot;) &amp;&amp; Int32.TryParse(Convert.ToString(context.Variables[&quot;gatewayRateRetryAfter&quot;]), out seconds) &amp;&amp; seconds &gt;= 1 &amp;&amp; seconds &lt;= 300) { return seconds.ToString(); }
            return fallback.ToString();
          }" />
          <set-variable name="gatewayAuditPhase" value="rejected" />
          <set-variable name="gatewayAuditCode" value="RATE_LIMIT_EXCEEDED" />
          <set-variable name="gatewayAuditStatus" value="@(429)" />
          <include-fragment fragment-id="core-gateway-telemetry" />
          <!-- 本文なしの固定応答はWebSocketのonHandshakeにも適用できます。生のエラーは返しません。 -->
          <return-response>
            <set-status code="429" reason="Caller request rate exceeded" />
            <set-header name="Retry-After" exists-action="override"><value>@((string)context.Variables[&quot;gatewayRateSafeRetryAfter&quot;])</value></set-header>
            <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
            <set-header name="X-Core-Error-Code" exists-action="override"><value>RATE_LIMIT_EXCEEDED</value></set-header>
            <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          </return-response>
        </when>
      </choose>
    <set-variable name="gatewayAuditPhase" value="policy-error" />
    <set-variable name="gatewayAuditCode" value="POLICY_ERROR" />
    <set-variable name="gatewayAuditStatus" value="@(context.Response != null &amp;&amp; context.Response.StatusCode &gt;= 400 ? context.Response.StatusCode : 0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
  </on-error>
</policies>
