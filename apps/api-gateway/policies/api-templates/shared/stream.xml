<policies>
  <!-- WebSocketの接続開始・外部MCPの転送用テンプレート。 -->
  <inbound>
    <!-- ========== API設定の準備（core-api-settings） ========== -->
    <!-- 目的：共通処理へ、このAPIの監査・制御設定を渡します。 -->
    <!-- 処理：API固有データを共通部品で読み、監査・制御の2変数へ格納します。 -->
    <set-variable name="gatewayApiSettingsSource" value="__API_SETTINGS_BASE64__" />
    <include-fragment id="core-api-settings" fragment-id="core-api-settings" />
    <!-- === -->
    <!-- MCP型だけに、個別PRMの転送を止める固定guardを差し込みます。 -->
    __STREAM_PRE_BASE_XML__
    <!-- === -->
    <!-- ========== 共通ポリシーの適用 ========== -->
    <!-- 目的：共通の入口確認・認証・監査情報の準備を実行します。 -->
    <!-- 処理：上位のInboundを実行します。拒否されなければ、このAPIの後続処理へ戻ります。 -->
    <base />
    <!-- === -->
    <!-- ========== API要求の準備（core-api-request-preparation） ========== -->
    <!-- 目的：共通Inboundから戻った要求を、このAPIの後続処理へ渡せる状態にします。 -->
    <!-- 処理：内部IDの申告ヘッダーを削除し、要求IDをAPIMの値へ揃え、共通認証の完了を確認します。 -->
    <include-fragment id="core-api-request-preparation" fragment-id="core-api-request-preparation" />
    <!-- === -->
    __STREAM_OBSERVE_INBOUND_XML__
    <!-- 動的モデル選択を使うWebSocketは、指定modelまたは既存のdefaultModelを使います。 -->
    <!-- 登録モデル一覧による拒否は行わず、モデルの利用可否は固定接続先の提供元へ任せます。 -->
    <set-variable id="core-protocol-model-selection" name="gatewayProtocolModel" value="@{
      __PROTOCOL_MODEL_SELECTION_CSHARP__
    }" />
    <!-- 目的：共通入口で認証した利用者を、このAPIの操作制約と監査へ引き渡します。 -->
    <!-- 処理：APIMの検証済み購読があればキーの結果、なければBearer認証成功を確認して、共通認証が確認・整形した社員情報をgatewayDecisionへ引き継ぎます。 -->
    <!-- APIの認証方式ラベルは正式設定検査で確定済みです。この引渡しでは、設定の復元とラベルの再確認を行いません。 -->
    <set-variable name="gatewayDecision" value="@{
      __PROTOCOL_AUTHENTICATION_RESULT_CSHARP__
    }" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;allowed&quot;])">
        <!-- 認証後の内部情報の引き渡し不備を、利用者の権限不足と区別して記録します。 -->
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="AUTHENTICATION_PROCESSING_ERROR" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- 共通認可を終えた入口の資格情報を取り除き、下流用の認証を設定します。 -->
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="__KEY_HEADER__" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-query-parameter name="api-key" exists-action="delete" />
    <!-- WebSocket等のquery名と単一値を確認します。固定項目の値は後続のwriterで上書きし、可変modelは先行選択済みの値を使います。 -->
    <set-variable id="core-protocol-query-validation" name="gatewayProtocolQueryAllowed" value="@{
      __PROTOCOL_QUERY_VALIDATION_CSHARP__
    }" />
    <choose>
      <when condition="@(!(bool)context.Variables[&quot;gatewayProtocolQueryAllowed&quot;])">
        <set-variable name="gatewayAuditPhase" value="rejected" />
        <set-variable name="gatewayAuditCode" value="INVALID_PROTOCOL_QUERY" />
        <set-variable name="gatewayAuditStatus" value="@(403)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="403" reason="Protocol target is not authorized" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        </return-response>
      </when>
    </choose>
    __STREAM_HANDSHAKE_QUERY_XML__
    <!-- 拒否時の監査にはクライアントが指定した接続モデルを追加しません。 -->
    <choose><when condition="@(!String.IsNullOrEmpty((string)context.Variables[&quot;gatewayProtocolModel&quot;]))">
      <set-variable name="gatewayAuditSettings" value="@{
      __PROTOCOL_AUDIT_MODEL_SETTING_CSHARP__
    }" />
    </when></choose>
    <include-fragment fragment-id="core-audit-context" />
    __STREAM_HANDSHAKE_SESSION_XML__
    <!-- WSは所有者検査を通した補助観測だけ、MCPは検査した取消/終了だけを免除します。 -->
    __RATE_LIMIT_CLEANUP_XML__
    <choose>
      <when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;method&quot;] == &quot;user&quot;)">
        <include-fragment fragment-id="core-entra-user-profile" />
      </when>
    </choose>
    <include-fragment fragment-id="core-rate-limit" />
    <set-header name="X-Core-L7-Ingress" exists-action="delete" />
    __STREAM_BACKEND_XML__
    <!-- MCPの外部接続先は登録済み固定URIだけを使います。従来SSEのPOSTは、
         サーバーの案内にAPIMが付けるprefixと同じ公開パスだけを認めます。 -->
    __STREAM_ROUTE_XML__
    <!-- CMを使うMCPだけ、接続の利用者確認とtoken設定を差し込みます。
         WebSocketには、対応した専用の下流認証を生成します。 -->
    __CREDENTIAL_CONNECTION_INBOUND_XML__
    <!-- CMの本人セッション証明はGateway内で使い、接続先へ渡しません。 -->
    <set-header name="X-Core-Connection-Session" exists-action="delete" />
    <set-header name="X-Core-Connection-Poll" exists-action="delete" />
    <set-header name="X-Core-Connection-Transaction" exists-action="delete" />
    __BACKEND_HEADERS_XML__
    <set-variable name="gatewayAuditPhase" value="accepted" />
    <set-variable name="gatewayAuditCode" value="GATEWAY_ALLOWED" />
    <set-variable name="gatewayAuditStatus" value="@(0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
  </inbound>
  <!-- このAPIの転送処理です。backendにbaseがないため、上位のforward-requestは継承しません。
       WebSocketはAPIのWSS接続先、外部MCPは登録済みbackendを使うforward-requestを1つ定義します。
       応答ヘッダー待機は240秒、HTTP版は生成時に1を設定し、転送用の要求・応答バッファリングは無効です。 -->
  <backend><forward-request timeout="240" http-version="__HTTP_VERSION__" buffer-request-body="false" buffer-response="false" /></backend>
  <!-- 正常に裏側応答を受け取った後の処理。必要な変換と安全な監査情報だけを追加します。 -->
  <outbound>
    <include-fragment fragment-id="core-backend-audit" />
    <base />
    __STREAM_CREDENTIAL_OUTBOUND_XML__
    <set-variable name="gatewayAuditPhase" value="backend-response" />
    <set-variable name="gatewayAuditCode" value="BACKEND_RESPONSE" />
    <set-variable name="gatewayAuditStatus" value="@(context.Response.StatusCode)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    __STREAM_OBSERVE_OUTBOUND_XML__
  </outbound>
  <!-- 認証・接続・ポリシー実行が例外になった経路。秘密を含む下流の生エラーを監査へ流しません。 -->
  <on-error>
    <!-- この項目の内部owner・期限・チケット処理だけ、安全な500で停止します。 -->
    <!-- 別のPolicyIdは下のbaseへ進み、既存の共通認証・エラー処理を維持します。 -->
    <choose id="core-realtime-owner-error">
      <when condition="@(context.LastError.PolicyId == &quot;core-realtime-owner-context&quot; || context.LastError.PolicyId == &quot;core-realtime-session-settings&quot; || context.LastError.PolicyId == &quot;core-realtime-observer-owner&quot;)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="@(context.LastError.PolicyId == &quot;core-realtime-session-settings&quot; ? &quot;OPERATION_SETTINGS_INVALID&quot; : &quot;AUTHENTICATION_PROCESSING_ERROR&quot;)" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <base />
    __RATE_LIMIT_ERROR_XML__
    <!-- 接続設定を扱う2setterで停止した場合だけ、内部エラーとして記録します。 -->
    <choose id="core-protocol-settings-error">
      <when condition="@(context.LastError.PolicyId == &quot;core-protocol-model-selection&quot; || context.LastError.PolicyId == &quot;core-protocol-query-validation&quot;)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="OPERATION_SETTINGS_INVALID" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        __STREAM_OBSERVE_ERROR_XML__
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <set-variable name="gatewayAuditPhase" value="policy-error" />
    <set-variable name="gatewayAuditCode" value="POLICY_ERROR" />
    <!-- 通信切断などでエラー応答が確定しない場合は0（未確定）を記録します。
         Responseの既定値200を成功と誤記せず、実際の400以上のエラー値だけを残します。 -->
    <set-variable name="gatewayAuditStatus" value="@(context.Response != null &amp;&amp; context.Response.StatusCode &gt;= 400 ? context.Response.StatusCode : 0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    __STREAM_OBSERVE_ERROR_XML__
  </on-error>
</policies>
