<policies>
  <!-- REST操作から生成するMCP表口用テンプレート。 -->
  <inbound>
    <!-- ========== API設定の準備（core-api-settings） ========== -->
    <!-- 目的：共通処理へ、MCP表口の監査と元のREST操作の制御設定を渡します。 -->
    <!-- 処理：API固有データを共通部品で読み、監査・制御の2変数へ格納します。 -->
    <set-variable name="gatewayApiSettingsSource" value="__API_SETTINGS_BASE64__" />
    <include-fragment id="core-api-settings" fragment-id="core-api-settings" />
    <!-- === -->
    <!-- 予約済みの認証メタデータ用パスを、公開toolの操作へ転送しません。 -->
    __MCP_PRM_GUARD_XML__
    <!-- === -->
    <!-- ========== 共通ポリシーの適用 ========== -->
    <!-- 目的：共通の入口確認・認証・監査情報の準備を実行します。 -->
    <!-- 処理：上位のInboundを実行します。拒否されなければ、このAPIの後続処理へ戻ります。 -->
    <base />
    <!-- === -->
    <!-- ========== API要求の準備（core-api-request-preparation） ========== -->
    <!-- 目的：共通Inboundから戻った要求を、このAPIの後続処理へ渡せる状態にします。 -->
    <!-- 処理：内部IDの申告ヘッダーを削除し、要求IDをAPIMの値へ揃え、共通認証の完了を確認します。 -->
    <include-fragment id="core-api-request-preparation" fragment-id="core-api-request-preparation" />
    <!-- === -->
    <!-- 目的：共通入口で認証した利用者を、このAPIの操作制約と監査へ引き渡します。 -->
    <!-- 処理：APIMの検証済み購読があればキーの結果、なければBearer認証成功を確認して、共通認証が確認・整形した社員情報をgatewayDecisionへ引き継ぎます。 -->
    <!-- APIの認証方式ラベルは正式設定検査で確定済みです。この引渡しでは、設定の復元とラベルの再確認を行いません。 -->
    <set-variable name="gatewayDecision" value="@{
      __MCP_GATEWAY_DECISION_CSHARP__
    }" />
    <choose>
      <when condition="@(!(bool)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;allowed&quot;])">
        <!-- 認証後の内部情報の引き渡し不備を、利用者の権限不足と区別して記録します。 -->
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="AUTHENTICATION_PROCESSING_ERROR" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <!-- ========== クエリ概要の観測と記録 ========== -->
    <!-- 目的：生成MCP受付が明示した観測ラベルから、URLクエリの概要を監査へ渡します。 -->
    <!-- 処理：要求準備・API認可の後、tools/callの本文解析前に観測部品を呼び、receivedを記録します。GET・DELETEに本文は不要で、この観測を理由に要求を拒否しません。 -->
    <include-fragment fragment-id="core-query-observation" />
    <set-variable name="gatewayQueryPhase" value="received" />
    <include-fragment fragment-id="core-query-telemetry" />
    <!-- === -->
    <!-- native MCPはRESTの400応答もisError:falseで包むため、引数不正は実行前にJSON-RPCエラーへ確定します。 -->
    <set-variable id="core-mcp-argument-validation" name="gatewayMcpArgumentError" value="@{
      __MCP_PII_ARGUMENTS_CSHARP__
    }" />
    <choose><when condition="@(!String.IsNullOrEmpty((string)context.Variables[&quot;gatewayMcpArgumentError&quot;]))">
      <set-variable name="gatewayAuditPhase" value="rejected" />
      <set-variable name="gatewayAuditCode" value="INVALID_MCP_TOOL_ARGUMENTS" />
      <set-variable name="gatewayAuditStatus" value="@(400)" />
      <include-fragment fragment-id="core-gateway-telemetry" />
      <return-response><set-status code="400" reason="Invalid tool arguments" />
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-body>@((string)context.Variables["gatewayMcpArgumentError"])</set-body>
      </return-response>
    </when></choose>
    <include-fragment fragment-id="core-audit-context" />
    <!-- REST-backed MCPのtool実処理は参照先RESTで1回数えます。ここで同じcounterを二重加算しません。 -->
    <set-variable name="gatewayAuditPhase" value="accepted" />
    <set-variable name="gatewayAuditCode" value="GATEWAY_ALLOWED" />
    <set-variable name="gatewayAuditStatus" value="@(0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    <!-- キー要求の任意Authorizationを削除し、Bearerは参照先RESTの再検証へ引き継ぎます。 -->
    <choose><when condition="@((string)JObject.Parse((string)context.Variables[&quot;gatewayDecision&quot;])[&quot;method&quot;] == &quot;subscriptionKey&quot;)"><set-header name="Authorization" exists-action="delete" /></when></choose>
    <!-- 登録済みのREST操作へ購読キー等の要求ヘッダーを引き継ぎます。
         MCP/SSEの応答本文は読み取らず、そのまま転送します。 -->
  </inbound>
  <!-- 登録済みのREST操作を参照する、APIM生成MCPの転送処理です。
       backendにbaseがないため、上位のforward-requestを継承せず、ここで1つ定義します。
       応答ヘッダー待機は240秒、転送時の応答バッファリングは無効です。HTTP版と要求バッファリングはAPIMの既定値です。 -->
  <backend><forward-request timeout="240" buffer-response="false" /></backend>
  <!-- 正常に裏側応答を受け取った後の処理。必要な変換と安全な監査情報だけを追加します。 -->
  <outbound>
    <include-fragment fragment-id="core-backend-audit" />
    <base />
    <set-variable name="gatewayAuditPhase" value="backend-response" />
    <set-variable name="gatewayAuditCode" value="BACKEND_RESPONSE" />
    <set-variable name="gatewayAuditStatus" value="@(context.Response.StatusCode)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    <set-variable name="gatewayQueryPhase" value="backend-response" />
    <include-fragment fragment-id="core-query-telemetry" />
  </outbound>
  <!-- 認証・接続・ポリシー実行が例外になった経路。秘密を含む下流の生エラーを監査へ流しません。 -->
  <on-error>
    <base />
    __RATE_LIMIT_ERROR_XML__
    <!-- この入力検査の内部設定読取りで停止した場合だけ、固定500へ分けます。 -->
    <choose id="core-mcp-argument-validation-error">
      <when condition="@(context.LastError.PolicyId == &quot;core-mcp-argument-validation&quot;)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="OPERATION_SETTINGS_INVALID" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <set-variable name="gatewayQueryPhase" value="policy-error" />
        <include-fragment fragment-id="core-query-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <set-variable name="gatewayAuditPhase" value="policy-error" />
    <set-variable name="gatewayAuditCode" value="POLICY_ERROR" />
    <!-- 通信切断などでエラー応答が確定しない場合は0（未確定）を記録します。
         Responseの既定値200を成功と誤記せず、実際の400以上のエラー値だけを残します。 -->
    <set-variable name="gatewayAuditStatus" value="@(context.Response != null &amp;&amp; context.Response.StatusCode &gt;= 400 ? context.Response.StatusCode : 0)" />
    <include-fragment fragment-id="core-gateway-telemetry" />
    <set-variable name="gatewayQueryPhase" value="policy-error" />
    <include-fragment fragment-id="core-query-telemetry" />
  </on-error>
</policies>
