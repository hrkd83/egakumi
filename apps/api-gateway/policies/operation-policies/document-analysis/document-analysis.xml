<policies>
  <!-- 原本とNative JSONの本文を変換せず一度だけ転送します。課金POSTを再送せず、受付後は所有者に束縛した状態確認へ移ります。 -->
  <inbound>
    <!-- ========== 共通ポリシーの適用 ========== -->
    <!-- 目的：共通認証とAPI側の入力設定確認・利用回数制限・下流認証を実行します。 -->
    <!-- 処理：上位のInboundを実行し、確認済みのdocumentModelを使う転送準備へ戻ります。 -->
    <base />
    <!-- === -->
    <!-- ========== Document解析の転送準備 ========== -->
    <!-- 目的：解析要求を固定の提供元URIへ渡し、受付後の所有者付き状態確認へつなぎます。 -->
    <!-- 処理：modelをURLの一要素へ符号化し、追加クエリを標準のURI書換えで転送します。本文は変換しません。 -->
    <!-- 登録済みの接続先から生成し、受付URLの照合と、チケットを接続先・API・本人へ結び付ける処理に使います。 -->
    <set-variable name="documentBaseUrl" value="__DOCUMENT_BASE_URL__" />
    <!-- modelはパスへ使ったためクエリから除き、その他の追加クエリは提供元へ渡します。 -->
    <set-query-parameter name="model" exists-action="delete" />
    <rewrite-uri template="@(&quot;/documentintelligence/documentModels/&quot; + Uri.EscapeDataString((string)context.Variables[&quot;documentModel&quot;]) + &quot;:analyze&quot;)" copy-unmatched-params="true" />
    <!-- API版は公開スキーマと同じ操作設定から生成し、受付URLの確認にも使います。 -->
    <set-query-parameter name="api-version" exists-action="override"><value>__DOCUMENT_API_VERSION__</value></set-query-parameter>
    <!-- 文字位置の単位は指定値を転送し、未指定の場合だけ従来の既定値を補います。適否は提供元が判定します。 -->
    <set-query-parameter name="stringIndexType" exists-action="skip"><value>unicodeCodePoint</value></set-query-parameter>
    <!-- 新規解析では既存の結果取得用チケットを使わず、削除して続行します。受付後に新しいチケットを発行します。 -->
    <set-header name="X-Core-Document-Ticket" exists-action="delete" />
    <!-- === -->
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-variable name="documentOperationId" value="@{
      __DOCUMENT_ANALYSIS_OPERATION_ID_CSHARP__
    }" />
    <set-variable name="documentAccepted" value="@{
      __DOCUMENT_ANALYSIS_ACCEPTED_CSHARP__
    }" />
    <set-variable name="documentStatus" value="@{
      __DOCUMENT_ANALYSIS_STATUS_CSHARP__
    }" />
    <!-- 共通処理は提供元の応答を記録済みです。捕捉した内部認証情報の不備を、応答前に原因と500で記録します。 -->
    <choose id="document-authentication-processing-error">
      <when condition="@((int)context.Variables[&quot;documentStatus&quot;] == 500)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="AUTHENTICATION_PROCESSING_ERROR" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
      </when>
    </choose>
    <set-variable name="documentRetryAfter" value="@{
      __DOCUMENT_ANALYSIS_RETRY_AFTER_CSHARP__
    }" />
    <set-variable name="documentPublicResponse" value="@{
      var status = (int)context.Variables[&quot;documentStatus&quot;];
      if (status == 202) {
        return (string)context.Variables[&quot;documentAccepted&quot;];
      }
      var code = status == 413 ? &quot;DocumentInputTooLarge&quot; : status == 429 ? &quot;DocumentAnalysisThrottled&quot; : status == 422 ? &quot;DocumentRejected&quot; : &quot;DocumentAnalysisUnavailable&quot;;
      return new JObject(new JProperty(&quot;error&quot;, new JObject(new JProperty(&quot;code&quot;, code))), new JProperty(&quot;requestId&quot;, context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None);
    }" />
    <return-response>
      <set-status code="@((int)context.Variables[&quot;documentStatus&quot;])" reason="@((int)context.Variables[&quot;documentStatus&quot;] == 500 ? &quot;Document analysis unavailable&quot; : &quot;Document analysis acceptance&quot;)" />
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
      <set-header name="Retry-After" exists-action="override"><value>@(((int)context.Variables["documentRetryAfter"]).ToString())</value></set-header>
      <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
      <set-body>@((string)context.Variables["documentPublicResponse"])</set-body>
    </return-response>
  </outbound>
  <on-error>
    <!-- 共通Entraトークン検証の失敗だけ、専用エラー処理より先に認証拒否の監査と401へ渡します。 -->
    __OPERATION_ENTRA_AUTHENTICATION_ERROR_XML__
    __RATE_LIMIT_ERROR_XML__
    __AUDIT_BODY_MODEL_ERROR_XML__
    <set-variable name="documentPolicyErrorStatus" value="@(context.LastError.Source == &quot;authorization&quot; &amp;&amp; (context.LastError.Reason == &quot;SubscriptionKeyNotFound&quot; || context.LastError.Reason == &quot;SubscriptionKeyInvalid&quot;) ? 401 : context.LastError.Reason == &quot;Timeout&quot; ? 504 : 502)" />
    <return-response><set-status code="@((int)context.Variables[&quot;documentPolicyErrorStatus&quot;])" reason="Document analysis unavailable" /><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (int)context.Variables["documentPolicyErrorStatus"] == 401 ? "AuthenticationRequired" : "DocumentAnalysisUnavailable"))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body></return-response>
  </on-error>
</policies>
