<policies>
  <!-- 署名・検証済み所有者・API・接続先・モデル・ジョブ・期限を照合してから、固定の提供元GETへ転送します。 -->
  <inbound>
    <!-- ========== 共通ポリシーの適用 ========== -->
    <!-- 目的：共通認証とAPI側の利用枠・下流接続準備を継承します。 -->
    <!-- 処理：上位のInboundを実行してから、この操作の所有者チケット照合へ進みます。 -->
    <base />
    <!-- === -->
    <!-- ========== Document解析結果の所有者確認 ========== -->
    <!-- 目的：署名チケットの本人・モデル・ジョブ・期限を確認し、固定提供元の結果を照会します。 -->
    <!-- 処理：モデル一覧は再確認せず、署名済みのmodelをURLの一要素へ符号化します。 -->
    <!-- 開始操作と同じ登録済み接続先から生成し、チケットの接続先・API・本人の組合せを照合します。 -->
    <set-variable name="documentBaseUrl" value="__DOCUMENT_BASE_URL__" />
    <set-variable name="documentOwner" value="@{
      __DOCUMENT_ANALYSIS_STATUS_OWNER_CSHARP__
    }" />
    <set-variable name="documentOwnerStatus" value="@{
      __DOCUMENT_ANALYSIS_STATUS_OWNER_STATUS_CSHARP__
    }" />
    <!-- チケット確認後の拒否・期限切れ・内部処理の不備を、最終応答の状態と理由で記録します。 -->
    <!-- 共通APIの受付記録とは要求IDで照合し、このブロックでは応答直前に監査を1回出力します。 -->
    <choose id="document-operation-rejection">
      <when condition="@((int)context.Variables[&quot;documentOwnerStatus&quot;] != 200)">
        <set-variable name="gatewayAuditPhase" value="@((int)context.Variables[&quot;documentOwnerStatus&quot;] == 500 ? &quot;policy-error&quot; : &quot;rejected&quot;)" />
        <set-variable name="gatewayAuditCode" value="@((int)context.Variables[&quot;documentOwnerStatus&quot;] == 500 ? &quot;AUTHENTICATION_PROCESSING_ERROR&quot; : (int)context.Variables[&quot;documentOwnerStatus&quot;] == 410 ? &quot;DOCUMENT_OPERATION_EXPIRED&quot; : &quot;DOCUMENT_OPERATION_DENIED&quot;)" />
        <set-variable name="gatewayAuditStatus" value="@((int)context.Variables[&quot;documentOwnerStatus&quot;])" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response><set-status code="@((int)context.Variables[&quot;documentOwnerStatus&quot;])" reason="@((int)context.Variables[&quot;documentOwnerStatus&quot;] == 500 ? &quot;Document analysis unavailable&quot; : &quot;Document operation access denied&quot;)" /><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (int)context.Variables["documentOwnerStatus"] == 500 ? "DocumentAnalysisUnavailable" : (int)context.Variables["documentOwnerStatus"] == 410 ? "DocumentOperationExpired" : "DocumentOperationDenied"))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body></return-response>
      </when>
    </choose>
    <!-- 確認済みのチケットからジョブIDとモデル名を引き継ぎ、固定URIの作成と提供元の結果照合に使います。 -->
    <set-variable name="documentOperationId" value="@((string)JObject.Parse((string)context.Variables[&quot;documentOwner&quot;])[&quot;operationId&quot;])" />
    <set-variable name="documentModel" value="@((string)JObject.Parse((string)context.Variables[&quot;documentOwner&quot;])[&quot;model&quot;])" />
    <!-- 公開スキーマの対応版を操作設定から生成し、結果JSONの版確認と揃えます。 -->
    <!-- 対応版の結果取得GETはapi-versionだけを使います。チケットと操作IDで確定したジョブを照会し、未使用の追加クエリはコピーしません。 -->
    <rewrite-uri template="@(&quot;/documentintelligence/documentModels/&quot; + Uri.EscapeDataString((string)context.Variables[&quot;documentModel&quot;]) + &quot;/analyzeResults/&quot; + (string)context.Variables[&quot;documentOperationId&quot;] + &quot;?api-version=__DOCUMENT_API_VERSION__&quot;)" copy-unmatched-params="false" />
    <!-- Gateway用チケットは確認に使い終えたため、提供元へ送信する前に削除します。 -->
    <set-header name="X-Core-Document-Ticket" exists-action="delete" />
    <!-- 提供元の結果取得GETは本文を使いません。本文がある場合だけ空にし、本文なしGETへの置換は行いません。 -->
    <choose id="document-status-body-clear">
      <when condition="@(context.Request.Body != null)">
        <set-body>@("")</set-body>
      </when>
    </choose>
    <!-- === -->
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-variable name="documentPollEvaluation" value="@{
      __DOCUMENT_ANALYSIS_STATUS_POLL_EVALUATION_CSHARP__
    }" />
    <!-- 共通処理は提供元の応答を記録済みです。捕捉した内部設定の不備は、応答前に原因と500を別途記録します。 -->
    <choose id="document-settings-read-error">
      <when condition="@((int)JObject.Parse((string)context.Variables[&quot;documentPollEvaluation&quot;])[&quot;status&quot;] == 500)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="OPERATION_SETTINGS_INVALID" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
      </when>
    </choose>
    <set-variable name="documentPublicResponse" value="@((string)JObject.Parse((string)context.Variables[&quot;documentPollEvaluation&quot;])[&quot;result&quot;])" />
    <return-response>
      <set-status code="@((int)JObject.Parse((string)context.Variables[&quot;documentPollEvaluation&quot;])[&quot;status&quot;])" reason="Document analysis status" />
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
      <set-header name="Retry-After" exists-action="override"><value>@((string)JObject.Parse((string)context.Variables["documentPollEvaluation"])["retryAfter"])</value></set-header>
      <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
      <set-body>@((string)context.Variables["documentPublicResponse"])</set-body>
    </return-response>
  </outbound>
  <on-error>
    <!-- 共通Entraトークン検証の失敗だけ、専用エラー処理より先に認証拒否の監査と401へ渡します。 -->
    __OPERATION_ENTRA_AUTHENTICATION_ERROR_XML__
    __RATE_LIMIT_ERROR_XML__
    __AUDIT_BODY_MODEL_ERROR_XML__
    <set-variable name="documentPolicyErrorStatus" value="@(context.LastError.Source == &quot;authorization&quot; &amp;&amp; (context.LastError.Reason == &quot;SubscriptionKeyNotFound&quot; || context.LastError.Reason == &quot;SubscriptionKeyInvalid&quot;) ? 401 : context.LastError.Reason == &quot;Timeout&quot; ? 504 : 502)" />
    <return-response><set-status code="@((int)context.Variables[&quot;documentPolicyErrorStatus&quot;])" reason="Document analysis unavailable" /><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", (int)context.Variables["documentPolicyErrorStatus"] == 401 ? "AuthenticationRequired" : "DocumentAnalysisUnavailable"))), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body></return-response>
  </on-error>
</policies>
