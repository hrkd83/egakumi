<policies>
  <!--
    WebRTC の開始時に使う制御 REST API です。固定のモデル設定で短期 token を取得し、SDP offer を Foundry へ送ります。
    音声等の WebRTC メディア自体はこの HTTP ポリシーを流れません。APIM が受け持つのは開始・所有者管理等の制御です。
    正常応答から call ID を検査し、呼出元と契約に結び付く有効期限付き署名チケットを返します。署名鍵自体は返しません。
  -->
  <inbound>
    <base />
    <!-- 通話の作成・終了より前に、確認済みownerと期限設定を一度受け取ります。 -->
    __REALTIME_OWNER_CONTEXT_XML__
    <!-- 本文が許容される SDP offer かを確認します。URL や任意のモデル設定を入力から追加しません。 -->
    <set-variable name="realtimeSdp" value="@{
      __REALTIME_CREATE_SDP_CSHARP__
    }" />
    <choose>
      <when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;realtimeSdp&quot;]))">
        <return-response><set-status code="400" reason="Invalid session offer" /><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-body>{"error":{"code":"InvalidSessionOffer"}}</set-body></return-response>
      </when>
    </choose>
    <!--
      Azure WebRTC の公式手順に合わせ、Entra token は短期 token の取得にだけ使います。
      送信先は Bicep が登録済み backend URL から確定する固定値です。利用者の URL・header はコピーしません。
      https://learn.microsoft.com/azure/foundry/openai/how-to/realtime-audio-webrtc
    -->
    <send-request mode="new" response-variable-name="realtimeSecretResponse" timeout="20" ignore-error="true">
      <set-url>__REALTIME_CLIENT_SECRETS_URL__</set-url>
      <set-method>POST</set-method>
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="Accept" exists-action="override"><value>application/json</value></set-header>
      <set-body>@{
      __REALTIME_CREATE_CLIENT_SECRETS_REQUEST_CSHARP__
    }</set-body>
      <authentication-managed-identity resource="https://ai.azure.com" ignore-error="true" />
    </send-request>
    <!-- 短期 token はこの要求のメモリー内だけで扱います。本文・任意の下流エラーを応答や監査へ出しません。 -->
    <set-variable name="realtimeEphemeralToken" value="@{
      __REALTIME_CREATE_EPHEMERAL_TOKEN_CSHARP__
    }" />
    <choose>
      <when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;realtimeEphemeralToken&quot;]))">
        <set-variable name="gatewayAuditPhase" value="rejected" />
        <set-variable name="gatewayAuditCode" value="REALTIME_TOKEN_ACQUISITION_FAILED" />
        <set-variable name="gatewayAuditStatus" value="@(502)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response><set-status code="502" reason="Realtime session preparation failed" /><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>{"error":{"code":"RealtimeTokenAcquisitionFailed"}}</set-body></return-response>
      </when>
    </choose>
    <!-- 短期 token で raw SDP を送信します。token をブラウザー・永続ストアへ渡しません。 -->
    <set-method>POST</set-method>
    <rewrite-uri template="/realtime/calls" copy-unmatched-params="false" />
    <set-header name="Authorization" exists-action="override"><value>@("Bearer " + (string)context.Variables["realtimeEphemeralToken"])</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/sdp</value></set-header>
    <set-header name="Accept" exists-action="override"><value>application/sdp</value></set-header>
    <set-header name="X-Core-Call-Ticket" exists-action="delete" />
    <set-body>@((string)context.Variables["realtimeSdp"])</set-body>
  </inbound>
  <!-- 裏側への転送段階。親の転送方針や HTTP 版を引き継ぎ、上で許可した要求だけを送ります。 -->
  <backend><base /></backend>
  <!-- 正常に裏側応答を受け取った後の処理。必要な変換と安全な監査情報だけを追加します。 -->
  <outbound>
    <choose>
      <when condition="@(context.Response.StatusCode == 201)">
        <!-- 成功応答の Location を許可した形式で解析し、別ホストや任意パスを利用者へ案内しないようにします。 -->
        <set-variable name="realtimeCallId" value="@{
      __REALTIME_CREATE_CALL_ID_CSHARP__
    }" />
        <choose>
          <!-- 201でも契約に合う応答かは別に検査します。原因の固定コードだけを記録し、LocationやSDPを監査へ出しません。 -->
          <when condition="@(String.IsNullOrEmpty((string)context.Variables[&quot;realtimeCallId&quot;]))">
            <set-variable name="gatewayAuditPhase" value="rejected" />
            <set-variable name="gatewayAuditCode" value="REALTIME_CALL_LOCATION_INVALID" />
            <set-variable name="gatewayAuditStatus" value="@(502)" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <return-response><set-status code="502" reason="Invalid session response" /><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header><set-body>{"error":{"code":"RealtimeCallLocationInvalid"}}</set-body></return-response>
          </when>
        </choose>
        <!-- HMAC 署名付きの所有者チケットを作成。チケットには call ID・検証済み購読ID・呼出元・期限を入れ、鍵は含めません。 -->
        <!-- 入口で受け取ったownerを使い、本人認証をやり直しません。内部不成立は専用on-errorが500で停止します。 -->
        <set-variable id="core-realtime-ticket-generation" name="realtimeCallTicket" value="@{
            __REALTIME_CREATE_TICKET_CSHARP__
          }" />
        <!--
          Azure の公式例は response.text() から SDP を取り出します。実機201の MIME 不一致を受け、
          text/plain も候補にしますが、まだ実機未確認の仮説です。MIME だけで成功にはしません。
          https://learn.microsoft.com/azure/foundry/openai/how-to/realtime-audio-webrtc
          先にMIMEを固定分類し、許可した2種類だけをメモリー内でサイズ・必須行まで検査します。
          SDP は接続情報を含むため、本文や不正な値を監査へ転記せず、固定の判定コードだけ返します。
          これは完全なSDP規格検証ではありません。ブラウザーでのSDP適用・ICE・音声往復も別途必要です。
        -->
        <set-variable name="realtimeAnswerStatus" value="@{
      __REALTIME_CREATE_ANSWER_STATUS_CSHARP__
    }" />
        <choose>
          <when condition="@((string)context.Variables[&quot;realtimeAnswerStatus&quot;] != &quot;VALID&quot;)">
            <!-- 201の後は通話が存在します。SDPを返せない場合も、固定backendへ終了を要求します。
                 Locationのhostや利用者URL、短期tokenを流用せず、通常hangupと同じAPIM MIを使います。 -->
            <send-request mode="new" response-variable-name="realtimeCleanupResponse" timeout="10" ignore-error="true">
              <set-url>@{
                var endpoint = "__REALTIME_CLIENT_SECRETS_URL__";
                return endpoint.Substring(0, endpoint.Length - "/client_secrets".Length)
                    + "/calls/" + (string)context.Variables["realtimeCallId"] + "/hangup";
              }</set-url>
              <set-method>POST</set-method>
              <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
              <set-body>{}</set-body>
              <authentication-managed-identity resource="https://cognitiveservices.azure.com" ignore-error="true" />
            </send-request>
            <!-- timeoutも未確認として扱い、本文・call ID・ticketを通常監査へ記録しません。 -->
            <set-variable name="realtimeCleanupAccepted" value="@{
              var response = context.Variables.ContainsKey(&quot;realtimeCleanupResponse&quot;)
                  ? context.Variables[&quot;realtimeCleanupResponse&quot;] as IResponse : null;
              return response != null &amp;&amp; response.StatusCode &gt;= 200 &amp;&amp; response.StatusCode &lt; 300;
            }" />
            <set-variable name="gatewayAuditPhase" value="backend-response" />
            <set-variable name="gatewayAuditCode" value="@((bool)context.Variables[&quot;realtimeCleanupAccepted&quot;] ? &quot;REALTIME_CALL_CLEANUP_ACCEPTED&quot; : &quot;REALTIME_CALL_CLEANUP_UNCONFIRMED&quot;)" />
            <set-variable name="gatewayAuditStatus" value="@((bool)context.Variables[&quot;realtimeCleanupAccepted&quot;] ? 200 : 502)" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <set-variable name="gatewayAuditPhase" value="rejected" />
            <set-variable name="gatewayAuditCode" value="@((string)context.Variables[&quot;realtimeAnswerStatus&quot;])" />
            <set-variable name="gatewayAuditStatus" value="@(502)" />
            <include-fragment fragment-id="core-gateway-telemetry" />
            <return-response><set-status code="502" reason="Invalid session response" /><set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header><set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
              <!-- 終了未確認の場合だけ、BFF内に保持する復旧情報を同じ所有者へ返します。
                   Consoleは実ID/ticketを画面・exportへ渡さず、一時参照で再終了します。 -->
              <set-header name="X-Core-Cleanup-Status" exists-action="override"><value>@((bool)context.Variables["realtimeCleanupAccepted"] ? "accepted" : "unconfirmed")</value></set-header>
              <set-header name="X-Core-Call-Id" exists-action="override"><value>@((bool)context.Variables["realtimeCleanupAccepted"] ? "" : (string)context.Variables["realtimeCallId"])</value></set-header>
              <set-header name="X-Core-Call-Ticket" exists-action="override"><value>@((bool)context.Variables["realtimeCleanupAccepted"] ? "" : (string)context.Variables["realtimeCallTicket"])</value></set-header>
              <set-body>@{
                var code = (string)context.Variables["realtimeAnswerStatus"];
                var cleanup = (bool)context.Variables["realtimeCleanupAccepted"] ? "accepted" : "unconfirmed";
                return new Newtonsoft.Json.Linq.JObject(new Newtonsoft.Json.Linq.JProperty("error", new Newtonsoft.Json.Linq.JObject(
                    new Newtonsoft.Json.Linq.JProperty("code", code), new Newtonsoft.Json.Linq.JProperty("cleanupStatus", cleanup)))).ToString(Newtonsoft.Json.Formatting.None);
            }</set-body></return-response>
          </when>
        </choose>
        <!-- 検査済みの本文だけを、公開側の一貫した SDP media type で返します。 -->
        <set-header name="Content-Type" exists-action="override"><value>application/sdp</value></set-header>
        <set-header name="X-Core-Call-Id" exists-action="override"><value>@((string)context.Variables["realtimeCallId"])</value></set-header>
        <set-header name="X-Core-Call-Ticket" exists-action="override"><value>@((string)context.Variables["realtimeCallTicket"])</value></set-header>
        <set-header name="Location" exists-action="override"><value>@{
            var settings = Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables["gatewayOperationConstraint"]);
            return (string)settings["publicCallPath"] + "/" + (string)context.Variables["realtimeCallId"];
        }</value></set-header>
      </when>
    </choose>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <base />
  </outbound>
  <!-- 認証・接続・ポリシー実行が例外になった経路。秘密を含む下流の生エラーを監査へ流しません。 -->
  <on-error>
    <!-- この項目の内部owner・期限・チケット処理だけ、安全な500で停止します。 -->
    <!-- 別のPolicyIdは下のbaseへ進み、既存の共通認証・エラー処理を維持します。 -->
    <choose id="core-realtime-owner-error">
      <when condition="@(context.LastError.PolicyId == &quot;core-realtime-owner-context&quot; || context.LastError.PolicyId == &quot;core-realtime-session-settings&quot; || context.LastError.PolicyId == &quot;core-realtime-ticket-generation&quot;)">
        <set-variable name="gatewayAuditPhase" value="policy-error" />
        <set-variable name="gatewayAuditCode" value="@(context.LastError.PolicyId == &quot;core-realtime-session-settings&quot; ? &quot;OPERATION_SETTINGS_INVALID&quot; : &quot;AUTHENTICATION_PROCESSING_ERROR&quot;)" />
        <set-variable name="gatewayAuditStatus" value="@(500)" />
        <include-fragment fragment-id="core-gateway-telemetry" />
        <return-response>
          <set-status code="500" reason="Gateway processing failed" />
          <set-header name="apim-request-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
        </return-response>
      </when>
    </choose>
    <base />
  </on-error>
</policies>
