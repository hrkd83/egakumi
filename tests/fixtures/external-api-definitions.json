      "grpc": {
        "definition": "syntax = \"proto3\";\npackage wf.sample.v1;\n\nmessage ProbeRequest { string text = 1; int32 count = 2; }\nmessage ProbeReply { string text = 1; int32 sequence = 2; }\n\nservice Probe {\n  rpc Echo(ProbeRequest) returns (ProbeReply);\n  rpc ServerStream(ProbeRequest) returns (stream ProbeReply);\n  rpc ClientStream(stream ProbeRequest) returns (ProbeReply);\n  rpc Bidi(stream ProbeRequest) returns (stream ProbeReply);\n}\n"
      },
      "backendUrl": "__TOOLS_GRPC_BACKEND__",
      "serviceClass": "sample"
