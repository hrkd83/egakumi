        {
          "name": "a2a-card",
          "displayName": "A2A Card",
          "method": "GET",
          "urlTemplate": "/.well-known/agent-card.json",
          "templateParameters": [],
          "staticResponse": {
            "contentType": "application/json",
            "body": {
              "protocolVersion": "0.3.0",
              "name": "Synthetic A2A probe",
              "description": "External sample; synthetic tasks only",
              "version": "1.0.0",
              "url": "https://__PUBLIC_HOST_NAME__/agents/sample/a2a/v1/a2a",
              "preferredTransport": "JSONRPC",
              "capabilities": {
                "streaming": true,
                "pushNotifications": false
              },
              "defaultInputModes": [
                "text/plain"
              ],
              "defaultOutputModes": [
                "text/plain"
              ],
              "securitySchemes": {
                "bearer": {
                  "type": "http",
                  "scheme": "bearer",
                  "bearerFormat": "JWT"
                }
              },
              "security": [
                {
                  "bearer": []
                }
              ],
              "skills": [
                {
                  "id": "synthetic-echo",
                  "name": "Synthetic echo",
                  "description": "Echo synthetic text",
                  "tags": [
                    "sample",
                    "network",
                    "a2a"
                  ]
                }
              ]
            }
          }
        }
      ],
      "keySubscriptions": [],
      "authorization": {
        "mode": "subscriptionKey",
        "operationConstraints": {
          "a2a-rpc": {
            "kind": "a2aJsonRpc",
            "maxRequestBytes": 65536,
            "bodyFormat": "json",
