    }
  },
  "location": "japaneast",
  "foundryLocation": "eastus2",
  "apiCenterLocation": "eastus",
  "tags": {
    "purpose": "egakumi-platform"
  },
  "portal": {
    "publicHostName": "portal.example.com"
  },
  "portalApiKeys": {
    "groupNamePattern": ""
  }
