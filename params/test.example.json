{
  "$schema": "../schemas/params.schema.json",
  "$comment": "公開の入力テンプレートです。GUID・DNS・CIDR・連絡先は実環境から独立した架空例で、prepare_local_environment.pyでチェックアウト直下.local/<environment>/params.local.jsonへ展開し、導入先の値を保護領域で設定します。services.apimInstanceIdの<AUTO_GENERATED_APIM_INSTANCE_ID>は初回自動生成を示すマーカーです。初回prepareが6文字の英小文字・数字IDへ置換して保存し、通常の更新では保存済みIDを保持します。未解決マーカーは実入力として使えません。azureTenantIdはAzure構築先、entraTenantIdはCM OAuth・社員API認証・任意の独立接続窓口アプリの認証先です。credentialProviders.graphDelegatedには準備したGraph接続用アプリのClient IDと保護されたclient secretファイル参照を設定します。共通表示名・scope・pool・本人接続セッション設定はconfigから読みます。gateway.authentication.entra.audienceはegakumi-apiのClient IDへ置き換えます。購読キーヘッダーapi-keyと委任scope Gateway.Invokeは資材で固定します。Portal配備の初回にはportalApiKeys.platformGroupIdへ管理グループObject ID、portalApiKeys.groupNamePatternへグループ名正規表現を明示し、表示名はGraphから取得します。承認製品は標準API正本、検証用購読数上限はconfig.portalApiKeys.verificationMaxSubscriptionsから決まります。秘密値はこのファイルに書かず保護された参照先へ非表示で入力します。",
  "schemaVersion": 1,
  "configFile": "../config/test.json",
  "productName": "egakumi",
  "environmentName": "test",
  "subscriptionId": "00000000-0000-0000-0000-000000000000",
  "azureTenantId": "00000000-0000-0000-0000-000000000000",
  "entraTenantId": "00000000-0000-0000-0000-000000000000",
  "network": {
    "addressSpaces": [
      "10.40.0.0/24",
      "10.40.1.0/24",
      "10.40.2.0/24",
      "10.40.3.0/24"
    ],
    "subnetPrefixes": {
      "agw": "10.40.0.0/24",
      "pep": "10.40.1.0/24",
      "firewall": "10.40.2.0/26",
      "apim": "10.40.2.64/26",
      "management": "10.40.2.128/26",
      "aca": "10.40.2.192/26",
      "certificate": "10.40.3.0/27"
    }
  },
  "services": {
    "publisherName": "Example Corporation",
    "publisherEmail": "replace-with-your-email@example.com",
    "apimInstanceId": "<AUTO_GENERATED_APIM_INSTANCE_ID>"
  },
  "gateway": {
    "publicHostName": "gateway.example.com",
    "authentication": {
