{
  "$schema": "./params.schema.json",
  "$comment": "公開の入力テンプレートです。GUID・DNS・CIDR・連絡先は実環境から独立した架空例で、prepare_local_environment.pyでチェックアウト直下.local/<environment>/params.local.jsonへ展開し、導入先の値を保護領域で設定します。services.apimInstanceIdの<AUTO_GENERATED_APIM_INSTANCE_ID>は初回自動生成を示すマーカーです。初回prepareが6文字の英小文字・数字IDへ置換して保存し、通常の更新では保存済みIDを保持します。未解決マーカーは実入力として使えません。azureTenantIdはAzure構築先、entraTenantIdは基盤用Entraアプリの認証先です。API・Tools・Credentialには相異なるClient IDを指定し、Core構築後にPortalのClient IDを追加します。credentialProviders.graphDelegatedにはToolsのClient IDと保護secretファイル参照、gateway.authentication.credentialLogin.identityにはCredentialのClient IDと別の保護secretファイル参照を設定します。共通表示名・scope・pool・本人接続セッション設定はconfigから読みます。gateway.authentication.entra.audienceはegakumi-apiのClient IDへ置き換えます。購読キーヘッダーapi-keyと委任scope Gateway.Invokeは資材で固定します。firewallTlsInspectionは準備済みの専用ID・中間CAのバージョン参照・ルートCAファイルで置き換えます。秘密値はこのファイルに書かず保護された参照先へ非表示で入力します。",
  "schemaVersion": 1,
  "configFile": "../infra/config/test.json",
  "productName": "egakumi",
  "environmentName": "test",
  "subscriptionId": "00000000-0000-0000-0000-000000000000",
  "azureTenantId": "00000000-0000-0000-0000-000000000000",
  "entraTenantId": "00000000-0000-0000-0000-000000000000",
  "network": {
    "addressSpaces": [
      "10.40.0.0/24",
      "10.40.1.0/24",
      "10.40.2.0/24",
      "10.40.3.0/24",
      "10.40.4.0/24"
    ],
    "subnetPrefixes": {
      "agw": "10.40.0.0/24",
      "pep": "10.40.1.0/24",
      "firewall": "10.40.2.0/26",
      "apim": "10.40.2.64/26",
      "management": "10.40.2.128/26",
      "portal": "10.40.3.0/26",
      "broker": "10.40.3.64/26",
      "certificate": "10.40.3.128/27"
    }
  },
  "services": {
    "publisherName": "Example Corporation",
    "publisherEmail": "replace-with-your-email@example.com",
    "apimInstanceId": "<AUTO_GENERATED_APIM_INSTANCE_ID>"
  },
  "gateway": {
    "publicHostName": "gateway.example.com",
    "authentication": {
      "entra": {
        "audience": "11111111-1111-4111-8111-111111111111"
      },
      "credentialLogin": {
        "identity": {
          "clientId": "<ENTRA_CREDENTIAL_CLIENT_ID>",
          "clientSecretFile": "../secrets/entra-credential-secret.txt"
        }
      }
    }
  },
  "management": {
    "adminUsername": "egakumiadmin",
    "sshPublicKeyFile": "../secrets/management-ssh.pub"
  },
  "monitoring": {
    "operatorEmailAddresses": [
      "replace-with-your-email@example.com"
    ]
  },
  "certificate": {
    "contactEmail": "replace-with-your-email@example.com",
    "azureDnsSubscriptionId": "00000000-0000-0000-0000-000000000000",
    "azureDnsManagedIdentityResourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-dns-example/providers/Microsoft.ManagedIdentity/userAssignedIdentities/mi-dns-example"
  },
  "firewallTlsInspection": {
    "managedIdentityResourceId": "<FIREWALL_CA_MANAGED_IDENTITY_RESOURCE_ID>",
    "intermediateCaSecretId": "<FIREWALL_CA_VERSIONED_KEY_VAULT_SECRET_URI>",
    "rootCaCertificateFile": "../secrets/firewall-root-ca.cer"
  },
  "credentialProviders": {
    "graphDelegated": {
      "clientId": "00000000-0000-0000-0000-000000000000",
      "clientSecretFile": "../secrets/entra-client-secret.txt"
    }
  },
  "location": "japaneast",
  "foundryLocation": "eastus2",
  "apiCenterLocation": "eastus",
  "tags": {
    "purpose": "egakumi-platform"
  },
  "portal": {
    "publicHostName": "portal.example.com"
  }
}
